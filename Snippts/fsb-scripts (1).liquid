  function fsbOdClearSelect(){
    overlay.querySelectorAll('.fsb-od-selected').forEach(function(el){ el.classList.remove('fsb-od-selected'); });
  }
  /* ---------- MOBILE: order details INSIDE the membership drawer ----------
     Header, summary card and tabs stay exactly as they are; the order
     detail replaces the pane content and "Back" restores the list. */
  var odInlineEl = null;
  function fsbOdInlineWrap(){ return document.getElementById('fsb-account-od-' + sid); }
  function fsbOdInlineOpen(orderId){
    var panel = accountPanel, slot = document.getElementById('fsb-account-od-slot-' + sid),
        wrap = fsbOdInlineWrap(), odPanel = fsbOdPanel();
    if (!panel || !slot || !wrap || !odPanel) return false;
    var el = odPanel.querySelector('.fsb-od[data-order-id="' + String(orderId).replace(/"/g, '') + '"]');
    if (!el) return false;
    odInlineEl = el;
    el.hidden = false;
    slot.appendChild(el);
    wrap.hidden = false;
    panel.classList.add('fsb-account-od-open');
    var body = panel.querySelector('.fsb-account-body') || panel.querySelector('.fsb-panel-body');
    if (body) body.scrollTop = 0;
    return true;
  }
  function fsbOdInlineClose(){
    if (!odInlineEl){
      var wrap0 = fsbOdInlineWrap();
      if (wrap0) wrap0.hidden = true;
      if (accountPanel) accountPanel.classList.remove('fsb-account-od-open');
      return;
    }
    var odPanel = fsbOdPanel();
    var body = odPanel ? odPanel.querySelector('.fsb-od-body') : null;
    if (body){ odInlineEl.hidden = true; body.appendChild(odInlineEl); }
    odInlineEl = null;
    var wrap = fsbOdInlineWrap();
    if (wrap) wrap.hidden = true;
    if (accountPanel) accountPanel.classList.remove('fsb-account-od-open');
  }
  function fsbOdIsMobile(){
    return !!(window.matchMedia && window.matchMedia('(max-width: 767px)').matches);
  }
  function openOrderDetail(orderId, fromPanel){
    var odPanel = fsbOdPanel();
    if (!odPanel) return;
    /* reset any stale mobile-inline state first (e.g. drawer was closed
       with X while the inline detail was open) */
    fsbOdInlineClose();
    var hostPanel = document.getElementById('fsb-panel-' + (fromPanel || 'orders') + '-' + sid);
    /* MOBILE + membership drawer: detail opens INSIDE the same drawer —
     no separate stacked drawer. */
    if (fromPanel === 'account' && fsbOdIsMobile()){
      if (fsbOdInlineOpen(orderId)){
        closeCart();
        sectionRoot.classList.remove('fsb-region-panel-open');
        allPanels().forEach(function(panel){ if (panel !== hostPanel) panel.classList.remove('active'); });
        if (hostPanel) hostPanel.classList.add('active');
        overlay.classList.remove('fsb-address-pair-open');
        overlay.classList.remove('fsb-address-edit-pair-open');
        overlay.classList.remove('fsb-od-pair-open');
