         status from historical spend or a retained points balance. */
      cur = tiers[0];
      next = tiers[1] || null;
    }
    return { tiers: tiers, spent: null, cur: cur, next: next };
  }
  /* Tier ARTWORK card — shows the member's tier IMAGE (from BON) as the
     card art. v23: while the image loads a plain centered SPINNER shows
     (the old medal-icon + tier-name placeholder was removed on request);
     when no image exists at all the card simply stays clean/empty. */
  function bonTierCardMarkup(t){
    var raw = String(t.cur.name || '');
    var key = bonTierArtKey(t.cur);
    var ready = bonTierImgStates[key] || {};
    var imgSrc = ready.url || t.cur.icon;
    var hasImage = !!imgSrc && !ready.failed;
    var spin = '<div class="fsb-tier-art-fallback" aria-hidden="true">'
      + '<svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="#c79a3c" stroke-width="2.2" stroke-linecap="round" style="position:absolute;left:50%;top:50%;width:30px;height:30px;margin:-15px 0 0 -15px">'
      + '<circle cx="12" cy="12" r="9" opacity="0.22"/>'
      + '<path d="M21 12a9 9 0 0 0-9-9">'
      + '<animateTransform attributeName="transform" type="rotate" from="0 12 12" to="360 12 12" dur="0.8s" repeatCount="indefinite"/>'
      + '</path></svg></div>';
    return '<div class="fsb-tier-art" data-fsb-tier-key="' + bonEsc(key) + '">'
      + (hasImage && !ready.url ? spin : '')
      + (hasImage ? '<img class="fsb-tier-art-img" src="' + bonEsc(imgSrc) + '" alt="' + bonEsc(raw) + '" loading="eager" style="opacity:' + (ready.url ? '1' : '0') + ';transition:opacity .25s ease" onload="fsbTierImgOk(this)" data-fsb-icons="' + bonEsc(JSON.stringify(t.cur.iconChain || [])) + '" onerror="fsbTierImgErr(this)">' : '')
      + '</div>';
  }
  function bonTierCard(){
    var t = bonTierInfo();
    if (!t.cur) return '';
    return bonTierCardMarkup(t);
  }
  /* Change the points/list text when BON refreshes, but do NOT destroy an
     unchanged, already loaded card image. Used in all three drawers that
     display this artwork (Membership, Points and Rewards). */
  function bonSetTierContent(host, trailingHtml){
    var t = bonTierInfo();
    var key = t.cur ? bonTierArtKey(t.cur) : '';
    var art = host.querySelector(':scope > .fsb-tier-art');
    if (art && key && art.getAttribute('data-fsb-tier-key') === key){
      var img = art.querySelector('.fsb-tier-art-img');
      if (img && img.complete && img.naturalWidth) window.fsbTierImgOk(img);
      while (art.nextSibling) art.nextSibling.remove();
      art.insertAdjacentHTML('afterend', trailingHtml);
    } else {
      host.innerHTML = (t.cur ? bonTierCardMarkup(t) : '') + trailingHtml;
    }
  }

  // ============================================================
  // BON LOYALTY - FIND POINTS FROM DOM
  // ============================================================
  /* ---------- Marketing opt-in (Shopify + Klaviyo) ---------- */
  var mktInput = document.getElementById('fsb-marketing-optin-' + sid);
  var mktStateEl = document.getElementById('fsb-mkt-state-' + sid);
  var mktStatusEl = document.getElementById('fsb-mkt-status-' + sid);
  function fsbMktPaint(on){
    if (mktStateEl){
      mktStateEl.textContent = on ? 'On' : 'Off';
      mktStateEl.classList.toggle('is-on', !!on);
    }
  }
  function fsbMktStatus(msg, isErr){
    if (!mktStatusEl) return;
    mktStatusEl.textContent = msg || '';
    mktStatusEl.classList.toggle('is-err', !!isErr);
  }
  /* GET helper — same secure proxy base as BON (GAS /exec URL in theme
     setting "bon_api_base"). Kept identical in shape to bonFetchProxy so
     it behaves exactly like the working points calls. */
  function fsbMktCall(args){
    var base = String(bonSeed.apiBase || '').trim();
    if (!base) return Promise.resolve(null);
    var sep = (base.indexOf('/exec') !== -1) ? '?' : '?';
    var url = base.replace(/\/+$/, '') + sep + args;
    return fetch(url, { headers: { 'Accept': 'application/json' }, credentials: 'omit' })
      .then(function(r){ return r.json(); })
      .catch(function(){ return null; });
  }
  /* While a save is in flight this blocks the page-load re-sync from
     painting a stale state over the toggle (the old first-click bug). */
  var mktBusy = false;
  /* On load: read the REAL marketing state (Shopify Admin + Klaviyo) so the
     toggle always shows the truth after a refresh — not a stale guess. */
  function fsbMktSync(){
    if (!mktInput || mktBusy) return;
    var email = String(bonSeed.customerEmail || '').trim();
    if (!email) return;
    fsbMktCall('action=mkt_state'
      + '&shopify_id=' + encodeURIComponent(bonSeed.customerId || '')
      + '&email=' + encodeURIComponent(email))
      .then(function(d){
        if (mktBusy) return;
        if (!d || d.success !== true) return;
        mktInput.checked = !!d.subscribed;
        fsbMktPaint(mktInput.checked);
      });
  }
  /* Off = unsubscribe everywhere (Shopify + Klaviyo), On = subscribe.
     Goes through the GAS proxy (mkt_set) — direct Shopify/Klaviyo calls
     from the browser cannot change consent, which is why the old code
     silently did nothing.
     v21 FIX: the FIRST request while the proxy is waking up sometimes comes
     back empty/ambiguous even though the very NEXT one goes through (this
     is why the toggle failed on click 1 and worked on click 2). We now
     retry silently up to 3 times before ever telling the user anything,
     and only then ask the server for the REAL state to be extra safe. */
  function fsbSetMarketing(on){
    if (!mktInput) return;
    var email = String(bonSeed.customerEmail || '').trim();
    var prev = !on;
    if (!email){ mktInput.checked = prev; fsbMktPaint(prev); return; }
    mktBusy = true;
    mktInput.disabled = true;
    fsbMktPaint(on);
    fsbMktStatus('Saving…');
    var argsBase = '&shopify_id=' + encodeURIComponent(bonSeed.customerId || '')
      + '&email=' + encodeURIComponent(email);

    function mktFinish(){ mktBusy = false; mktInput.disabled = false; }

    /* Final safety net: read the truth from the server (once more after a
       short wait — Shopify's search index can lag a second behind a write). */
    function mktAskTruth(triesLeft, lastResp){
      fsbMktCall('action=mkt_state' + argsBase).then(function(st){
        if (st && st.success === true){
          var real = !!st.subscribed;
          if (real !== on && triesLeft > 0){
            setTimeout(function(){ mktAskTruth(triesLeft - 1, lastResp); }, 1500);
            return;
          }
          mktFinish();
          mktInput.checked = real;
          fsbMktPaint(real);
          if (real === on) fsbMktStatus('Saved.');
          else fsbMktStatus((lastResp && (lastResp.message || lastResp.error)) || 'Could not save — please try again.', true);
          return;
        }
        /* State unreadable at all — paint back where we were. */
        mktFinish();
        mktInput.checked = prev;
        fsbMktPaint(prev);
        fsbMktStatus((lastResp && (lastResp.message || lastResp.error)) || 'Could not save — please try again.', true);
      });
    }

    function mktSendSet(retriesLeft){
      fsbMktCall('action=mkt_set' + argsBase
        + '&subscribe=' + (on ? '1' : '0'))
        .then(function(d){
          if (d && d.success === true){
            var updated = [];
            if (d.results){
              if (d.results.shopify && d.results.shopify.ok === true) updated.push('Shopify');
              if (d.results.klaviyo && d.results.klaviyo.ok === true) updated.push('Klaviyo');
            }
            mktFinish();
            mktInput.checked = on;
            fsbMktPaint(on);
            fsbMktStatus((on ? 'Subscribed to marketing emails.' : 'Unsubscribed from marketing emails.')
              + (updated.length ? ' (updated: ' + updated.join(' | ') + ')' : ''));
            return;
          }
          /* Ambiguous/empty reply — retry SILENTLY, don't bother the user. */
          if (retriesLeft > 0){
            setTimeout(function(){ mktSendSet(retriesLeft - 1); }, 1200);
            return;
          }
          mktAskTruth(1, d);
        });
    }
    mktSendSet(2); /* total 3 quiet attempts */
  }
  if (mktInput){
    fsbMktPaint(mktInput.checked);
    mktInput.addEventListener('change', function(){ fsbSetMarketing(mktInput.checked); });
    fsbMktSync();
  }

  function bonFindPoints() {
    // 1. Check if we already have points from seed
    if (bonState.points > 0 && bonState.pointsKnown) {
      return true;
    }

    // 2. Check for BON Loyalty widget on page
    var widgetSelectors = [
      '.bon-loyalty-widget [class*="point"]',
      '[class*="bon-loyalty"] [class*="point-balance"]',
      '[data-bon-points]',
      '[data-points-balance]',
      '.bon-points-display',
      '.bon-points-balance',
      '[class*="point-balance"]',
      '[class*="loyalty-points"]'
    ];

    for (var i = 0; i < widgetSelectors.length; i++) {
      try {
        var els = document.querySelectorAll(widgetSelectors[i]);
        for (var j = 0; j < els.length; j++) {
          var el = els[j];
          var text = (el.textContent || '').trim();
          var numMatch = text.match(/(\d[\d,.]*)/);
          if (numMatch) {
            var pts = bonNum(numMatch[1]);
            if (pts > 0 && pts < 100000000) {
              bonState.points = pts;
              bonState.pointsKnown = true;
              return true;
            }
          }
          var attr = el.getAttribute('data-points') || el.getAttribute('data-bon-points') || el.getAttribute('data-point-balance');
          if (attr) {
            var pts2 = bonNum(attr);
            if (pts2 > 0 && pts2 < 100000000) {
              bonState.points = pts2;
              bonState.pointsKnown = true;
              return true;
            }
          }
        }
      } catch(e) {}
    }

    return false;
  }

  // Try to find points immediately
  bonFindPoints();

  // ============================================================
  // BON LOYALTY - UI RENDERERS
  // ============================================================
  /* "10,000 expires on 20/05/2026" — or "Your points expire on …" when only
     the date is known. Empty when BON gives no expiry info. */
  function bonExpiryLine(){
    var ex = bonState.pointsExpiry;
    if (!ex || !ex.date) return '';
    var d = bonFmtDate(ex.date, 'dmy');
    if (!d) return '';
    return bonNum(ex.amount) > 0
      ? (bonFmt(ex.amount) + ' expires on ' + bonEsc(d))
      : ('Your points expire on ' + bonEsc(d));
  }

  function bonPointsCard(){
    bonFindPoints();
    var t = bonTierInfo();
    /* Mirror BON's own VIP 'Total money spent' as BON VIP spending, NOT as
       the newly reset membership year's qualifying spend. No spend-to-retain
       claims, and no deduction from points or Shopify lifetime spending. */
    var pct = 0;
    var tierLabel = t.cur ? '<b>' + bonEsc(t.cur.name) + '</b> tier · ' : '';
    var retain = tierLabel + 'Total money spent: —';
    if (bonState.vipMoneySpentKnown){
      var vipMoney = bonNum(bonState.vipMoneySpent);
      var goal = bonNum(t.next ? t.next.spend : (t.cur ? t.cur.spend : 0));
      if (goal > 0) pct = Math.max(0, Math.min(100, vipMoney / goal * 100));
      retain = tierLabel + 'Total money spent: <b>' + bonMoney(vipMoney) + '</b>';
    }
    var expTxt = bonExpiryLine();
    var expLine = expTxt ? '<div class="fsb-ly-pts-exp">' + expTxt + '</div>' : '';
    /* Optional diagnostics: show BON's raw/parsed tier program. Shopify
       lifetime spend is labeled explicitly; it is NOT annual VIP progress. */
    var dbgHtml = '';
    try {
      if (/[?&]fsb-tiers-debug=1/.test(String(location.search))){
        var rawList = Array.isArray(bonState.tierRowsRaw) ? bonState.tierRowsRaw : [];
        dbgHtml = '<div style="font-size:10px;color:#9a9a9a;margin-top:8px;word-break:break-all;line-height:1.6">'
          + 'BON raw: ' + bonEsc(JSON.stringify(rawList.map(function(r){
              return { title: r.title, required_value: r.required_value, is_default: r.is_default };
            })))
          + '<br>parsed($): ' + bonEsc(JSON.stringify((bonState.tierRowsApi || []).map(function(r){
              return { name: r.name, spend: r.spend };
            })))
          + '<br>Shopify lifetime spend (not VIP progress): ' + bonEsc(String(bonNum(bonSeed.totalSpent)))
          + '<br>BON VIP money spent: ' + (bonState.vipMoneySpentKnown ? bonEsc(String(bonState.vipMoneySpent)) : 'not returned')
          + '</div>';
      }
    } catch(e){}
    return '<div class="fsb-ly-pts">'
      +   '<div class="fsb-ly-pts-label">Points earned</div>'
      +   '<div class="fsb-ly-pts-value">' + bonFmt(bonState.points || 0) + '</div>'
      +   expLine
      +   '<div class="fsb-ly-bar"><div class="fsb-ly-bar-fill" style="width:' + pct.toFixed(1) + '%"></div></div>'
      +   (retain ? '<div class="fsb-retain">' + retain + '</div>' : '')
      +   dbgHtml
      + '</div>';
  }

  function bonItemTitle(it){
    var t = String(bonPick(it, ['name','title','program_name','reward_name','label']) || '');
    return t || 'Reward';
  }
  function bonItemPoints(it){ return bonNum(bonPick(it, ['point','points','point_cost','required_point','cost','point_required','reward_value'])); }
  function bonItemDesc(it){ return String(bonPick(it, ['description','note','summary','subtitle','reason','label']) || ''); }
  function bonItemCode(it){ return String(bonPick(it, ['code','discount_code','coupon_code','voucher_code']) || '').trim(); }
  function bonItemCaption(it){ return String(bonPick(it, ['tier_name','category','group','program_name','subtitle','reward_type','type']) || '').trim(); }
  function bonItemImage(it){ return String(bonPick(it, ['image','image_url','icon','thumbnail']) || '').trim(); }

  function bonItemValue(it){
    var type = String(bonPick(it, ['discount_type','type','reward_type','value_type','redeem_type']) || '').toLowerCase();
    /* BON redeem rules: reward_value is the point COST of the rule and
       money_value is its discount amount (per the BON docs). Prefer
       money_value so the card shows the real discount. */
    var val  = bonPick(it, ['discount_value','value','amount','discount_amount','percentage','money_value','reward_value']);
    if (val === '' || val === null || val === undefined) return '';
    /* BON redeem_type: 0 = AMOUNT_DISCOUNT, 1 = PERCENTAGE_DISCOUNT */
    if (type === '0' || type === 'amount' || type === 'amount_discount' || type === 'fixed'){
      var n0 = bonNum(val);
      if (n0 === 0) return '';
      return bonMoney(val);
    }
    if (type === '1' || type.indexOf('percent') > -1 || String(val).indexOf('%') > -1){
      return String(val).replace(/[^\d.]/g, '') + '%';
    }
    if (bonNum(val) === 0) return '';
    return bonMoney(val);
  }

  /* Big value shown in the coupon head: "10% OFF", "$20 OFF" or "BXGY". */
  function bonBigValue(it){
    var type = String(bonPick(it, ['discount_type','type','reward_type','value_type','redeem_type']) || '').toLowerCase();
    var ttl  = String(bonItemTitle(it) || '');
    if (type.indexOf('bxgy') > -1 || type.indexOf('buy_x') > -1 || type.indexOf('buyx') > -1
        || type.indexOf('buyget') > -1 || /\bbxgy\b/i.test(ttl)) return 'BXGY';
    var v = String(bonItemValue(it) || '').trim();
    if (!v) return ttl || 'REWARD';
    return /off/i.test(v) ? v : (v + ' OFF');
  }

  function bonRwState(it){
    var st = String(bonPick(it, ['status']) || '').toLowerCase();
    if (it.used || it.redeemed || it.is_used || st === 'used') return 'used';
    if (it.expired || st === 'expired') return 'expired';
    return 'available';
  }

  /* Coupon card — matches the reward-card reference: big discount head,
     note line, coupon name, expiry, action button and a
     TERMS & CONDITIONS accordion.
     Action 2 (Available tab): "Use now" text button (apply to cart & greyed out once applied).
     Used/expired cards are greyed out with disabled state. */
  function bonRenderCoupon(it, state){
    var big  = bonBigValue(it);
    var cap  = bonItemCaption(it);
    var note = bonItemDesc(it) || (cap ? cap + ' members only' : '');
    var code = bonItemCode(it);
    var name = String(bonPick(it, ['coupon_name','reward_name','label','title','name']) || '') || code || 'Coupon';
    var exp  = bonFmtDate(bonPick(it, ['expires_at','expiry_date','expired_at','end_date','ends_at','valid_until','expires']), 'dmy');
    var terms = String(bonPick(it, ['terms_and_conditions','terms','fine_print']) || '') || bonItemDesc(it);
    var gift = bonGiftFromReward(it);
    var giftAttr = gift ? ' data-fsb-gift="' + bonEsc(JSON.stringify(gift)) + '"' : '';
    var inactive = (state !== 'available');
    var btn;
    var appliedCode = '';
    try { appliedCode = sessionStorage.getItem('fsb_applied_coupon_v2') || ''; } catch(e){}
    var isApplied = (!inactive && code && appliedCode && appliedCode.toLowerCase() === code.toLowerCase());

    if (inactive){
      btn = '<button type="button" class="fsb-rw-use-btn is-applied" disabled aria-label="' + (state === 'used' ? 'Used' : 'Expired') + '">'
          + (state === 'used' ? 'Used' : 'Expired') + '</button>';
    } else if (isApplied){
      btn = '<button type="button" class="fsb-rw-use-btn is-applied" data-fsb-apply-code="' + bonEsc(code) + '"' + giftAttr + ' disabled aria-label="Applied">Applied ✓</button>';
    } else {
      btn = '<button type="button" class="fsb-rw-use-btn" data-fsb-apply-code="' + bonEsc(code) + '"' + giftAttr + ' aria-label="Use now">Use now</button>';
    }
    return '<div class="fsb-rw-card' + (inactive ? ' is-inactive' : '') + '">'
      +   '<div class="fsb-rw-head">'
      +     '<div class="fsb-rw-value">' + bonEsc(big) + '</div>'
      +     (note ? '<div class="fsb-rw-note">' + bonEsc(note) + '</div>' : '')
      +   '</div>'
      +   '<div class="fsb-rw-body">'
      +     '<div class="fsb-rw-row"><div>'
      +       '<div class="fsb-rw-name">' + bonEsc(name) + '</div>'
      +       '<div class="fsb-rw-exp">' + (exp ? 'Expires: ' + bonEsc(exp) : '&nbsp;') + '</div>'
      +     '</div>' + btn + '</div>'
      +     '<button type="button" class="fsb-rw-terms" data-fsb-terms>TERMS &amp; CONDITIONS '
      +       '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>'
      +     '</button>'
      +     '<div class="fsb-rw-terms-body">' + (terms ? bonEsc(terms) : 'No additional terms.') + '</div>'
      +   '</div>'
      + '</div>';
  }

  /* Redeem rule card (Action 1: redeem with points) — Download icon. Only shown when customer has sufficient points. */
  function bonRenderRedeemCard(it){
    var need = bonItemPoints(it);
    var userPoints = bonPoints();
    if (need && need > userPoints) return ''; // Hide completely if customer does not have enough points
    var big  = bonBigValue(it);
    var note = bonItemDesc(it) || '';
    var title = bonItemTitle(it);
    var rid = String(bonPick(it, ['id','_id','reward_id','program_id']) || '');
    return '<div class="fsb-rw-card">'
      +   '<div class="fsb-rw-head">'
      +     '<div class="fsb-rw-value">' + bonEsc(big) + '</div>'
      +     (note ? '<div class="fsb-rw-note">' + bonEsc(note) + '</div>' : '')
      +   '</div>'
      +   '<div class="fsb-rw-body">'
      +     '<div class="fsb-rw-row"><div>'
      +       '<div class="fsb-rw-name">' + bonEsc(title) + '</div>'
      +       '<div class="fsb-rw-exp">' + (need ? bonFmt(need) + ' points' : '&nbsp;') + '</div>'
      +     '</div>'
      +     '<button type="button" class="fsb-rw-dl" data-fsb-redeem="' + bonEsc(rid) + '" aria-label="Redeem reward">'
      +       '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="M7 10l5 5 5-5"/><path d="M4 19h16"/></svg>'
      +     '</button>'
      +     '</div>'
      +   '</div>'
      + '</div>';
  }

  /* Rewards content for the Rewards drawer AND the membership drawer's
     Rewards tab — AVAILABLE / USED / EXPIRED with the same card design. */
  function bonRewardsInner(){
    var t = bonTab.rewards;
    var owned = Array.isArray(bonState.rewards) ? bonState.rewards : [];
    var byState = function(s){ return owned.filter(function(r){ return bonRwState(r) === s; }); };
    var html = '';
    if (t === 'used'){
      var u = byState('used');
      if (!u.length) return '<div class="fsb-ly-empty">' + (bonState.loaded ? 'No used rewards yet.' : 'Loading your rewards…') + '</div>';
      html = u.map(function(r){ return bonRenderCoupon(r, 'used'); }).join('');
    } else if (t === 'expired'){
      var x = byState('expired');
      if (!x.length) return '<div class="fsb-ly-empty">' + (bonState.loaded ? 'No expired rewards.' : 'Loading your rewards…') + '</div>';
      html = x.map(function(r){ return bonRenderCoupon(r, 'expired'); }).join('');
    } else {
      var a = byState('available');
      var userPoints = bonPoints();
      /* Filter out any reward where required points > customer points */
      var rules = (bonState.redeem || []).filter(function(r){
        if (r.is_active === 0) return false;
        var need = bonItemPoints(r);
        return !need || need <= userPoints;
      });
      if (!a.length && !rules.length) return '<div class="fsb-ly-empty">' + (bonState.loaded ? 'No rewards available right now.' : 'Loading available rewards…') + '</div>';
      html = a.map(function(r){ return bonRenderCoupon(r, 'available'); }).join('')
           + rules.map(bonRenderRedeemCard).join('');
    }
    return '<div class="fsb-rw-grid">' + html + '</div>';
  }

  /* Expiry shown in the history EXPIRES column: BON's own expiry when it
     sends one; otherwise earned rows get +1 year (BON's default) and
     redeemed rows show "-", like the reference. */
  function bonHistExpiry(h, kind, rawDate){
    var e = bonFmtDate(bonPick(h, ['expires_at','expiry_date','point_expiry','points_expire_at','expired_at','valid_until','expires']), 'dmy');
    if (e) return e;
    if (kind === 'earned' && rawDate){
      var d = new Date(rawDate);
      if (!isNaN(d.getTime())){
        d.setFullYear(d.getFullYear() + 1);
        var p = function(n){ return (n < 10 ? '0' : '') + n; };
        return p(d.getDate()) + '/' + p(d.getMonth() + 1) + '/' + d.getFullYear();
      }
    }
    return '-';
  }

  function bonRenderHistory(){
    var rows = Array.isArray(bonState.history) ? bonState.history.slice() : [];
    /* Latest activity first. */
    rows.sort(function(a, b){
      var da = new Date(String(bonPick(a, ['created_at','date','createdAt','updated_at']) || '')).getTime();
      var db = new Date(String(bonPick(b, ['created_at','date','createdAt','updated_at']) || '')).getTime();
      if (isNaN(da)) da = 0;
      if (isNaN(db)) db = 0;
      return db - da;
    });
    var body;

    if (!rows.length){
      body = '<div class="fsb-ly-empty">'
           + (bonState.loaded ? 'No point activity yet.' : 'Loading your point history…')
           + '</div>';
    } else {
      body = '<table class="fsb-ly-tbl"><thead><tr>'
        +   '<th class="fsb-ly-th-amt">POINTS</th>'
        +   '<th class="fsb-ly-th-desc">DESCRIPTION</th>'
        +   '<th class="fsb-ly-th-date">DATE</th>'
        +   '<th class="fsb-ly-th-exp">EXPIRES</th>'
        + '</tr></thead><tbody>'
        + rows.map(function(h){
            var raw = bonPick(h, ['point','points','amount','value','point_change','delta']);
            var amt = bonNum(raw);
            var neg = String(raw).trim().charAt(0) === '-' || amt < 0;
            var src = String(bonPick(h, ['source','reason','title','name','action','event','type','description']) || 'Points update');
            var rawDate = String(bonPick(h, ['created_at','date','createdAt','updated_at']) || '');
            var date = bonFmtDate(rawDate, 'dmy') || '—';
            var lowSrc = src.toLowerCase();
            var historyKind = (lowSrc.indexOf('redeem') > -1 || (lowSrc.indexOf('purchase') > -1 && neg)
                              ? 'redeemed' : (lowSrc.indexOf('expire') > -1 ? 'expired' : (neg ? 'redeemed' : 'earned')));
            var exp = (historyKind === 'redeemed') ? '-' : bonHistExpiry(h, historyKind, rawDate);
            var mag = Math.abs(amt);
            return '<tr data-history-kind="' + historyKind + '">'
              +   '<td class="fsb-ly-td-amt' + (neg ? ' is-neg' : '') + '">' + (neg ? '- ' : '+ ') + bonFmt(mag) + '</td>'
              +   '<td class="fsb-ly-td-desc">' + bonEsc(src) + '</td>'
              +   '<td class="fsb-ly-td-date">' + bonEsc(date) + '</td>'
              +   '<td class="fsb-ly-td-exp">' + bonEsc(exp) + '</td>'
              + '</tr>';
          }).join('')
        + '</tbody></table>';
    }

    return '<div class="fsb-ly-hist">'
      +   '<div class="fsb-ly-hist-head">Points history</div>'
      +   '<div class="fsb-history-tabs"><button type="button" class="is-active">ALL</button><button type="button">EARNED</button><button type="button">REDEEMED</button><button type="button">EXPIRED</button></div>'
      +   body
      + '</div>';
  }

  function bonTabs(scope){
    var t = bonTab[scope];
    var pair = (scope === 'points')
      ? [ { k:'earn',    label:'Ways to earn' }, { k:'history', label:'History' } ]
      : [ { k:'available', label:'Available' },  { k:'used', label:'Used' }, { k:'expired', label:'Expired' } ];
    return '<div class="fsb-ly-tabs" role="tablist">'
      + pair.map(function(o){
          return '<button type="button" class="fsb-ly-tab" role="tab" data-fsb-lytab="' + o.k + '"'
               + ' aria-selected="' + (t === o.k) + '">' + o.label + '</button>';
        }).join('')
      + '</div>';
  }

  function bonRenderPanel(scope) {
    var el = document.getElementById('fsb-' + scope + '-body-' + sid);
    var r = document.getElementById('fsb-account-rewards-' + sid);
    var h = document.getElementById('fsb-account-history-' + sid);

    // Try to find points one more time before rendering
    bonFindPoints();

    if (!bonState.cid) {
      var signinHtml = '<div class="fsb-ly">'
        + '<a class="fsb-ly-signin" href="' + bonEsc(bonSeed.loginUrl || '/account/login') + '">Sign in to view your rewards</a></div>';
      if (el) el.innerHTML = signinHtml;
      if (scope === 'rewards' && r) r.innerHTML = signinHtml;
      if (scope === 'points' && h) h.innerHTML = signinHtml;
      return;
    }

    var busy = bonState.loading && !bonState.redeem.length && !bonState.rewards.length && !bonState.earn.length && !bonState.history.length;
    var listHtml;

    if (busy) {
      listHtml = '<div class="fsb-ly-loading"><span class="fsb-ly-spin"></span><span>Loading…</span></div>';
    } else if (scope === 'points') {
      listHtml = bonRenderHistory();
    } else {
      listHtml = bonRewardsInner();
    }

    var hint = '';
    /* Data-source hint: until the BON API proxy is connected the theme
       cannot read BON's private points — only 0 would show. This note only
       appears in that case (to guide the store owner); it disappears as
       soon as the API is connected. */
    if (bonState.cid && !bonState.pointsKnown && !String(bonSeed.apiBase || '').trim()) {
      hint = '<div class="fsb-ly-note">To show live points, connect the BON API — Theme Settings &gt; "BON Loyalty API base URL".</div>';
    }

    if (el) {
      var tierBody = el.querySelector(':scope > .fsb-ly');
      if (!tierBody){ el.innerHTML = '<div class="fsb-ly"></div>'; tierBody = el.firstElementChild; }
      bonSetTierContent(tierBody,
        bonPointsCard()
        + (scope === 'points' ? '' : bonTabs(scope))
        + listHtml
        + hint);
      bonBindPanel(el, scope);
    }

    if (scope === 'rewards' && r) {
      r.innerHTML = bonTabs('rewards') + bonRewardsInner();
      bonBindPanel(r, 'rewards');
    }
    if (scope === 'points' && h) {
      h.innerHTML = bonRenderHistory();
      bonBindPanel(h, 'points');
    }

    updateRewardsBadge();
  }

  function bonFallbackCopy(text){
    try {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.cssText = 'position:absolute;left:-9999px;top:0;';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
    } catch (e) {}
  }

  function bonBindPanel(el, scope){
    el.querySelectorAll('.fsb-history-tabs button').forEach(function(btn){ btn.addEventListener('click',function(){ var wrap=btn.parentNode; wrap.querySelectorAll('button').forEach(function(b){b.classList.remove('is-active');}); btn.classList.add('is-active'); var filter=(btn.textContent||'ALL').toLowerCase(); var table=wrap.parentNode.querySelector('.fsb-ly-tbl'); if(table)table.querySelectorAll('tbody tr').forEach(function(row){row.style.display=(filter==='all'||row.getAttribute('data-history-kind')===filter)?'':'none';}); }); });
    el.querySelectorAll('[data-fsb-lytab]').forEach(function(btn){
      btn.addEventListener('click', function(){
        bonTab[scope] = btn.getAttribute('data-fsb-lytab');
        bonRenderPanel(scope);
      });
    });
    el.querySelectorAll('[data-fsb-copy]').forEach(function(btn){
      btn.addEventListener('click', function(){
        var code = btn.getAttribute('data-fsb-copy'), old = btn.textContent;
        try {
          if (navigator.clipboard && navigator.clipboard.writeText){
            var cp = navigator.clipboard.writeText(code);
            if (cp && cp.catch) cp.catch(function(){ bonFallbackCopy(code); });
          } else {
            bonFallbackCopy(code);
          }
        } catch (e) { bonFallbackCopy(code); }
        btn.textContent = 'Copied';
        setTimeout(function(){ btn.textContent = old; }, 1400);
      });
    });
    el.querySelectorAll('[data-fsb-apply-code]').forEach(function(btn){
      btn.addEventListener('click', function(){
        var code = btn.getAttribute('data-fsb-apply-code');
        if (code) bonApplyDiscountCode(code, btn, bonGiftFromButton(btn));
        else window.location.href = BON_LY || String(bonSeed.accountUrl || '/account');
      });
    });
    el.querySelectorAll('[data-fsb-redeem]').forEach(function(btn){
      if (btn.getAttribute('data-fsb-apply-code')) return;
      btn.addEventListener('click', function(){ bonRedeem(btn.getAttribute('data-fsb-redeem'), btn, scope); });
    });
  }

  // ============================================================
  // BON LOYALTY - LIVE DATA SOURCES
  // ============================================================
  var BON_LY = String(bonSeed.loyaltyUrl || '').trim();

  // Auto-detect a BON Loyalty widget container that the app renders on the
  // page (the floating widget / app embeds). Only reads inside that root.
  function bonWidgetRoot(){
    var sel = [
      '.bon-loyalty-widget',
      '[class*="bon-loyalty" i]',
      '[class*="bonloyalty" i]',
      '[id*="bon-loyalty" i]',
      '[id*="bonloyalty" i]',
      '[data-app*="bon" i]'
    ];
    for (var i = 0; i < sel.length; i++){
      try {
        var n = document.querySelector(sel[i]);
        if (n) return n;
      } catch(e){}
    }
    return null;
  }

  // Read the live point balance ONLY from a recognised BON widget — never by
  // scanning arbitrary page text (that previously fabricated wrong numbers).
  function bonReadWidgetPoints(){
    if (bonState.points > 0 && bonState.pointsKnown) return true;
    var root = bonWidgetRoot();
    if (!root) return false;
    var hits = root.querySelectorAll('[class*="point" i], [data-points], [data-point-balance], [data-bon-points]');
    for (var i = 0; i < hits.length; i++){
      var el = hits[i];
      var attr = el.getAttribute('data-points') || el.getAttribute('data-point-balance') || el.getAttribute('data-bon-points');
      var text = (el.textContent || '').trim();
      var raw = attr || '';
      if (!raw){
        var m = text.match(/(\d[\d,.]*)\s*(?:pt|pts|points?)/i) || text.match(/(?:balance|points?)\s*[:=]?\s*(\d[\d,.]*)/i);
        if (m) raw = m[1];
      }
      if (raw){
        var n = bonNum(raw);
        if (n > 0 && n < 100000000){
          bonState.points = n;
          bonState.pointsKnown = true;
          return true;
        }
      }
    }
    return false;
  }

  /* -----------------------------------------------------------------
     FREE-PRODUCT REWARDS
     Shopify's /discount/<code> URL applies a discount code only. It does
     not add the entitled product to the cart. For a BON free gift we add
     its exact Shopify variant first, then apply the generated BON code.
     Normal coupon behavior remains unchanged.
     ----------------------------------------------------------------- */
  function bonShopifyVariantId(value){
    var raw = String(value == null ? '' : value).trim();
    var gid = raw.match(/gid:\/\/shopify\/ProductVariant\/(\d+)/i);
    if (gid) return gid[1];
    return /^\d+$/.test(raw) ? raw : '';
  }
  function bonGiftFromReward(it){
    if (!it || typeof it !== 'object') return null;
    var variantId = it.variant_id || it.variantId || '';
    var handle = it.product_handle || it.productHandle || '';
    var productUrl = it.product_url || it.productUrl || '';
    var quantity = Math.floor(bonNum(it.quantity || it.gift_quantity || 1));
    if (quantity < 1) quantity = 1;
    if (!variantId && !handle && !productUrl) return null;
    return {
      variant_id: variantId,
      product_handle: handle,
      product_url: productUrl,
      quantity: quantity
    };
  }
  function bonGiftFromRedeemResponse(data){
    if (!data || typeof data !== 'object') return null;
    return bonGiftFromReward((data.gift && typeof data.gift === 'object') ? data.gift : data);
  }
  function bonGiftFromButton(btn){
    if (!btn) return null;
    try {
      var raw = btn.getAttribute('data-fsb-gift') || '';
      return raw ? bonGiftFromReward(JSON.parse(raw)) : null;
    } catch(e){ return null; }
  }
  function bonGiftHandle(gift){
    var handle = String((gift && gift.product_handle) || '').trim();
    if (handle) return handle.replace(/^\/+|\/+$/g, '');
    var url = String((gift && gift.product_url) || '').trim();
    var m = url.match(/\/products\/([^\/?#]+)/i);
    return m ? decodeURIComponent(m[1]) : '';
  }
  function bonResolveGiftVariant(gift){
    var direct = bonShopifyVariantId(gift && gift.variant_id);
    if (direct) return Promise.resolve(direct);
    var handle = bonGiftHandle(gift);
    if (!handle) return Promise.resolve('');
    return fetch('/products/' + encodeURIComponent(handle) + '.js', {
      headers: { 'Accept': 'application/json' },
      credentials: 'same-origin'
    }).then(function(r){
      if (!r.ok) throw new Error('Gift product lookup failed (' + r.status + ')');
      return r.json();
    }).then(function(product){
      var variants = product && Array.isArray(product.variants) ? product.variants : [];
      /* Never intentionally add an unavailable product variant. */
      var variant = variants.filter(function(v){ return v && v.available !== false; })[0] || null;
      return variant && variant.id ? String(variant.id) : '';
    });
  }
  function bonAddGiftToCart(variantId, quantity){
    return fetch(bonCartEndpoint('cart/add.js'), {
      method: 'POST',
      headers: {
        'Accept': 'application/json',
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      credentials: 'same-origin',
      body: JSON.stringify({
        items: [{ id: variantId, quantity: Math.max(1, Math.floor(bonNum(quantity) || 1)) }]
      })
    }).then(function(r){
      return r.json().catch(function(){ return {}; }).then(function(data){
        if (!r.ok) {
          throw new Error((data && (data.description || data.message)) || ('Cart add failed (' + r.status + ')'));
        }
        return data;
      });
    });
  }
  /* Discount allocation fingerprint used to verify that Shopify accepted a BON reward code. */
  function bonCartDiscountFingerprint(cart){
    var out = [];
    function add(app, amount){
      if (!app && !amount) return;
      var title = app && (app.title || app.code || (app.discount_application && (app.discount_application.title || app.discount_application.code))) || '';
      var value = amount;
      if (value === undefined || value === null || value === '') {
        value = app && (app.total_allocated_amount || app.amount || app.value || 0);
      }
      out.push(String(title) + '|' + String(value));
    }
    (cart && cart.cart_level_discount_applications || []).forEach(function(app){
      add(app, app && (app.total_allocated_amount || app.total_allocated_amount_set && app.total_allocated_amount_set.shop_money && app.total_allocated_amount_set.shop_money.amount));
    });
    (cart && cart.items || []).forEach(function(item){
      /* Shopify Ajax Cart response calls this line_level_discount_allocations.
         Keep older aliases as fallbacks for theme/app-modified cart JSON. */
      var allocations = item.line_level_discount_allocations || item.discount_allocations || item.discounts || [];
      allocations.forEach(function(allocation){
        add(allocation.discount_application || allocation, allocation.amount || allocation.discounted_amount || allocation.total_allocated_amount);
      });
    });
    return out.sort().join('||');
  }
  function bonCartDiscountTotal(cart){
    var direct = Number(cart && cart.total_discount || 0);
    if (direct > 0) return direct;
    var total = 0;
    (cart && cart.items || []).forEach(function(item){
      var allocations = item.line_level_discount_allocations || item.discount_allocations || item.discounts || [];
      allocations.forEach(function(a){ total += Number(a.amount || a.discounted_amount || a.total_allocated_amount || 0); });
    });
    return total;
  }
  function bonCartContainsCode(cart, code){
    var wanted = String(code || '').trim().toUpperCase();
    if (!wanted) return false;
    var codes = Array.isArray(cart && cart.discount_codes) ? cart.discount_codes : [];
    for (var i = 0; i < codes.length; i++) {
      var row = codes[i];
      var actual = String((row && typeof row === 'object') ? (row.code || row.title || '') : row || '').trim().toUpperCase();
      if (actual === wanted && (!row || typeof row !== 'object' || row.applicable !== false)) return true;
    }
    var found = false;
    function inspect(app){
      var actual = String(app && (app.title || app.code || (app.discount_application && (app.discount_application.title || app.discount_application.code))) || '').trim().toUpperCase();
      if (actual === wanted) found = true;
    }
    (cart && cart.cart_level_discount_applications || []).forEach(inspect);
    (cart && cart.items || []).forEach(function(item){
      var allocations = item.line_level_discount_allocations || item.discount_allocations || item.discounts || [];
      allocations.forEach(function(a){ inspect(a.discount_application || a); });
    });
    return found;
  }
  function bonReadCartForCoupon(){
    return fetch(bonCartEndpoint('cart.js'), { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
      .then(function(r){
        if (!r.ok) throw new Error('cart ' + r.status);
        return r.json();
      });
  }
  function bonStorefrontRoot(){
    var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
    root = String(root || '/');
    return root.charAt(root.length - 1) === '/' ? root : (root + '/');
  }
  function bonCartEndpoint(path){
    return bonStorefrontRoot() + String(path || '').replace(/^\/+/, '');
  }
  function bonCartHasAppliedDiscount(cart, code, baseline){
    var before = baseline && typeof baseline === 'object' ? baseline : { fingerprint: String(baseline || ''), total: 0 };
    if (bonCartContainsCode(cart, code)) return true;
    var afterTotal = bonCartDiscountTotal(cart);
    var beforeTotal = Number(before.total || 0);
    if (afterTotal > beforeTotal) return true;
    /* Fallback for carts that expose an allocation but omit total_discount. */
    var after = bonCartDiscountFingerprint(cart);
    return !!(after && after !== String(before.fingerprint || '') && afterTotal > 0);
  }
  function bonSetApplyingButton(btn){
    if (!btn) return;
    btn.classList.remove('is-applied');
    btn.classList.add('is-loading');
    btn.setAttribute('aria-busy', 'true');
    btn.setAttribute('aria-label', 'Applying reward');
    btn.disabled = true;
    if (!btn.querySelector('svg')) btn.textContent = 'Applying…';
  }
  /* Shopify's supported Ajax Cart API method. This applies the code to the
     real cart directly instead of merely setting an unverified /discount URL
     session, and returns the updated cart for immediate verification. */
  function bonRememberAndApplyDiscount(code, btn){
    bonSetApplyingButton(btn);
    bonReadCartForCoupon().then(function(beforeCart){
      var baseline = { fingerprint: bonCartDiscountFingerprint(beforeCart), total: bonCartDiscountTotal(beforeCart) };
      return fetch(bonCartEndpoint('cart/update.js'), {
        method: 'POST',
        headers: {
          'Accept': 'application/json',
          'Content-Type': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        },
        credentials: 'same-origin',
        body: JSON.stringify({ discount: code })
      }).then(function(r){
        return r.json().catch(function(){ return {}; }).then(function(cart){
          if (!r.ok) throw new Error('Discount request failed (' + r.status + ')');
          if (!bonCartHasAppliedDiscount(cart, code, baseline)) {
            throw new Error('Shopify did not accept this discount for the current cart');
          }
          return cart;
        });
      });
    }).then(function(cart){
      try { sessionStorage.setItem('fsb_applied_coupon_v2', code); } catch(e){}
      try {
        sessionStorage.removeItem('fsb_pending_coupon_v2');
        sessionStorage.removeItem('fsb_applied_coupon');
      } catch(e2){}
      updateCartCount();
      document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart: cart, source: 'fsb-bon' } }));
      bonRefreshCouponViews();
      /* Preserve the existing customer journey: show the actual updated cart,
         not a page refresh that only *looks* like a code was applied. */
      window.location.href = bonCartEndpoint('cart');
    }).catch(function(err){
      console.error('[FSB] Shopify rejected BON discount:', err);
      bonRestoreGiftButton(btn);
      window.alert('This reward code could not be applied to the current cart. Please check the reward conditions or contact support.');
    });
  }
  function bonLookupGiftForCode(code){
    var base = String(bonSeed.apiBase || '').trim();
    if (!base || !bonState.cid) return Promise.resolve(null);
    var sep = (base.indexOf('/exec') !== -1) ? '?' : '/customer?';
    var url = base.replace(/\/+$/, '') + sep
      + 'action=lookup_discount'
      + '&shopify_id=' + encodeURIComponent(bonState.cid)
      + '&email=' + encodeURIComponent(bonState.email || '')
      + '&code=' + encodeURIComponent(code);
    return fetch(url, { headers: { 'Accept': 'application/json' }, credentials: 'omit' })
      .then(function(r){ return r.ok ? r.json() : null; })
      .catch(function(){ return null; });
  }
  function bonRefreshCouponViews(){
    ['points', 'rewards'].forEach(function(scope){
      var el = document.getElementById('fsb-' + scope + '-body-' + sid);
      if (el && el.innerHTML && typeof bonRenderPanel === 'function') bonRenderPanel(scope);
    });
  }
  /* Diagnostic only — in DevTools run fsbBonCouponDebug('YOUR-CODE') and
     send its console output if Shopify still says a particular code is not
     applicable. It does not modify the cart. */
  window.fsbBonCouponDebug = function(code){
    return Promise.all([bonLookupGiftForCode(code), bonReadCartForCoupon()]).then(function(result){
      var out = {
        code: String(code || ''),
        giftLookup: result[0],
        cartDiscountCodes: result[1] && result[1].discount_codes,
        cartLevelDiscounts: result[1] && result[1].cart_level_discount_applications,
        totalDiscount: bonCartDiscountTotal(result[1]),
        cart: result[1]
      };
      console.log('[FSB] BON coupon diagnostic', out);
      return out;
    });
  };
  function bonSetGiftButtonBusy(btn, label){
    if (!btn) return;
    if (!btn.hasAttribute('data-fsb-before-gift-html')) {
      btn.setAttribute('data-fsb-before-gift-html', btn.innerHTML);
      btn.setAttribute('data-fsb-before-gift-label', btn.getAttribute('aria-label') || '');
    }
    btn.classList.add('is-loading');
    btn.setAttribute('aria-busy', 'true');
    btn.setAttribute('aria-label', label || 'Adding free gift to cart');
    btn.disabled = true;
  }
  function bonRestoreGiftButton(btn){
    if (!btn) return;
    var before = btn.getAttribute('data-fsb-before-gift-html');
    if (before !== null) btn.innerHTML = before;
    btn.removeAttribute('data-fsb-before-gift-html');
    btn.classList.remove('is-loading', 'is-applied');
    btn.removeAttribute('aria-busy');
    btn.setAttribute('aria-label', btn.getAttribute('data-fsb-before-gift-label') || 'Redeem reward');
    btn.removeAttribute('data-fsb-before-gift-label');
    btn.disabled = false;
  }
  /* Apply a normal code as before. Before that, a lookup is performed when a
     stored BON coupon has no gift metadata yet, so old/cached Free Gift cards
     still add their entitled Shopify variant. */
  function bonApplyDiscountCode(code, btn, gift, lookupDone){
    code = String(code || '').trim();
    if (!code) return false;

    if (!gift && !lookupDone) {
      bonSetGiftButtonBusy(btn, 'Checking reward');
      bonLookupGiftForCode(code).then(function(info){
        bonApplyDiscountCode(code, btn, bonGiftFromRedeemResponse(info), true);
      }).catch(function(){
        bonApplyDiscountCode(code, btn, null, true);
      });
      return true;
    }

    if (!gift) {
      bonRememberAndApplyDiscount(code, btn);
      return true;
    }

    bonSetGiftButtonBusy(btn, 'Adding free gift to cart');
    bonResolveGiftVariant(gift).then(function(variantId){
      if (!variantId) throw new Error('Free gift has no purchasable Shopify variant');
      return bonAddGiftToCart(variantId, gift.quantity || 1);
    }).then(function(){
      updateCartCount();
      bonRememberAndApplyDiscount(code, btn);
    }).catch(function(err){
      console.error('[FSB] Free gift was not added to cart:', err);
      bonRestoreGiftButton(btn);
      window.alert('The reward code was not applied because its free gift could not be added to the cart. Please try again. If this continues, contact support.');
    });
    return true;
  }
  /* Walks any redeem response shape to the first plausible discount code. */
  function bonDeepFindCode(o, depth){
    if (depth > 5 || o == null || typeof o !== 'object') return '';
    if (Array.isArray(o)){
      for (var i = 0; i < o.length; i++){ var r = bonDeepFindCode(o[i], depth + 1); if (r) return r; }
      return '';
    }
    var keys = Object.keys(o);
    for (var k = 0; k < keys.length; k++){
      if (/^(code|discount_code|coupon_code|voucher_code|reward_code)$/i.test(keys[k])){
        var v = String(o[keys[k]] || '').trim();
        if (v.length >= 4 && v.indexOf('{') === -1) return v;
      }
    }
    for (var j = 0; j < keys.length; j++){ var r2 = bonDeepFindCode(o[keys[j]], depth + 1); if (r2) return r2; }
    return '';
  }

  // Action 1: Redeem reward (Download icon)
  function bonRedeem(id, btn, scope){
    if (!btn || btn.disabled) return;
    var existingCode = btn.getAttribute('data-fsb-reward-code') || '';
    if (existingCode && bonApplyDiscountCode(existingCode, btn)) return;
    var base = String(bonSeed.apiBase || '').trim();
    var oldHtml = btn.innerHTML;
    btn.classList.add('is-loading');
    btn.setAttribute('aria-busy', 'true');
    btn.disabled = true;
    function bail(){
      /* Redemption via the proxy not possible → send the customer to the BON
         loyalty page (Theme Settings > "BON Loyalty page URL"), never the
         bare account page when a BON page exists. */
      btn.classList.remove('is-loading');
      btn.removeAttribute('aria-busy');
      btn.innerHTML = oldHtml;
      btn.disabled = false;
      var target = BON_LY || String(bonSeed.accountUrl || '/account');
      if (target) window.location.href = target;
    }
    if (base && id && bonState.cid && bonState.email){
      /* GAS proxy v14+: redeem through the BON API, get the freshly generated
         discount code back, then auto-apply it to the cart. */
      var url = base.replace(/\/+$/, '') + '?action=redeem'
              + '&shopify_id=' + encodeURIComponent(bonState.cid)
              + '&email=' + encodeURIComponent(bonState.email)
              + '&reward_id=' + encodeURIComponent(id);
      fetch(url, { headers: { 'Accept': 'application/json' }, credentials: 'omit' })
      .then(function(r){ if (!r.ok) throw new Error('redeem ' + r.status); return r.json(); })
      .then(function(d){
        var code = d ? bonDeepFindCode(d) : '';
        if (!code) throw new Error('No discount code returned');
        /* Reflect the deducted points immediately (BON returns the new
           balance in current_point). */
        if (d && d.current_point !== undefined && d.current_point !== null){
          bonSetPoints(d.current_point, true);
          bonWriteCache();
        }
        var gift = bonGiftFromRedeemResponse(d);
        var newReward = {
          coupon_code: code,
          code: code,
          status: 'available',
          title: btn.closest('.fsb-rw-card') ? (btn.closest('.fsb-rw-card').querySelector('.fsb-rw-name') ? btn.closest('.fsb-rw-card').querySelector('.fsb-rw-name').textContent : 'Reward') : 'Reward',
          discount_type: 'reward'
        };
        if (gift) {
          newReward.variant_id = gift.variant_id || '';
          newReward.product_handle = gift.product_handle || '';
          newReward.product_url = gift.product_url || '';
          newReward.quantity = gift.quantity || 1;
        }
        if (!Array.isArray(bonState.rewards)) bonState.rewards = [];
        bonState.rewards.unshift(newReward);
        bonWriteCache();
        updateRewardsBadge();
        ['rewards', 'points'].forEach(function(sc){ bonRenderPanel(sc); });
        /* Free-product reward: Shopify must receive the variant before
           the freshly generated BON code is applied. */
        btn.classList.remove('is-loading');
        btn.removeAttribute('aria-busy');
        btn.disabled = false;
        bonApplyDiscountCode(code, btn, gift);
      })
      .catch(bail);
      return;
    }
    bail();
  }

  // ============================================================
  // BON LOYALTY - REAL API VIA SECURE PROXY
  // Worker URL is set in the theme setting "bon_api_base".
  // If not set or the worker is down → metafield/widget fallback.
  // ============================================================
  function bonFetchProxy(){
    var base = String(bonSeed.apiBase || '').trim();
    if (!base || !bonState.cid || !bonState.email) return Promise.resolve(null);
    /* Cloudflare Worker: /customer? path — Google Apps Script (/exec):
       params go straight after '?'. It handles both. */
    var sep = (base.indexOf('/exec') !== -1) ? '?' : '/customer?';
    var url = base.replace(/\/+$/, '') + sep + 'shopify_id=' + encodeURIComponent(bonState.cid)
             + '&email=' + encodeURIComponent(bonState.email);
    return fetch(url, { headers: { 'Accept': 'application/json' }, credentials: 'omit' })
      .then(function(r){
        if (!r.ok) throw new Error('proxy HTTP ' + r.status);
        return r.json();
      })
      .then(function(d){
        if (!d || d.error) throw new Error((d && d.error) || 'proxy error');
        return d;
      })
      .catch(function(err){
        console.warn('[FSB] BON proxy unavailable — using metafield/widget data:', err && err.message);
        return null;
      });
  }

  function bonApplyProxy(d){
    if (!d) return false;
    /* Accept both flattened proxy results and BON's nested customer shape;
       balance and tier stay separate fields. */
    var customer = (d.data && d.data.customer) || d.customer || d;
    if (!customer || typeof customer !== 'object') customer = d;
    var apiPoints = d.points !== undefined ? d.points : customer.points;
    if (apiPoints !== undefined && apiPoints !== null) bonSetPoints(apiPoints, true);
    var pe = bonNum(d.points_earned !== undefined ? d.points_earned : customer.points_earned);
    if (pe > 0) bonState.pointsEarned = pe;
    /* A cached VIP name is only a temporary display while BON loads. */
    bonState.tier = bonCleanTier(bonSeed.tier);
    /* A named current tier from the BON proxy outranks the metafield;
       explicit customer_tier/current_tier below take final precedence. */
    var flatTier = bonCleanTier(d.tier);
    if (flatTier) bonState.tier = flatTier;
    var customerTier = bonCleanTier(d.customer_tier || customer.customer_tier);
    if (customerTier) bonState.tier = customerTier;
    var px = bonNum(bonPick(d, ['points_expiring','expiring_points','points_to_expire','expiring_point']));
    var pd = bonPick(d, ['points_expiry_date','points_expires_at','points_expire_at','points_expiring_date','point_expired_at']);
    if (pd && !(px > 0)) bonState.pointsExpiry = { amount: 0, date: String(pd) };
    if (px > 0 && pd) bonState.pointsExpiry = { amount: px, date: String(pd) };
    /* BON tier program rows provide names, thresholds and artwork only.
       The member's assigned current tier below controls which row is shown. */
    var program = (d.data && d.data.tier) || (d.tier && typeof d.tier === 'object' ? d.tier : null);
    var apiRows = d.tier_details || (program && program.tier_details) || [];
    var apiTiers = bonNormTierRows(apiRows);
    if (apiTiers){
      /* keep the RAW api rows too (pre-normalisation) so the optional
         ?fsb-tiers-debug=1 overlay can show exactly what BON returned */
      bonState.tierRowsRaw = Array.isArray(apiRows) ? apiRows : null;
      bonState.tierRowsApi = apiTiers.map(function(t){
        var sv = bonNum(t.spend);
        /* BON **VIP Tiers** API: required_value is ALREADY in whole store
           currency (e.g. Toro = $1,000 arrives as 1000) — NOT cents.
           Display the amount EXACTLY as set in BON: no division anywhere. */
        return { name: t.name, spend: sv, icon: t.icon };
      });
      bonWriteCache();
    }
    /* Thresholds order the program rows, but cannot assign a member's tier. */
    var tierRows = d.tiers || d.vip_tiers || d.loyalty_tiers || d.tier_programs || d.b2b_tiers || [];
    var fetchedTiers = bonNormTierRows(tierRows);
    if (fetchedTiers) bonState.tierRows = fetchedTiers;
    /* BON's current_tier overrides tags, metafield and old cached data.
       Also accept the nested tier-query shape in a raw GraphQL response. */
    var tcd = d.tier_customer_detail || (program && program.tier_customer_detail);
    var currentTier = bonCleanTier(d.current_tier || (tcd && tcd.current_tier));
    if (currentTier) bonState.tier = currentTier;
    /* An explicit BON VIP total can be displayed without pretending it is
       membership-year spend. A missing field is NOT zero. */
    var vipMoney = bonExtractVipMoney(d, tcd, customer);
    bonState.vipMoneySpent = vipMoney;
    bonState.vipMoneySpentKnown = vipMoney !== null;
    var normTiers = bonNormTiers(tierRows);
    if (normTiers.length) bonState.tiers = normTiers;
    var historyRows = d.point_histories || d.point_history || d.transactions || d.point_transactions || [];
    if (Array.isArray(historyRows) && historyRows.length) bonState.history = historyRows;
    if (Array.isArray(d.rewards) && d.rewards.length) bonState.rewards = d.rewards;
    if (Array.isArray(d.redeem_functions) && d.redeem_functions.length) bonState.redeem = d.redeem_functions;
    if (Array.isArray(d.earning_functions) && d.earning_functions.length) bonState.earn = d.earning_functions;
    if (d.full_name) bonState.memberName = String(d.full_name);
    else if (d.first_name) bonState.memberName = String(d.first_name);
    if (d.created_at) {
      bonState.createdAt = String(d.created_at);
      bonState.memberSince = String(d.created_at).slice(0, 4);
    }
    return true;
  }

  var bonRefreshPromise = null;
  function bonRefresh(){
    if (!bonState.cid) return Promise.resolve();
    if (bonRefreshPromise) return bonRefreshPromise;
    bonState.loading = true;
    bonRefreshPromise = bonFetchProxy()
      .then(function(proxyData){
        if (proxyData) {
          /* Real BON API data — authoritative */
          bonApplyProxy(proxyData);
        } else {
          /* Fallback 1: BON customer metafields (Liquid seed) */
          if (bonNum(bonSeed.points) > 0) {
            bonSetPoints(bonSeed.points, true);
          }
          /* Fallback 2: live BON widget balance */
          bonReadWidgetPoints();
        }
        bonState.loading = false;
        bonState.loaded = true;
        bonWriteCache();
        updateRewardsBadge();
        /* When data refreshes, re-render BOTH panels — so the panel that
           was already open also gets the real data. */
        ['points', 'rewards'].forEach(function(sc){
          var el = document.getElementById('fsb-' + sc + '-body-' + sid);
          if (el && el.innerHTML) bonRenderPanel(sc);
        });
      })
      .catch(function(){
        bonState.loading = false;
      })
      .then(function(){
        bonRefreshPromise = null;
      });
    return bonRefreshPromise;
  }

  function bonWaitForInitialPoints(timeoutMs){
    if (!bonState.cid || bonState.pointsKnown) return Promise.resolve();
    var started = Date.now();
    return bonRefresh().then(function(){
      if (bonState.pointsKnown) return;
      return new Promise(function(resolve){
        var timer = setInterval(function(){
          bonReadWidgetPoints();
          if (bonState.pointsKnown || Date.now() - started >= timeoutMs){
            clearInterval(timer);
            resolve();
          }
        }, 100);
      });
    });
  }

  function initLoyaltyPanel(scope){
    bonScrapeTiers();
    bonReadWidgetPoints();
    bonRenderPanel(scope);
    if (!bonState.loaded && bonState.cid){
      bonRefresh().then(function(){ bonRenderPanel(scope); });
    }
  }

  /* ============================================================
     WIDGET WATCHER — the BON widget appears asynchronously AFTER
     page load for logged-in customers. We check every 2s (up to 24s):
     as soon as the widget appears, points are read and the open panel
     refreshes.
     ============================================================ */
  var fsbBonWatchTries = 0;
  var fsbBonWatch = setInterval(function(){
    fsbBonWatchTries++;
    var before = bonNum(bonState.points);
    var knownBefore = bonState.pointsKnown;
    var tiersBefore = !!(bonState.tierRows && bonState.tierRows.length);
    bonReadWidgetPoints();
    bonScrapeTiers();
    var tiersChanged = !tiersBefore && !!(bonState.tierRows && bonState.tierRows.length);
    if ((bonState.pointsKnown && (bonNum(bonState.points) !== before || !knownBefore)) || tiersChanged) {
      ['points', 'rewards'].forEach(function(sc){
        var el = document.getElementById('fsb-' + sc + '-body-' + sid);
        if (el && el.innerHTML) bonRenderPanel(sc);
      });
      renderAccountSummary();
    }
    if (fsbBonWatchTries >= 60) clearInterval(fsbBonWatch);
  }, 2000);

  /* BON mounts its widget lazily — watch the DOM and grab the tiers the
     moment BON's markup/scripts appear (stops once tiers are found). */
  var fsbScrapeTimer = null;
  function fsbOnTiersFound(){
    ['points', 'rewards'].forEach(function(sc){
      var el = document.getElementById('fsb-' + sc + '-body-' + sid);
      if (el && el.innerHTML) bonRenderPanel(sc);
    });
    renderAccountSummary();
  }
  try {
    var fsbMoStart = Date.now();
    var fsbMo = new MutationObserver(function(){
      if (fsbScrapeTimer) return;
      fsbScrapeTimer = setTimeout(function(){
        fsbScrapeTimer = null;
        if (bonState.tierRows && bonState.tierRows.length){ fsbMo.disconnect(); return; }
        if (Date.now() - fsbMoStart > 120000){ fsbMo.disconnect(); return; }
        bonScrapeTiers();
        if (bonState.tierRows && bonState.tierRows.length){ fsbOnTiersFound(); fsbMo.disconnect(); }
      }, 500);
    });
    fsbMo.observe(document.documentElement, { childList: true, subtree: true });
  } catch(e){}

  /* Console helper for diagnosis: type fsbBonTiersDebug() in DevTools. */
  window.fsbBonTiersDebug = function(){
    return { tierRows: bonState.tierRows, resolved: bonTiersResolved(),
             tierName: bonState.tier, info: bonTierInfo() };
  };

  // Apply the last real balance immediately, then refresh BON in the
  // background before either loyalty drawer is opened.
  bonApplyCache();
  bonReadWidgetPoints();
  updateRewardsBadge();
  var bonInitialLoad = bonState.cid ? bonRefresh() : Promise.resolve();

  // Bind triggers
  var pointsTrigger = document.getElementById('points-panel-trigger-' + sid);
  if (pointsTrigger) {
    var newPointsTrigger = pointsTrigger.cloneNode(true);
    pointsTrigger.parentNode.replaceChild(newPointsTrigger, pointsTrigger);
    newPointsTrigger.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      /* Remember this click now, but never let its delayed BON result steal
         another drawer the customer picked while points were loading. */
      fsbPersistOpenPanel('points');
      fsbClearClosed();
      bonWaitForInitialPoints(2500).then(function(){
        if (fsbGetState(FSB_CLOSED_KEY) || fsbGetState(FSB_PANEL_KEY) !== 'points') return;
        openPanel('points');
      });
    });
  }

  var rewardsTrigger = document.getElementById('rewards-panel-trigger-' + sid);
  if (rewardsTrigger) {
    var newRewardsTrigger = rewardsTrigger.cloneNode(true);
    rewardsTrigger.parentNode.replaceChild(newRewardsTrigger, rewardsTrigger);
    newRewardsTrigger.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      /* Remember this click now, but never let its delayed BON result steal
         another drawer the customer picked while points were loading. */
      fsbPersistOpenPanel('rewards');
      fsbClearClosed();
      bonWaitForInitialPoints(2500).then(function(){
        if (fsbGetState(FSB_CLOSED_KEY) || fsbGetState(FSB_PANEL_KEY) !== 'rewards') return;
        openPanel('rewards');
      });
    });
  }


  /* Account drawer: desktop and mobile use the same tabbed membership UI. */
  var accountTrigger=document.getElementById('account-panel-trigger-'+sid);
  var accountPanel=document.getElementById('fsb-panel-account-'+sid);
  function renderAccountSummary(){
    if(!accountPanel) return;
    var sum=document.getElementById('fsb-account-summary-'+sid);
    if(!sum) return;
    /* Same header as the Points and Rewards drawers:
       tier image card -> POINTS EARNED -> big number -> expiry line ->
       thin gold bar -> honest annual-progress-unavailable notice. */
    bonSetTierContent(sum, bonPointsCard());
  }
  function accountTab(name){
    if(!accountPanel) return;
    accountPanel.querySelectorAll('[data-account-tab]').forEach(function(b){b.classList.toggle('is-active',b.getAttribute('data-account-tab')===name);});
    accountPanel.querySelectorAll('[data-account-pane]').forEach(function(p){p.classList.toggle('is-active',p.getAttribute('data-account-pane')===name);});
    if(name==='history'){
      var h=document.getElementById('fsb-account-history-'+sid); if(h){h.innerHTML=bonRenderHistory(); bonBindPanel(h,'points');}
    }
    if(name==='rewards'){
      var r=document.getElementById('fsb-account-rewards-'+sid); if(r){
        r.innerHTML=bonTabs('rewards')+bonRewardsInner(); bonBindPanel(r,'rewards');
      }
    }
  }
  /* ---------- Order details pair drawer ---------- */
  function fsbOdPanel(){ return document.getElementById('fsb-panel-orderdetail-' + sid); }
  /* Gold border on the clicked order card while its detail is open
     (visible only when the od-pair is open — CSS gates on the overlay class). */
  function fsbOdSelect(hostPanel, orderId){
    overlay.querySelectorAll('.fsb-od-selected').forEach(function(el){ el.classList.remove('fsb-od-selected'); });
    if (!hostPanel) return;
    var trigEl = hostPanel.querySelector('[data-fsb-od="' + String(orderId).replace(/"/g, '') + '"]');
    var card = trigEl ? (trigEl.closest('.fsb-list-card') || trigEl) : null;
    if (card) card.classList.add('fsb-od-selected');
  }
  function fsbOdClearSelect(){
    overlay.querySelectorAll('.fsb-od-selected').forEach(function(el){ el.classList.remove('fsb-od-selected'); });
  }
  /* ---------- MOBILE: order details INSIDE the membership drawer ----------
     Header, summary card and tabs stay exactly as they are; the order
     detail replaces the pane content and "Back" restores the list. */
  var odInlineEl = null;
  function fsbOdInlineWrap(){ return document.getElementById('fsb-account-od-' + sid); }
  function fsbOdInlineOpen(orderId){
    var panel = accountPanel, slot = document.getElementById('fsb-account-od-slot-' + sid),
        wrap = fsbOdInlineWrap(), odPanel = fsbOdPanel();
    if (!panel || !slot || !wrap || !odPanel) return false;
    var el = odPanel.querySelector('.fsb-od[data-order-id="' + String(orderId).replace(/"/g, '') + '"]');
    if (!el) return false;
    odInlineEl = el;
    el.hidden = false;
    slot.appendChild(el);
    wrap.hidden = false;
    panel.classList.add('fsb-account-od-open');
    var body = panel.querySelector('.fsb-account-body') || panel.querySelector('.fsb-panel-body');
    if (body) body.scrollTop = 0;
    return true;
  }
  function fsbOdInlineClose(){
    if (!odInlineEl){
      var wrap0 = fsbOdInlineWrap();
      if (wrap0) wrap0.hidden = true;
      if (accountPanel) accountPanel.classList.remove('fsb-account-od-open');
      return;
    }
    var odPanel = fsbOdPanel();
    var body = odPanel ? odPanel.querySelector('.fsb-od-body') : null;
    if (body){ odInlineEl.hidden = true; body.appendChild(odInlineEl); }
    odInlineEl = null;
    var wrap = fsbOdInlineWrap();
    if (wrap) wrap.hidden = true;
    if (accountPanel) accountPanel.classList.remove('fsb-account-od-open');
  }
  function fsbOdIsMobile(){
    return !!(window.matchMedia && window.matchMedia('(max-width: 767px)').matches);
  }
  function openOrderDetail(orderId, fromPanel){
    var odPanel = fsbOdPanel();
    if (!odPanel) return;
    /* reset any stale mobile-inline state first (e.g. drawer was closed
       with X while the inline detail was open) */
    fsbOdInlineClose();
    var hostPanel = document.getElementById('fsb-panel-' + (fromPanel || 'orders') + '-' + sid);
    /* MOBILE + membership drawer: detail opens INSIDE the same drawer —
     no separate stacked drawer. */
    if (fromPanel === 'account' && fsbOdIsMobile()){
      if (fsbOdInlineOpen(orderId)){
        closeCart();
        sectionRoot.classList.remove('fsb-region-panel-open');
        allPanels().forEach(function(panel){ if (panel !== hostPanel) panel.classList.remove('active'); });
        if (hostPanel) hostPanel.classList.add('active');
        overlay.classList.remove('fsb-address-pair-open');
        overlay.classList.remove('fsb-address-edit-pair-open');
        overlay.classList.remove('fsb-od-pair-open');
        syncBodyState();
        setActiveIcon('account');
      }
      return;
    }
    odPanel.querySelectorAll('.fsb-od').forEach(function(el){
      el.hidden = el.getAttribute('data-order-id') !== String(orderId);
    });
    odPanel.setAttribute('data-od-parent', fromPanel || 'orders');
    fsbOdSelect(hostPanel, orderId);
    closeCart();
    sectionRoot.classList.remove('fsb-region-panel-open');
    allPanels().forEach(function(panel){
      if (panel !== odPanel && panel !== hostPanel) panel.classList.remove('active');
    });
    if (hostPanel) hostPanel.classList.add('active');
    odPanel.classList.add('active');
    overlay.classList.remove('fsb-address-pair-open');
    overlay.classList.remove('fsb-address-edit-pair-open');
    overlay.classList.remove('fsb-od-pair-open');
    overlay.classList.add('fsb-od-pair-open');
    var body = odPanel.querySelector('.fsb-panel-body');
    if (body) body.scrollTop = 0;
    syncBodyState();
    setActiveIcon(fromPanel === 'account' ? 'account' : 'orders');
  }
  function closeOrderDetail(){
    var odPanel = fsbOdPanel();
    if (!odPanel) return;
    odPanel.classList.remove('active');
    overlay.classList.remove('fsb-od-pair-open');
    fsbOdClearSelect();
    syncBodyState();
  }
  overlay.addEventListener('click', function(e){
    var trig = e.target.closest('[data-fsb-od]');
    if (trig) {
      e.preventDefault();
      var inAccount = !!trig.closest('.fsb-account-panel');
      openOrderDetail(trig.getAttribute('data-fsb-od'), inAccount ? 'account' : 'orders');
      return;
    }
    if (e.target.closest('[data-fsb-od-back]')) {
      e.preventDefault();
      closeOrderDetail();
      return;
    }
    if (e.target.closest('[data-fsb-account-od-back]')) {
      e.preventDefault();
      fsbOdInlineClose();
      accountTab('orders');
    }
  });
  function openAccount(){ fsbOdInlineClose(); openPanel('account'); renderAccountSummary(); accountTab('profile'); if(bonState.cid&&!bonState.loaded) bonRefresh().then(renderAccountSummary); }
  if(accountTrigger){var ac=accountTrigger.cloneNode(true);accountTrigger.parentNode.replaceChild(ac,accountTrigger);ac.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();openAccount();});}
  /* CHANGE v8.7: the account (My Membership) wrapper keeps its text label
     OUTSIDE the trigger anchor — every other sidebar icon has its label
     inside its own link — so taps on the text, or the gaps around it,
     never reached the drawer handler and only the icon reacted. Forward
     any tap on the wrapper that is not on a link to the live trigger so
     text and icon behave the same. The logged-out logo wrapper (its label
     also sits outside its link) gets the same forwarding. */
  var accWrap=sectionRoot.querySelector('.account-mbl')||sectionRoot.querySelector('.fsb-logo-wrap > .mobile-order-item');
  if(accWrap){accWrap.addEventListener('click',function(e){
    if(e.target.closest('a'))return;
    var trig=accWrap.querySelector('a');
    if(trig){e.preventDefault();e.stopPropagation();trig.click();}
  });}
  if(accountPanel){accountPanel.addEventListener('click',function(e){
    var tab=e.target.closest('[data-account-tab]');if(tab){e.preventDefault();fsbOdInlineClose();accountTab(tab.getAttribute('data-account-tab'));}
    /* Rewards sub-tabs (Available / Used / Expired) inside the membership drawer */
    var lyt=e.target.closest('[data-fsb-lytab]');if(lyt){e.preventDefault();bonTab.rewards=lyt.getAttribute('data-fsb-lytab');accountTab('rewards');}
    var htab=e.target.closest('.fsb-history-tabs button');if(htab){var hs=htab.parentNode;hs.querySelectorAll('button').forEach(function(b){b.classList.remove('is-active');});htab.classList.add('is-active');}
    var region=e.target.closest('[data-fsb-open-region]');if(region){e.preventDefault();closeAllPanels();openPanel('region');}
    var add=e.target.closest('[data-fsb-account-add-address]');if(add){e.preventDefault();openAddressPair();}
    var lgo=e.target.closest('[data-fsb-logout]');if(lgo){e.preventDefault();window.location.href='{{ routes.account_logout_url }}';}
  });}
  // Expose for debugging
  window.fsbBonState = bonState;
  window.fsbBonFindPoints = bonFindPoints;
  window.fsbBonRefresh = bonRefresh;
  window.fsbInitLoyaltyPanel = initLoyaltyPanel;

  var menuToggle = sectionRoot.querySelector('[data-fsb-more-toggle]');
  var menuTitle = document.getElementById('fsb-menu-title-' + sid);
  var menuBack = document.getElementById('fsb-menu-back-' + sid);
  var desktopMenuTitle = {{ section.settings.menu_list.title | default: 'Menu' | json }};
  var mobileMenuTitle = {{ section.settings.mobile_menu_list.title | default: section.settings.menu_list.title | default: 'Menu' | json }};
  var defaultMenuTitle = desktopMenuTitle || 'Menu';
  function getCurrentMenuTitle(){
    if (window.matchMedia && window.matchMedia('(max-width: 767px)').matches) {
      return mobileMenuTitle || desktopMenuTitle || 'Menu';
    }
    return desktopMenuTitle || 'Menu';
  }
  if (menuToggle) {
    var newMenuToggle = menuToggle.cloneNode(true);
    menuToggle.parentNode.replaceChild(newMenuToggle, menuToggle);
    newMenuToggle.addEventListener('click', function(e){
      e.preventDefault();
      defaultMenuTitle = getCurrentMenuTitle();
      if (menuTitle) menuTitle.textContent = defaultMenuTitle;
      if (menuBack) menuBack.style.display = 'none';
      overlay.querySelectorAll('.fsb-menu-sub').forEach(function(sub){
        sub.classList.remove('active');
      });
      overlay.querySelectorAll('.fsb-menu-root > .fsb-menu-item').forEach(function(li){ li.style.display = ''; });
      openPanel('menu');
    });
  }
  overlay.addEventListener('click', function(e){
    var parentBtn = e.target.closest('.fsb-menu-parent');
    if (!parentBtn) return;
    e.preventDefault();
    e.stopPropagation();
    
    var li = parentBtn.closest('.fsb-menu-item');
    if (!li) return;
    
    var targetId = parentBtn.getAttribute('data-target');
    var sub = null;
    if (targetId) {
      sub = document.getElementById(targetId);
    }
    if (!sub) {
      sub = li.querySelector(':scope > .fsb-menu-sub');
    }
    if (!sub) return;
    
    var root = li.closest('.fsb-menu-root');
    if (root) {
      root.querySelectorAll(':scope > .fsb-menu-item').forEach(function(item){ 
        item.style.display = 'block'; 
      });
    }
    
    sub.classList.add('active');
    if (menuTitle) menuTitle.textContent = li.getAttribute('data-title') || defaultMenuTitle;
    if (menuBack) menuBack.style.display = 'inline-flex';
  });
  if (menuBack) {
    menuBack.addEventListener('click', function(e){
      e.preventDefault();
      e.stopPropagation();
      overlay.querySelectorAll('.fsb-menu-sub').forEach(function(sub){
        sub.classList.remove('active');
      });
      overlay.querySelectorAll('.fsb-menu-root > .fsb-menu-item').forEach(function(li){ 
        li.style.display = ''; 
      });
      defaultMenuTitle = getCurrentMenuTitle();
      if (menuTitle) menuTitle.textContent = defaultMenuTitle;
      menuBack.style.display = 'block';
    });
  }
  var pendingCountry = null;
  var pendingLang    = null;
  var pendingLyId    = null;
  var regionInitDone = false;

  var ALL_LANG_CONFIG = {
    'en': {
      code: 'en',
      lyId: 'ly16719',
      label: 'English',
      prefix: '',
      aliases: ['en', 'en-us', 'en-gb', 'english', 'x-default']
    },
    'ja': {
      code: 'ja',
      lyId: 'ly16725',
      label: '日本語',
      prefix: '/ja',
      aliases: ['ja', 'ja-jp', 'japanese']
    },
    'ko': {
      code: 'ko',
      lyId: 'ly16726',
      label: '한국어',
      prefix: '/ko',
      aliases: ['ko', 'ko-kr', 'korean']
    },
    'zh-cn': {
      code: 'zh-CN',
      lyId: 'ly16720',
      label: '简体中文',
      prefix: '/zh-CN',
      aliases: ['zh-cn', 'zh-hans', 'zh', 'chinese-simplified', 'zh-sg']
    },
    'zh-tw': {
      code: 'zh-TW',
      lyId: 'ly16724',
      label: '繁體中文',
      prefix: '/zh-TW',
      aliases: ['zh-tw', 'zh-hant', 'zh-hk', 'chinese-traditional']
    }
  };

  function normalizeLocaleCode(code) {
    if (!code) return '';
    var c = String(code).trim().toLowerCase().replace('_', '-');
    if (c === 'zh-cn' || c === 'zh-hans' || c === 'zh' || c === 'zh-sg') return 'zh-cn';
    if (c === 'zh-tw' || c === 'zh-hant' || c === 'zh-hk') return 'zh-tw';
    if (c === 'ja' || c === 'ja-jp' || c === 'japanese') return 'ja';
    if (c === 'ko' || c === 'ko-kr' || c === 'korean') return 'ko';
    if (c === 'en' || c === 'en-us' || c === 'en-gb' || c === 'english') return 'en';
    return c;
  }

  function syncProfileRegionDisplay(regionKey) {
    var isHk = (regionKey === 'HK');
    var valEl = document.getElementById('fsb-profile-region-val-' + sid);
    if (valEl) {
      valEl.textContent = isHk ? 'Hong Kong SAR' : 'International';
    }
  }

  /* ---------------------------------------------------------------------
     SHARED REGION API (used by the drawer AND by the first-visit region popup)
     One selection must be reflected everywhere at once:
       1. the Region & Language drawer (the option marked as current)
       2. the Membership drawer (the Region row of the profile)
       3. the browser memory (localStorage + country cookie) and the backend
          (the same BON / GAS 'pref_set' call the Apply Changes button makes)
     window.fsbSetRegion('HK') / window.fsbSetRegion('INT')
     --------------------------------------------------------------------- */
  function fsbRegionOptionIso(regionList, wantHk){
    var iso = '';
    if (!regionList) return iso;
    regionList.querySelectorAll('.fsb-region-option').forEach(function(b){
      var c = b.getAttribute('data-country');
      if (!c) return;
      if (wantHk ? (c === 'HK') : (c !== 'HK')) { if (!iso) iso = c; }
    });
    if (!iso && !wantHk) iso = 'HK';   /* never hand an empty code to Shopify */
    return iso;
  }

  /* ---------------------------------------------------------------------
     MARKET SWITCHING (Settings -> Markets)
     Shopify only accepts countries of the CURRENT market on /localization,
     so a real market switch needs the other market's subfolder (e.g. /intl,
     set in the theme settings and created in Shopify admin first).
     --------------------------------------------------------------------- */
  var HK_PATH = (function(){
    try {
      var r = document.getElementById('sid-' + sid);
      return String((r && r.getAttribute('data-hk-path')) || '').replace(/\/+$/, '');
    } catch(e){ return ''; }
  })();
  var HK_PATH_ZH = (function(){
    try {
      var r = document.getElementById('sid-' + sid);
      return String((r && r.getAttribute('data-hk-path-zh')) || '').replace(/\/+$/, '');
    } catch(e){ return ''; }
  })();
  var CUR_LANG = '{{ localization.language.iso_code }}';
  /* International lives on the main domain, Hong Kong under its subfolder(s) */
  function fsbHkPath(){
    return window.fsbHkRoot();   /* FIX v2: keep current language (/ja -> /ja-hk) */
  }
  function fsbHkPrefixes(){
    var list = [];
    if (HK_PATH) list.push(HK_PATH.toLowerCase());
    if (HK_PATH_ZH && HK_PATH_ZH.toLowerCase() !== HK_PATH.toLowerCase()) list.push(HK_PATH_ZH.toLowerCase());
    return list;
  }
  function fsbOnHk(p){
    /* FIX v2: any "-hk" language folder counts as Hong Kong */
    if (p == null) return window.fsbIsHk();
    return window.fsbIsHkPath(p);
  }
  function fsbStripHk(p){
    /* FIX: remove ALL locale folders (not only the HK ones) */
    return window.fsbCleanPath(p == null ? window.location.pathname : p);
  }
  function fsbMarketTargetUrl(wantHk, path, search){
    var rest = window.fsbSwapHkHandle(fsbStripHk(path == null ? window.location.pathname : path), wantHk);   /* FIX v3 */
    var s = (search != null) ? String(search) : window.location.search;
    if (wantHk){
      var pref = fsbHkPath();
      if (!pref) return '';
      return window.location.origin + pref + (rest || '/') + s;
    }
    return window.location.origin + window.fsbIntRoot() + (rest || '/') + s;   /* FIX v2: keep language */
  }
  function fsbGoMarket(url){
    try { if (window.__fsbNavStub) { window.__fsbNavStub(url); return; } } catch(e){}
    window.location.href = url;
  }
  window.__fsbMarketApi = {
    hkPath: function(){ return fsbHkPath(); },
    onHk: fsbOnHk,
    target: fsbMarketTargetUrl,
    go: fsbGoMarket
  };
  /* one console line that always tells the truth about where the visitor is */
  try { console.log('[FSB] Shopify market: "{{ localization.market.handle }}" · country: "{{ localization.country.iso_code }}" · region: ' + ((fsbOnHk() || '{{ localization.country.iso_code }}' === 'HK') ? 'Hong Kong' : 'International')); } catch(e){}
  function fsbPushRegionToBackend(region){
    /* the exact call the 'Apply Changes' button makes: BON backend via GAS */
    var pushed = false;
    try {
      var base      = String((bonSeed && bonSeed.apiBase) || '').trim();
      var email     = String((bonSeed && bonSeed.customerEmail) || '').trim();
      var shopifyId = String((bonSeed && bonSeed.customerId) || '').trim();
      if (base && (email || shopifyId)) {
        var prefUrl = base.replace(/\/+$/, '') + '?action=pref_set'
          + '&shopify_id=' + encodeURIComponent(shopifyId)
          + '&email=' + encodeURIComponent(email)
          + '&region=' + encodeURIComponent(region === 'HK' ? 'HK' : 'International');
        fetch(prefUrl, { headers: { 'Accept': 'application/json' }, credentials: 'omit', keepalive: true }).catch(function(){});
        pushed = true;
      }
    } catch(e){}
    return pushed;
  }
  window.fsbSetRegion = function(regionKey, opts){
    opts = opts || {};
    var isHk = (regionKey === 'HK');
    var result = { region: isHk ? 'HK' : 'INT', country: '', backend: false };

    /* 1. Region & Language drawer: the same option becomes the current one */
    var regionList = document.getElementById('fsb-region-list-' + sid);
    var iso = fsbRegionOptionIso(regionList, isHk);
    if (iso) {
      result.country = iso;
      pendingCountry = iso;
      if (regionList) {
        regionList.querySelectorAll('.fsb-region-option').forEach(function(b){
          b.classList.toggle('is-current', b.getAttribute('data-country') === iso);
        });
      }
      var cInp = document.getElementById('fsb-country-input-' + sid);
      if (cInp) cInp.value = iso;
    }

    /* 2. Membership drawer: the Region row shows the same value */
    if (typeof syncProfileRegionDisplay === 'function') syncProfileRegionDisplay(isHk ? 'HK' : 'INT');

    /* 3. remember it exactly like the drawer does */
    try {
      localStorage.setItem('fsb_selected_region', isHk ? 'HK' : 'INT');
      localStorage.setItem('fsb_region_gate_at', String(Date.now()));
      if (iso) {
        sessionStorage.setItem('fsb_country', iso);
        document.cookie = '_shopify_country=' + encodeURIComponent(iso) + '; path=/; max-age=31536000; SameSite=Lax';
        document.cookie = 'localization_country=' + encodeURIComponent(iso) + '; path=/; max-age=31536000; SameSite=Lax';
      }
    } catch(e){}

    /* 4. backend (skipped only if the caller explicitly asks for it) */
    if (opts.backend !== false) result.backend = fsbPushRegionToBackend(isHk ? 'HK' : 'International');
    return result;
  };

  /* ------------------------------------------------------------
     1. CUSTOMER PROFILE LANGUAGE (Membership Drawer)
     Updates customer.locale + metafields in Shopify Admin backend ONLY via GAS proxy.
     Does NOT change storefront website language, does NOT reload page.
     ------------------------------------------------------------ */
  function handleCustomerLanguageChange(langCode) {
    if (!langCode) return;
    var norm = normalizeLocaleCode(langCode);
    var labels = {
      'en': 'English',
      'ja': '日本語',
      'ko': '한국어',
      'zh-cn': '简体中文',
      'zh-tw': '繁體中文'
    };

    // Update UI trigger label and active checkmark in the custom dropdown
    var dd = document.getElementById('fsb-lang-dropdown-' + sid);
    if (dd) {
      var curText = dd.querySelector('.fsb-lang-dd-current');
      if (curText) curText.textContent = labels[norm] || 'English';
      dd.querySelectorAll('.fsb-lang-dd-item').forEach(function(item){
        var itemLang = normalizeLocaleCode(item.getAttribute('data-lang'));
        item.classList.toggle('is-selected', itemLang === norm);
      });
      dd.classList.remove('is-open');
    }

    // Send API update to Shopify Admin via GAS proxy (Updates customer.locale in Shopify Admin)
    var email = String(bonSeed.customerEmail || '').trim();
    var shopifyId = String(bonSeed.customerId || '').trim();
    var base = String(bonSeed.apiBase || '').trim();
    if ((email || shopifyId) && base) {
      var url = base.replace(/\/+$/, '') + '?action=pref_set'
        + '&shopify_id=' + encodeURIComponent(shopifyId)
        + '&email=' + encodeURIComponent(email)
        + '&language=' + encodeURIComponent(langCode);
      try {
        fetch(url, { headers: { 'Accept': 'application/json' }, credentials: 'omit', keepalive: true })
          .then(function(res){ return res.json(); })
          .then(function(data){
            console.log('[FSB] Customer communication language updated in Shopify Admin:', data);
          })
          .catch(function(){});
      } catch(e){}
    }
  }

  /* ------------------------------------------------------------
     2. STOREFRONT REGION & LANGUAGE DRAWER
     - Language change: changes frontend display language ONLY.
     - Region change: changes frontend region + syncs backend region + updates Membership drawer.
     ------------------------------------------------------------ */
  function setLangifyCookies(normCode, targetId) {
    try {
      var maxAge = 31536000;
      var domain = window.location.hostname;
      var parts = domain.split('.');
      var rootDomain = parts.length > 1 ? parts.slice(-2).join('.') : domain;

      var setCookie = function(k, v) {
        document.cookie = k + '=' + encodeURIComponent(v) + '; path=/; max-age=' + maxAge + '; SameSite=Lax';
        if (rootDomain && rootDomain !== domain) {
          document.cookie = k + '=' + encodeURIComponent(v) + '; domain=.' + rootDomain + '; path=/; max-age=' + maxAge + '; SameSite=Lax';
        }
      };

      if (targetId) {
        setCookie('ly-lang', targetId);
        setCookie('langify-lang', targetId);
        setCookie('ly_lang', targetId);
        setCookie('ly-lang-id', targetId);
      }
      setCookie('ly-lang-code', normCode);
      setCookie('ly_lang_code', normCode);
      setCookie('language', normCode);
      setCookie('ly-lang-selected', '1');

      try {
        if (targetId) localStorage.setItem('ly-lang', targetId);
        localStorage.setItem('ly-lang-code', normCode);
        localStorage.setItem('fsb_store_lang', normCode);
      } catch(e){}
    } catch(e){}
  }

  function findHreflangUrl(normCode) {
    var config = ALL_LANG_CONFIG[normCode];
    if (!config) return null;
    var aliases = config.aliases || [normCode];

    var links = document.querySelectorAll('link[rel="alternate"][hreflang]');
    for (var i = 0; i < links.length; i++) {
      var link = links[i];
      var hl = String(link.getAttribute('hreflang') || '').trim().toLowerCase();
      var href = link.getAttribute('href');
      if (!href) continue;

      for (var a = 0; a < aliases.length; a++) {
        if (hl === aliases[a].toLowerCase()) {
          return href;
        }
      }
    }
    return null;
  }

  function getTargetLocaleUrl(targetNormCode) {
    // 1. First priority: Check <link rel="alternate" hreflang="..."> tag in <head>
    var hreflangUrl = findHreflangUrl(targetNormCode);
    if (hreflangUrl) return hreflangUrl;

    // 2. Second priority: Check Shopify localization data
    var rawPath = window.location.pathname;
    var cleanPath = rawPath.replace(/^\/(?:en|ja|ko|zh-cn|zh-tw|zh-hans|zh-hant|zh|ja-jp|ko-kr|zh-hk)(?=\/|$)/i, '') || '/';
    if (!cleanPath.startsWith('/')) cleanPath = '/' + cleanPath;

    var config = ALL_LANG_CONFIG[targetNormCode];
    var prefix = (config && config.prefix) ? config.prefix : '';

    try {
      var dataEl = document.getElementById('fsb-localization-data-' + sid);
      if (dataEl) {
        var data = JSON.parse(dataEl.textContent);
        if (data && data.availableLanguages) {
          for (var i = 0; i < data.availableLanguages.length; i++) {
            var l = data.availableLanguages[i];
            if (normalizeLocaleCode(l.isoCode) === targetNormCode && l.rootUrl) {
              prefix = l.rootUrl.replace(/\/+$/, '');
              break;
            }
          }
        }
      }
    } catch(e){}

    var finalPath = prefix + (cleanPath === '/' ? (prefix ? '' : '/') : cleanPath);
    if (!finalPath) finalPath = '/';
    return window.location.origin + finalPath + window.location.search + window.location.hash;
  }

  function triggerStorefrontLanguageSwitch(targetCode, lyId) {
    if (!targetCode) return false;
    var normCode = normalizeLocaleCode(targetCode);
    var config = ALL_LANG_CONFIG[normCode];
    var targetId = lyId || (config && config.lyId) || '';

    // 1. Set Langify cookies and localStorage
    setLangifyCookies(normCode, targetId);

    /* 2. FIX: let Shopify build the URL. Submit the native /localization form with the
       CURRENT country, the new language and a return_to WITHOUT any locale folder.
       Shopify adds exactly one correct prefix; if the language is not enabled for this
       market it falls back to the market's default language instead of a 404. */
    var locForm    = document.getElementById('fsb-localization-form-' + sid);
    var localeInp  = document.getElementById('fsb-locale-input-' + sid);
    var langInp    = document.getElementById('fsb-language-input-' + sid);
    var countryInp = document.getElementById('fsb-country-input-' + sid);
    var returnInp  = document.getElementById('fsb-return-to-' + sid);
    if (locForm) {
      var code = (config && config.code) ? config.code : targetCode;
      if (localeInp) localeInp.value = code;
      if (langInp) langInp.value = code;
      if (countryInp) countryInp.value = '{{ localization.country.iso_code }}';
      if (returnInp) returnInp.value = window.fsbCleanPath() + window.location.search + window.location.hash;
      try { HTMLFormElement.prototype.submit.call(locForm); return true; } catch(e){}
      try { locForm.submit(); return true; } catch(e2){}
    }

    // 3. Fallback: reload
    window.location.reload();
    return true;
  }

  function initRegionPanel(){
    if (regionInitDone) return;
    regionInitDone = true;
    var regionList = document.getElementById('fsb-region-list-' + sid);
    var langList   = document.getElementById('fsb-lang-list-' + sid);

    var currentCountry = '{{ localization.country.iso_code }}';
    var savedRegion = '';
    try { savedRegion = localStorage.getItem('fsb_selected_region') || ''; } catch(e){}
    /* Shopify Markets is the source of truth for where the visitor is
       (the market's country, or being on the Hong Kong subfolder) */
    var isHk = (currentCountry === 'HK') || fsbOnHk() || (!currentCountry && savedRegion === 'HK');

    syncProfileRegionDisplay(isHk ? 'HK' : 'INT');

    if (regionList) {
      regionList.querySelectorAll('.fsb-region-option').forEach(function(btn){
        var c = btn.getAttribute('data-country');
        var shouldBeActive = isHk ? (c === 'HK') : (c !== 'HK');
        btn.classList.toggle('is-current', shouldBeActive);
        if (shouldBeActive) pendingCountry = c;
      });

      regionList.addEventListener('click', function(e){
        var btn = e.target.closest('.fsb-region-option');
        if (!btn) return;
        var country = btn.getAttribute('data-country');
        if (!country) return;
        pendingCountry = country;
        regionList.querySelectorAll('.fsb-region-option').forEach(function(b){
          b.classList.toggle('is-current', b === btn);
        });
        var inp = document.getElementById('fsb-country-input-' + sid);
        if (inp) inp.value = pendingCountry;
      });
    }

    if (langList) {
      langList.addEventListener('click', function(e){
        var btn = e.target.closest('.fsb-lang-option');
        if (!btn) return;
        var lang = btn.getAttribute('data-lang');
        var lyId = btn.getAttribute('data-ly-id');
        if (!lang) return;
        pendingLang = lang;
        pendingLyId = lyId;
        langList.querySelectorAll('.fsb-lang-option').forEach(function(b){
          b.classList.toggle('is-current', b === btn);
        });
        var locInp = document.getElementById('fsb-locale-input-' + sid);
        if (locInp) locInp.value = pendingLang;
      });
    }

    tryPopulateFromLangify(regionList, langList);

    var applyBtn = document.getElementById('fsb-rl-apply-' + sid);
    if (applyBtn) {
      applyBtn.addEventListener('click', function(){
        applyRegionLanguage();
      });
    }

    // Bind custom language dropdown in profile tab (Membership drawer)
    var dd = document.getElementById('fsb-lang-dropdown-' + sid);
    if (dd) {
      var trigger = dd.querySelector('.fsb-lang-dd-trigger');
      if (trigger) {
        trigger.addEventListener('click', function(e){
          e.preventDefault();
          e.stopPropagation();
          dd.classList.toggle('is-open');
        });
      }
      dd.querySelectorAll('.fsb-lang-dd-item').forEach(function(item){
        item.addEventListener('click', function(e){
          e.preventDefault();
          e.stopPropagation();
          var langCode = item.getAttribute('data-lang');
          if (langCode) {
            handleCustomerLanguageChange(langCode);
          }
        });
      });
    }
  }

  function applyRegionLanguage(){
    var applyBtn = document.getElementById('fsb-rl-apply-' + sid);
    if (applyBtn){ applyBtn.disabled = true; applyBtn.textContent = 'Applying…'; }

    var currentCountry = '{{ localization.country.iso_code }}';
    var savedRegion = '';
    try { savedRegion = localStorage.getItem('fsb_selected_region') || ''; } catch(e){}
    var wasHk = (currentCountry === 'HK') || fsbOnHk() || (!currentCountry && savedRegion === 'HK');

    var targetCountry = pendingCountry || currentCountry;
    var isTargetHk = (targetCountry === 'HK');
    /* only a market CROSSING is a change (the drawer has just the two regions,
       not individual countries) */
    var regionChanged = (isTargetHk !== wasHk);

    var currentLangIso = '{{ localization.language.iso_code }}'.toLowerCase();
    var targetLang = pendingLang || currentLangIso;
    var langChanged = pendingLang && normalizeLocaleCode(pendingLang) !== normalizeLocaleCode(currentLangIso);

    // Save region preference in localStorage & cookies
    try {
      localStorage.setItem('fsb_selected_region', isTargetHk ? 'HK' : 'INT');
      sessionStorage.setItem('fsb_country', targetCountry);
      document.cookie = '_shopify_country=' + encodeURIComponent(targetCountry) + '; path=/; max-age=31536000; SameSite=Lax';
      document.cookie = 'localization_country=' + encodeURIComponent(targetCountry) + '; path=/; max-age=31536000; SameSite=Lax';
    } catch(e){}

    // Update Profile pane region display immediately in Membership drawer
    syncProfileRegionDisplay(isTargetHk ? 'HK' : 'INT');

    /* Crossing markets is done by URL - the only way Shopify switches markets:
       Hong Kong lives under its subfolder (e.g. /en-hk), International on the
       main domain. Inside one market the native /localization form below does
       the country switch. */
    if (regionChanged && HK_PATH && (isTargetHk ? !fsbOnHk() : fsbOnHk())) {
      if (applyBtn){ applyBtn.textContent = 'Switching market…'; }
      /* FIX: if a language was also picked, apply it after landing in the new market */
      try { if (langChanged) sessionStorage.setItem('fsb_pending_lang_' + sid, pendingLang); } catch(e){}
      fsbGoMarket(fsbMarketTargetUrl(isTargetHk));
      return;
    }

    if (!regionChanged && !langChanged) {
      /* nothing to switch on the storefront - but if the stored region still
         disagrees with the market the visitor is on, bring the backend along */
      try {
        if ((isTargetHk ? 'HK' : 'INT') !== savedRegion) {   /* savedRegion was read before the write above */
          fsbPushRegionToBackend(isTargetHk ? 'HK' : 'International');
          syncProfileRegionDisplay(isTargetHk ? 'HK' : 'INT');
        }
      } catch(e){}
      if (applyBtn){ applyBtn.disabled = false; applyBtn.textContent = 'Apply Changes'; }
      fsbCustomerClose();
      return;
    }

    var normLang = normalizeLocaleCode(targetLang);
    var config = ALL_LANG_CONFIG[normLang];
    var lyId = pendingLyId || (config && config.lyId) || '';

    // Set Langify cookies
    setLangifyCookies(normLang, lyId);

    // Send backend REGION update ONLY (Backend language is NEVER updated from this drawer)
    if (regionChanged) fsbPushRegionToBackend(isTargetHk ? 'HK' : 'International');

    /* FIX: return_to is always a clean path - Shopify adds the locale folder itself */
    var destUrl = window.fsbCleanPath() + window.location.search + window.location.hash;

    // If region changed: submit Shopify native localization form
    if (regionChanged) {
      var locForm = document.getElementById('fsb-localization-form-' + sid);
      var countryInp = document.getElementById('fsb-country-input-' + sid);
      var localeInp = document.getElementById('fsb-locale-input-' + sid);
      var returnToInp = document.getElementById('fsb-return-to-' + sid);

      if (countryInp) countryInp.value = targetCountry;
      if (localeInp) localeInp.value = (config && config.code) ? config.code : targetLang;
      if (returnToInp) returnToInp.value = destUrl;

      if (locForm) {
        try {
          HTMLFormElement.prototype.submit.call(locForm);
          return;
        } catch(e) {
          try {
            locForm.submit();
            return;
          } catch(e2){}
        }
      }

      // Fallback reload / navigate
      if (langChanged) {
        triggerStorefrontLanguageSwitch(targetLang, lyId);
      } else {
        window.location.reload();
      }
      return;
    }

    // If only language changed
    if (langChanged) {
      triggerStorefrontLanguageSwitch(targetLang, lyId);
      return;
    }
  }

  (function resumePendingLanguageOnLoad(){
    try {
      var key = 'fsb_pending_lang_' + sid;
      var saved = sessionStorage.getItem(key);
      if (saved) {
