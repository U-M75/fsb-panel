<!-- Snippet: fsb-scripts (sidebar + BON Loyalty logic) — rendered by sections/floating-sidebar.liquid -->
<script>
(function(){
  var sid = '{{ section.id }}';
  var sectionRoot = document.getElementById('sid-' + sid);
  var overlay = document.getElementById('fsb-panel-overlay-' + sid);
  if (!sectionRoot || !overlay) return;
  function rememberMobileSidebarPadding(){
    if (!window.matchMedia || !window.matchMedia('(max-width: 767px)').matches) return;
    var sidebarContainer = sectionRoot.querySelector('.fsb-container');
    if (!sidebarContainer) return;
    var computed = window.getComputedStyle(sidebarContainer);
    sidebarContainer.style.setProperty('--fsb-mobile-pad-top', computed.paddingTop);
    sidebarContainer.style.setProperty('--fsb-mobile-pad-right', computed.paddingRight);
    sidebarContainer.style.setProperty('--fsb-mobile-pad-bottom', computed.paddingBottom);
    sidebarContainer.style.setProperty('--fsb-mobile-pad-left', computed.paddingLeft);
  }
  function rememberSidebarGeometry(){
    if (sectionRoot.classList.contains('fsb-region-panel-open')) return;
    var sidebarContainer = sectionRoot.querySelector('.fsb-container');
    if (!sidebarContainer) return;
    var computed = window.getComputedStyle(sidebarContainer);
    var width = sidebarContainer.getBoundingClientRect().width;
    if (!width) return;
    sidebarContainer.style.setProperty('--fsb-stable-sidebar-width', width + 'px');
    sidebarContainer.style.setProperty('--fsb-stable-sidebar-pad-top', computed.paddingTop);
    sidebarContainer.style.setProperty('--fsb-stable-sidebar-pad-right', computed.paddingRight);
    sidebarContainer.style.setProperty('--fsb-stable-sidebar-pad-bottom', computed.paddingBottom);
    sidebarContainer.style.setProperty('--fsb-stable-sidebar-pad-left', computed.paddingLeft);
  }
  function syncMobileOrderVisibility(){
    var isMobile = window.matchMedia && window.matchMedia('(max-width: 767px)').matches;
    sectionRoot.querySelectorAll('.mobile-order-item').forEach(function(item){
      var inlineOrder = item.style.getPropertyValue('--mobile-order').trim();
      var mobileOrder = parseFloat(inlineOrder);
      var shouldHide = isMobile && !isNaN(mobileOrder) && mobileOrder === 0;
      item.classList.toggle('fsb-mobile-order-hidden', shouldHide);
    });
  }
  function allPanels(){ return overlay.querySelectorAll('.fsb-side-panel'); }
  function getCartDrawer(){ return document.querySelector('.cart-drawer'); }
  function clearActiveIcons(){
    sectionRoot.querySelectorAll('[data-fsb-icon]').forEach(function(el){
      el.classList.remove('fsb-active');
    });
  }
  function setActiveIcon(name){
    clearActiveIcons();
    if (!name) return;
    var el = sectionRoot.querySelector('[data-fsb-icon="' + name + '"]');
    if (el) el.classList.add('fsb-active');
  }
  (function forceCartClosed(){
    var cd = getCartDrawer();
    if (cd) {
      cd.classList.remove('active');
      cd.style.removeProperty('transform');
    }
    document.body.classList.remove('fsb-panel-open');
    overlay.classList.remove('active');
    clearActiveIcons();
  })();
  window.requestAnimationFrame(function(){
    syncMobileOrderVisibility();
    rememberMobileSidebarPadding();
    rememberSidebarGeometry();
  });
  function isAnythingOpen(){
    var cartDrawer = getCartDrawer();
    if (cartDrawer && cartDrawer.classList.contains('active')) return true;
    var openPanelEl = overlay.querySelector('.fsb-side-panel.active');
    return !!openPanelEl;
  }
  function syncBodyState(){
    var cartDrawer = getCartDrawer();
    var cartOpen = cartDrawer && cartDrawer.classList.contains('active');
    var openPanelEl = overlay.querySelector('.fsb-side-panel.active');
    if (isAnythingOpen()) {
      document.body.classList.add('fsb-panel-open');
      overlay.classList.add('active');
    } else {
      document.body.classList.remove('fsb-panel-open');
      overlay.classList.remove('active');
    }
    if (cartOpen) {
      setActiveIcon('cart');
    } else if (openPanelEl) {
      setActiveIcon(openPanelEl.getAttribute('data-fsb-panel'));
    } else {
      clearActiveIcons();
    }
  }
  function closeCart(){
    var cartDrawer = getCartDrawer();
    if (cartDrawer) {
      cartDrawer.classList.remove('active');
      cartDrawer.style.removeProperty('transform');
      /* drop the inline z-boost we add on open, so the hidden drawer
         fully returns to the theme's own layering (no leftover strip) */
      cartDrawer.style.removeProperty('z-index');
    }
  }
  function openCart(){
    var cartDrawer = getCartDrawer();
    if (cartDrawer) {
      cartDrawer.style.removeProperty('transform');
      cartDrawer.classList.add('active');
      /* keep the cart drawer above the fsb bar stack (z 1006) so it stays
         fully clickable when the left bar is open behind it */
      cartDrawer.style.setProperty('z-index', '1007', 'important');
    }
  }
  /* ============================================================
     SIDEKICK-STYLE PERSISTENT LEFT BAR (v26)
     The bar is open by default and STAYS open across navigation,
     link clicks, coupon apply, cart opens and page loads. It closes
     ONLY when the customer explicitly closes it (X button / overlay
     backdrop click / Escape). The open panel is remembered per
     browser-tab session and re-opens by itself after every load,
     so the bar feels fixed while the right side changes freely.
     ============================================================ */
  var FSB_CLOSED_KEY = 'fsb_closed_by_user';
  var FSB_PANEL_KEY  = 'fsb_open_panel';
  /* v30 — DUAL STORAGE: some browsers (private/incognito windows, in-app
     browsers, some Android WebViews) WIPE sessionStorage on navigation,
     which silently killed the whole keep-open behavior there. Everything
     is written to BOTH sessionStorage and localStorage and read
     session-first with localStorage as the fallback. */
  function fsbSsSet(k,v){ try { sessionStorage.setItem(k,v); } catch(e){} }
  function fsbSsDel(k){ try { sessionStorage.removeItem(k); } catch(e){} }
  function fsbLsSet(k,v){ try { localStorage.setItem(k,v); } catch(e){} }
  function fsbLsDel(k){ try { localStorage.removeItem(k); } catch(e){} }
  function fsbGetState(k){
    var v = '';
    try { v = sessionStorage.getItem(k) || ''; } catch(e){}
    if (!v){ try { v = localStorage.getItem(k) || ''; } catch(e){} }
    return v;
  }
  function fsbMarkClosed(){ fsbSsSet(FSB_CLOSED_KEY,'true'); fsbLsSet(FSB_CLOSED_KEY,'true'); }
  function fsbClearClosed(){ fsbSsDel(FSB_CLOSED_KEY); fsbLsDel(FSB_CLOSED_KEY); }
  function fsbPersistOpenPanel(name){
    if (name){ fsbSsSet(FSB_PANEL_KEY,name); fsbLsSet(FSB_PANEL_KEY,name); }
    else { fsbSsDel(FSB_PANEL_KEY); fsbLsDel(FSB_PANEL_KEY); }
  }
  function fsbCurrentOpenPanelName(){
    var act = overlay ? overlay.querySelector('.fsb-side-panel.active') : null;
    return act ? String(act.getAttribute('data-fsb-panel') || '') : '';
  }
  /* visual close that KEEPS the bar's state so it re-opens by itself
     right after the upcoming page navigation */
  function fsbCloseKeepState(){
    var keep = fsbCurrentOpenPanelName() || 'account';
    closeAllPanels();
    fsbClearClosed();
    fsbPersistOpenPanel(keep);
  }
  /* the ONLY close that counts as "the customer closed it himself" */
  function fsbCustomerClose(){
    closeAllPanels();
    fsbMarkClosed();
  }
  /* BULLETPROOF keep-open: whatever unloads the page (ANY link, theme
     menu fallback anchors, forms, redirects) — snapshot whichever panel
     is open right now so the restore puts THAT panel back, never the
     membership default. If nothing is open, nothing is saved. */
  function fsbSnapshotKeep(){
    var n = fsbCurrentOpenPanelName();
    if (n) fsbPersistOpenPanel(n);
  }
  window.addEventListener('beforeunload', fsbSnapshotKeep);
  window.addEventListener('pagehide', fsbSnapshotKeep);
  function closeAllPanels(){
    fsbPersistOpenPanel('');
    sectionRoot.classList.remove('fsb-region-panel-open');
    overlay.classList.remove('fsb-address-pair-open');
    overlay.classList.remove('fsb-address-edit-pair-open');
    overlay.classList.remove('fsb-od-pair-open');
    allPanels().forEach(function(p){ p.classList.remove('active'); });
    closeCart();
    resetThemeMenu();
    syncBodyState();
  }
  function openPanel(name){
    if (name === 'menu') ensureThemeMenu();
    if (name === 'region') {
      rememberSidebarGeometry();
      sectionRoot.classList.add('fsb-region-panel-open');
    } else {
      sectionRoot.classList.remove('fsb-region-panel-open');
    }
    overlay.classList.remove('fsb-address-pair-open');
    overlay.classList.remove('fsb-address-edit-pair-open');
    overlay.classList.remove('fsb-od-pair-open');
    closeCart();
    allPanels().forEach(function(p){ p.classList.remove('active'); });
    var target = overlay.querySelector('.fsb-side-panel[data-fsb-panel="' + name + '"]');
    if (target) {
      target.classList.add('active');
      fsbPersistOpenPanel(name);
      fsbClearClosed();
      syncBodyState();
      if (name === 'region') initRegionPanel();
      if (name === 'notifications') initNotificationsPanel();
      if (name === 'points' || name === 'rewards') initLoyaltyPanel(name);
    }
  }
  /* ============================================================
     THEME MOBILE MENU (same as the header hamburger menu)
     ============================================================ */
  var useThemeMenu = ({{ section.settings.use_theme_mobile_menu | default: true | json }}) !== false;
  var themeMenuInstalled = false;

  /* Theme menu shows ONLY on mobile; desktop keeps the old fallback menu. */
  function isMobileViewport(){
    return window.matchMedia && window.matchMedia('(max-width: 767px)').matches;
  }

  function syncThemeMenuForViewport(){
    if (!useThemeMenu) return;
    var menuPanel = document.getElementById('fsb-panel-menu-' + sid);
    if (!menuPanel) return;
    if (isMobileViewport()) {
      if (!themeMenuInstalled) installThemeMenu();
      if (themeMenuInstalled) menuPanel.classList.add('fsb-theme-menu-active');
    } else {
      menuPanel.classList.remove('fsb-theme-menu-active');
      resetThemeMenu();
    }
  }

  function resetThemeMenu(){
    if (!themeMenuInstalled) return;
    var clone = document.getElementById('fsb-mobile-menu-' + sid);
    if (!clone) return;
    /* same as the header drawer close: collapse top-level sub-menus */
    clone.querySelectorAll('.mobile-menu > li > .link-container[open]').forEach(function(d){
      d.classList.remove('menu-opening', 'submenu-open');
      d.removeAttribute('open');
    });
  }

  function installThemeMenu(){
    if (themeMenuInstalled) return true;
    /* Do not install on desktop — the fallback menu is used there */
    if (!isMobileViewport()) return false;
    var sourceNav = document.getElementById('mobile-menu');
    var slot = document.getElementById('fsb-theme-menu-slot-' + sid);
    var menuPanel = document.getElementById('fsb-panel-menu-' + sid);
    if (!sourceNav || !slot || !menuPanel) {
      if (!sourceNav) console.warn('[FSB] Header #mobile-menu not found — fallback menu is active.');
      return false;
    }

    var clone = sourceNav.cloneNode(true);
    clone.id = 'fsb-mobile-menu-' + sid;
    clone.classList.add('fsb-mobile-menu-clone');

    /* start collapsed, exactly like the header drawer when closed */
    clone.querySelectorAll('.mobile-menu > li > .link-container[open]').forEach(function(d){
      d.classList.remove('menu-opening', 'submenu-open');
      d.removeAttribute('open');
    });

    slot.appendChild(clone);
    menuPanel.classList.add('fsb-theme-menu-active');
    themeMenuInstalled = true;
    console.log('[FSB] Theme mobile menu installed:', clone.querySelectorAll('.mobile-menu > li').length, 'top-level items.');

    /* mega-menu promo images use the theme lazy-load classes; make them
       load eagerly inside the panel (lazySizes never sees the clone) */
    function fsbAbsUrl(u){
      if (!u) return u;
      if (u.indexOf('//') === 0) return 'https:' + u;
      return u;
    }
    clone.querySelectorAll('img.lazyload').forEach(function(img){
      var src = img.getAttribute('data-src');
      var srcset = img.getAttribute('data-srcset');
      if (src) img.setAttribute('src', fsbAbsUrl(src));
      if (srcset) {
        img.setAttribute('srcset', srcset.split(',').map(function(p){
          return fsbAbsUrl(p.trim());
        }).join(', '));
      }
      img.removeAttribute('data-src');
      img.removeAttribute('data-srcset');
      img.classList.remove('lazyload');
      img.classList.add('lazyloaded');
    });
    /* ensure images load even when the header is hidden (lazy loading off) */
    clone.querySelectorAll('img').forEach(function(img){
      img.setAttribute('loading', 'eager');
    });

    /* summary behaviour mirrors theme header.js: slide sub-menu in */
    clone.querySelectorAll('summary').forEach(function(summary){
      summary.addEventListener('click', function(){
        var detailsElement = summary.parentNode;
        var parentMenuElement = detailsElement.closest('.link-container');
        var bodyEl = clone.closest('.fsb-panel-body');
        if (bodyEl) bodyEl.scrollTop = 0;
        setTimeout(function(){
          detailsElement.classList.add('menu-opening');
          if (parentMenuElement) parentMenuElement.classList.add('submenu-open');
        }, 100);
      });
    });

    /* back button closes the sub-menu (mirrors header.js closeAnimation) */
    clone.querySelectorAll('.parent-link-back--button').forEach(function(button){
      button.addEventListener('click', function(e){
        e.preventDefault();
        var detailsElement = button.closest('details');
        if (!detailsElement) return;
        detailsElement.classList.remove('menu-opening');
        setTimeout(function(){ detailsElement.removeAttribute('open'); }, 400);
      });
    });

    /* clicking a real link closes the panel, then navigates */
    clone.addEventListener('click', function(e){
      var a = e.target.closest('a[href]');
      if (!a || !clone.contains(a)) return;
      var href = a.getAttribute('href') || '';
      if (href === '#' || href.indexOf('javascript:') === 0) {
        e.preventDefault();
        return;
      }
      e.preventDefault();
      /* Sidekick: following a link from the bar must NOT close it — the
         same panel re-opens by itself once the page loads on the right. */
      fsbCloseKeepState();
      window.location.href = href;
    });

    return true;
  }

  function ensureThemeMenu(){
    if (!useThemeMenu || themeMenuInstalled) return;
    installThemeMenu();
  }

  if (useThemeMenu) {
    ensureThemeMenu();
    var themeMenuRetryTimer = setInterval(function(){
      if (themeMenuInstalled) { clearInterval(themeMenuRetryTimer); return; }
      if (installThemeMenu()) clearInterval(themeMenuRetryTimer);
    }, 1000);
    setTimeout(function(){ clearInterval(themeMenuRetryTimer); }, 20000);
    document.addEventListener('DOMContentLoaded', ensureThemeMenu);
    /* Extra safety: if the header menu appears in the DOM later (due to
       ordering/lazy rendering), install it immediately. */
    if (window.MutationObserver && !themeMenuInstalled) {
      var fsbMenuObserver = new MutationObserver(function(){
        if (!themeMenuInstalled && useThemeMenu) ensureThemeMenu();
      });
      fsbMenuObserver.observe(document.documentElement, { childList: true, subtree: true });
      setTimeout(function(){ fsbMenuObserver.disconnect(); }, 30000);
    }
  }

  function openAddressPair(){
    var addressPanel = document.getElementById('fsb-panel-address-' + sid);
    var addPanel = document.getElementById('fsb-panel-add-address-' + sid);
    if (!addressPanel || !addPanel) return;
    closeCart();
    allPanels().forEach(function(panel){
      var panelName = panel.getAttribute('data-fsb-panel');
      if (panelName !== 'address' && panelName !== 'add-address') {
        panel.classList.remove('active');
      }
    });
    addressPanel.classList.add('active');
    addPanel.classList.add('active');
    overlay.classList.remove('fsb-address-edit-pair-open');
    overlay.classList.remove('fsb-od-pair-open');
    overlay.classList.add('fsb-address-pair-open');
    syncBodyState();
    setActiveIcon('address');
  }
  function openAddressEdit(addressId){
    var addressPanel = document.getElementById('fsb-panel-address-' + sid);
    var editPanel = document.getElementById('fsb-panel-edit-address-' + sid + '-' + addressId);
    if (!addressPanel || !editPanel) return;
    closeCart();
    allPanels().forEach(function(panel){
      if (panel !== addressPanel && panel !== editPanel) {
        panel.classList.remove('active');
      }
    });
    addressPanel.classList.add('active');
    editPanel.classList.add('active');
    overlay.classList.remove('fsb-address-pair-open');
    overlay.classList.add('fsb-address-edit-pair-open');
    syncBodyState();
    setActiveIcon('address');
  }
  overlay.addEventListener('click', function(e){
    if (e.target === overlay) fsbCustomerClose();
  });
  overlay.addEventListener('click', function(e){
    var closeBtn = e.target.closest('[data-fsb-close]');
    if (closeBtn) {
      e.preventDefault();
      e.stopPropagation();
      fsbCustomerClose();
    }
  });
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape') fsbCustomerClose();
  });
  var cartWatchTarget = getCartDrawer();
  if (cartWatchTarget) {
    var cartObserver = new MutationObserver(function(){ syncBodyState(); });
    cartObserver.observe(cartWatchTarget, { attributes: true, attributeFilter: ['class'] });
  }
  setInterval(syncBodyState, 500);
  window.addEventListener('resize', function(){
    window.requestAnimationFrame(function(){
      if (!document.body.classList.contains('fsb-panel-open')) {
        syncMobileOrderVisibility();
        rememberMobileSidebarPadding();
        rememberSidebarGeometry();
      }
      /* mobile <-> desktop switch par theme/fallback menu sync */
      syncThemeMenuForViewport();
    });
  });
  var cartToggle = document.getElementById('cart-drawer-toggle-' + sid);
  if (cartToggle) {
    var newCartToggle = cartToggle.cloneNode(true);
    cartToggle.parentNode.replaceChild(newCartToggle, cartToggle);
    newCartToggle.addEventListener('click', function(e){
      e.preventDefault();
      e.stopPropagation();
      var cartDrawer = getCartDrawer();
      if (cartDrawer) {
        var isOpen = cartDrawer.classList.contains('active');
        if (isOpen) {
          closeCart();
        } else {
          /* ONE drawer at a time: any open fsb drawer slides away first,
             then the cart drawer takes over (never stacked on top). */
          closeAllPanels();
          openCart();
        }
        syncBodyState();
      }
    });
  }
  function ensureCartCloseButton(){
    var cartDrawer = getCartDrawer();
    if (!cartDrawer || cartDrawer.querySelector('.fsb-cart-close-btn')) return;
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'fsb-cart-close-btn';
    btn.setAttribute('aria-label', 'Close cart');
    btn.innerHTML = '<svg class="fsb-close-icon-desktop" width="16" height="16" viewBox="0 0 20 20" fill="none"><path d="M15 5L5 15M5 5L15 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>' +
      '<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="21" height="13" viewBox="0 0 21 13" focusable="false" role="presentation" data-garden-id="buttons.icon" data-garden-version="8.76.9" class="StyledIcon-sc-19meqgg-0 cxMMcO fsb-close-icon-mobile"><path fill-rule="evenodd" clip-rule="evenodd" fill="currentColor" d="M20.1005 2.7169L10.9931 11.8244C10.4724 12.3451 9.62815 12.3451 9.10745 11.8244L-8.00829e-06 2.7169L1.88561 0.831278L10.0503 8.99593L18.2149 0.831278L20.1005 2.7169Z"/></svg>';
    btn.addEventListener('click', function(e){
      e.preventDefault();
      e.stopPropagation();
      closeCart();
      syncBodyState();
    });
    cartDrawer.insertBefore(btn, cartDrawer.firstChild);
  }
  ensureCartCloseButton();
  var cartBtnRetry = setInterval(function(){
    ensureCartCloseButton();
    if (getCartDrawer()) clearInterval(cartBtnRetry);
  }, 500);
  var cartCountBadge = document.getElementById('fsb-cart-count-' + sid);
  function updateCartCount(){
    fetch('/cart.js', { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
      .then(function(response){ return response.json(); })
      .then(function(cart){
        if (cartCountBadge) {
          var count = cart.item_count || 0;
          cartCountBadge.textContent = count > 99 ? '99+' : count;
        }
      })
      .catch(function(){});
  }
  document.addEventListener('DOMContentLoaded', updateCartCount);
  document.addEventListener('cart:update', updateCartCount);
  document.addEventListener('cart:updated', updateCartCount);
  document.addEventListener('cart:added', updateCartCount);
  document.addEventListener('cart:change', updateCartCount);
  document.addEventListener('cart:refresh', updateCartCount);
  document.addEventListener('cart:reload', updateCartCount);
  document.body.addEventListener('submit', function(e){
    var form = e.target;
    if (form && form.action && form.action.indexOf('/cart/add') !== -1) {
      setTimeout(updateCartCount, 600);
    }
  });
  if (window.fetch && !window.__fsbFetchPatched) {
    window.__fsbFetchPatched = true;
    var originalFetch = window.fetch;
    window.fetch = function(){
      var args = arguments;
      var urlArg = args[0];
      var url = (typeof urlArg === 'string') ? urlArg : (urlArg && urlArg.url) || '';
      var isCartMutation = /\/cart\/(add|change|update|clear)(\.js)?(\?|$)/.test(url);
      var result = originalFetch.apply(this, args);
      if (isCartMutation) {
        result.then(function(res){ setTimeout(updateCartCount, 400); return res; }).catch(function(){});
      }
      return result;
    };
  }
  var ordersTrigger = document.getElementById('orders-panel-trigger-' + sid);
  if (ordersTrigger) {
    var newOrdersTrigger = ordersTrigger.cloneNode(true);
    ordersTrigger.parentNode.replaceChild(newOrdersTrigger, ordersTrigger);
    newOrdersTrigger.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation(); openPanel('orders');
    });
  }
  var addressTrigger = document.getElementById('address-panel-trigger-' + sid);
  if (addressTrigger) {
    var newAddressTrigger = addressTrigger.cloneNode(true);
    addressTrigger.parentNode.replaceChild(newAddressTrigger, addressTrigger);
    newAddressTrigger.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation(); openPanel('address');
    });
  }
  var addAddressBtn = document.getElementById('fsb-add-address-btn-' + sid);
  if (addAddressBtn) {
    var newAddBtn = addAddressBtn.cloneNode(true);
    addAddressBtn.parentNode.replaceChild(newAddBtn, addAddressBtn);
    newAddBtn.addEventListener('click', function(e){
      e.preventDefault();
      e.stopPropagation();
      openAddressPair();
    });
  }
  overlay.addEventListener('click', function(e){
    var editBtn = e.target.closest('[data-fsb-edit-address]');
    if (!editBtn) return;
    e.preventDefault();
    e.stopPropagation();
    var addressId = editBtn.getAttribute('data-address-id');
    if (addressId) openAddressEdit(addressId);
  });
  overlay.addEventListener('click', function(e){
    var backBtn = e.target.closest('[data-fsb-edit-back]');
    if (!backBtn) return;
    e.preventDefault();
    e.stopPropagation();
    var editPanel = backBtn.closest('.fsb-panel-edit-address');
    var addressPanel = document.getElementById('fsb-panel-address-' + sid);
    if (editPanel) editPanel.classList.remove('active');
    if (addressPanel) addressPanel.classList.add('active');
    overlay.classList.remove('fsb-address-edit-pair-open');
    overlay.classList.remove('fsb-od-pair-open');
    syncBodyState();
    setActiveIcon('address');
  });
  var addressBackBtn = document.getElementById('fsb-address-back-' + sid);
  if (addressBackBtn) {
    addressBackBtn.addEventListener('click', function(e){
      e.preventDefault();
      e.stopPropagation();
      var addressPanel = document.getElementById('fsb-panel-address-' + sid);
      var addPanel = document.getElementById('fsb-panel-add-address-' + sid);
      if (addPanel) addPanel.classList.remove('active');
      if (addressPanel) addressPanel.classList.add('active');
      overlay.classList.remove('fsb-address-pair-open');
      overlay.classList.remove('fsb-address-edit-pair-open');
      overlay.classList.remove('fsb-od-pair-open');
      syncBodyState();
    });
  }
  var regionTrigger = document.getElementById('flag-popup-trigger-' + sid);
  if (regionTrigger) {
    var newRegionTrigger = regionTrigger.cloneNode(true);
    regionTrigger.parentNode.replaceChild(newRegionTrigger, regionTrigger);
    newRegionTrigger.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation(); openPanel('region');
    });
  }
  overlay.addEventListener('click', function(e){
    var applyBtn = e.target.closest('[data-fsb-apply-code]');
    if (applyBtn && !applyBtn.disabled) {
      e.preventDefault();
      e.stopPropagation();
      var code = applyBtn.getAttribute('data-fsb-apply-code');
      if (code) {
        bonApplyDiscountCode(code, applyBtn);
      } else {
        window.location.href = BON_LY || String(bonSeed.accountUrl || '/account');
      }
      return;
    }
