        if (!hkPfx && chosen !== current){
          if (countryInp) countryInp.value = chosen;
          var rt2 = form && form.querySelector('[name="return_to"]');
          if (rt2) rt2.value = window.fsbCleanPath() + window.location.search;   /* FIX: clean path */
          close();
          if (form && typeof form.submit === 'function') form.submit();   /* Shopify /localization */
          return;
        }
        close();                                        /* already on the International market */
        return;
      }
      /* Hong Kong = the market's own subfolder (Chinese visitors get the Chinese one) */
      var hkPath2 = String((form && form.getAttribute('data-hk-path')) || '').replace(/\/+$/, '');
      var hkPathZh2 = String((form && form.getAttribute('data-hk-path-zh')) || '').replace(/\/+$/, '');
      if (hkPath2) hkPath2 = window.fsbHkRoot();   /* FIX v2: keep current language */
      if (hkPath2){
        if (window.fsbIsHk()){
          close(); return;                              /* already in the Hong Kong market */
        }
        var hkUrl = window.location.origin + hkPath2 + window.fsbSwapHkHandle(window.fsbCleanPath(), true) + window.location.search;   /* FIX v3 */
        if (window.__fsbNavStub) { window.__fsbNavStub(hkUrl); } else { window.location.href = hkUrl; }
        return;
      }
      if (current === 'HK'){ close(); return; }         /* already Hong Kong: nothing to switch */
      if (countryInp) countryInp.value = 'HK';
      var rt = form && form.querySelector('[name="return_to"]');
      if (rt) rt.value = window.fsbCleanPath() + window.location.search;   /* FIX: clean path */
      close();
      if (form && typeof form.submit === 'function') form.submit();   /* Shopify /localization */
    });
  }
  /* v10.5: the geo check (end of this file) decides between the silent
     Hong Kong redirect and the popup. It opens the popup through
     __fsbGateShow; this fallback opens it if the geo lookup is absent. */
  window.__fsbGateShow = open;
  window.setTimeout(function(){
    if (!window.__fsbGateDecided && fresh()) open();
  }, 2600);
})();
</script>

<script>
  /* ============================================================
     v10.5 AUTO REGION (Shopify Markets + a one-time IP lookup):
     - Hong Kong visitor -> straight to the Hong Kong market, no
       popup on the way; after landing the region popup shows ONCE
       to confirm they are shopping in the Hong Kong region.
     - International visitor -> the region popup always shows so
       they can choose themselves.
     - A non-HK visitor sitting in the HK subfolder is returned to
       the main domain and the popup greets them there.
     The switch itself is Shopify Markets (the /en-hk subfolder),
     the same way the region popup always did it. The IP lookup
     runs only while no region was chosen yet.
     ============================================================ */
  (function(){
    var gate = document.querySelector('.fsb-region-gate');
    if (!gate) return;
    if (window.Shopify && window.Shopify.designMode) return;
    function lsGet(k){ try { return window.localStorage.getItem(k); } catch(e){ return null; } }
    var gateForm = gate.querySelector('[data-fsb-gate-form]');
    if (!gateForm){ window.__fsbGateDecided = true; return; }
    var hkPath   = String(gateForm.getAttribute('data-hk-path')   || '').replace(/\/+$/, '');
    var hkPathZh = String(gateForm.getAttribute('data-hk-path-zh') || '').replace(/\/+$/, '');
    var low = window.location.pathname.toLowerCase();
    function isUnder(path, pref){ var p = String(pref || '').toLowerCase(); return !!p && (path === p || path.indexOf(p + '/') === 0); }
    var onHk = window.fsbIsHk();   /* FIX v2: /ja-hk, /ko-hk, /zh-hans-hk ... are Hong Kong too */
    var saved = lsGet('fsb_selected_region');
    if (saved){
      window.__fsbGateDecided = true;
      /* Login takes place on account.nextcigar.com; its return link can land
         on the International root even when this browser chose Hong Kong.
         Restore the saved MARKET path without repeating the IP lookup. The
         same guard also respects an explicit International choice on HK URLs. */
      var mismatch = (saved === 'HK' && !onHk && !!hkPath) || (saved === 'INT' && onHk);
      if (mismatch){
        var rest = window.location.pathname;
        if (onHk){
          if (isUnder(low, hkPath)) rest = rest.slice(hkPath.length) || '/';
          else if (isUnder(low, hkPathZh)) rest = rest.slice(hkPathZh.length) || '/';
        }
        /* Avoid interfering with the external account / checkout handshake. */
        if (!/^\/(?:account|checkouts?)(?:\/|$)/i.test(rest)){
          var pref = (saved === 'HK') ? window.fsbHkRoot() : window.fsbIntRoot();   /* FIX v2: keep language */
          var dest = window.location.origin + pref + window.fsbSwapHkHandle(window.fsbCleanPath(rest), saved === 'HK') + window.location.search + window.location.hash;   /* FIX v3 */
          try {
            var key = 'fsb_region_restore_attempt';
            /* An unsuccessful redirect must never trap the customer in a loop. */
            if (window.sessionStorage.getItem(key) !== dest){
              window.sessionStorage.setItem(key, dest);
              if (window.__fsbNavStub) window.__fsbNavStub(dest);
              else window.location.href = dest;
              return;
            }
          } catch(e){}   /* no session storage: don't risk a redirect loop */
        }
      } else {
        try { window.sessionStorage.removeItem('fsb_region_restore_attempt'); } catch(e){}
      }
      /* The one-time HK confirmation belongs on the HK market, never on a
         temporary International landing page during the login handoff. */
      try {
        if (saved === 'HK' && onHk && window.localStorage.getItem('fsb_gate_show_once') === '1'){
          window.localStorage.removeItem('fsb_gate_show_once');
          if (typeof window.__fsbGateShow === 'function') window.setTimeout(window.__fsbGateShow, 500);
        } else if (saved !== 'HK'){
          window.localStorage.removeItem('fsb_gate_show_once');
        }
      } catch(e){}
      return;
    }
    var settled = false;
    function showGate(){ try { if (typeof window.__fsbGateShow === 'function') window.__fsbGateShow(); } catch(e){} }
    function finish(cc){
      if (settled) return;
      settled = true;
      window.__fsbGateDecided = true;
      if (!cc){ showGate(); return; }   /* geo failed: let the popup decide */
      var wantHk = (String(cc).toUpperCase() === 'HK');
      if (wantHk){
        /* HONG KONG: straight to the HK market - no popup on the way */
        try { if (typeof window.fsbSetRegion === 'function') window.fsbSetRegion('HK'); } catch(e){}
        try {
          window.localStorage.setItem('fsb_selected_region', 'HK');
          window.localStorage.setItem('fsb_region_gate_at', String(Date.now()));
        } catch(e){}
        if (onHk){
          /* already shopping in Hong Kong: confirm it with the popup once */
          setTimeout(showGate, 400);
          return;
        }
        if (!hkPath){ return; }
        /* show the confirmation popup once, after landing in HK */
        try { window.localStorage.setItem('fsb_gate_show_once', '1'); } catch(e){}
        var pref = window.fsbHkRoot();   /* FIX v2: keep language */
        var hkUrl = window.location.origin + pref + window.fsbSwapHkHandle(window.fsbCleanPath(), true) + window.location.search;   /* FIX v3 */
        try { if (window.__fsbNavStub) { window.__fsbNavStub(hkUrl); return; } } catch(e){}
        window.location.href = hkUrl;
        return;
      }
      /* INTERNATIONAL: never auto-decide - the popup always shows */
      try { window.sessionStorage.removeItem('fsb_region_gate_skip'); } catch(e){}
      if (onHk){
        /* misrouted: back to the main domain; the popup greets them there */
        var rest = window.location.pathname;
        if (isUnder(low, hkPath))        rest = window.location.pathname.slice(hkPath.length) || '/';
        else if (isUnder(low, hkPathZh)) rest = window.location.pathname.slice(hkPathZh.length) || '/';
        var intUrl = window.location.origin + window.fsbIntRoot() + window.fsbSwapHkHandle(window.fsbCleanPath(rest), false) + window.location.search;   /* FIX v3 */
        try { if (window.__fsbNavStub) { window.__fsbNavStub(intUrl); return; } } catch(e){}
        window.location.href = intUrl;
        return;
      }
      setTimeout(showGate, 200);
    }
    function jsonCountry(url, pick){
      return fetch(url, { cache: 'no-store' })
        .then(function(r){ return r.ok ? r.json() : null; })
        .then(function(d){ return d ? pick(d) : null; })
        .catch(function(){ return null; });
    }
    jsonCountry('https://get.geojs.io/v1/ip/country.json', function(d){ return d.country; })
      .then(function(cc){ return cc || jsonCountry('https://api.country.is/', function(d){ return d.country; }); })
      .then(finish);
    /* lookup hanging? decide nothing, let the popup open itself */
    setTimeout(function(){
      if (!settled){ settled = true; window.__fsbGateDecided = true; showGate(); }
    }, 2500);
  })();

  /* ============================================================
     v10 ADDRESS SAVE: saving an address inside the drawer must NOT
     navigate to the account addresses page. The form goes out with
     fetch, the drawer stays, the lists refresh in place and the
     drawer returns to the Address Book. On any error the form falls
     back to the normal submit with return_to = the same page.
     ============================================================ */
  (function(){
    function refreshLists(){
      return fetch(window.location.href, { credentials: 'same-origin' })
        .then(function(r){ return r.ok ? r.text() : null; })
        .then(function(html){
          if (!html) return false;
          var doc = new DOMParser().parseFromString(html, 'text/html');
          var sels = [
            '.fsb-side-panel[data-fsb-panel="address"] .fsb-panel-body',
            '.fsb-account-pane[data-account-pane="address"]'
          ];
          var swapped = false;
          for (var i = 0; i < sels.length; i++){
            var freshEl = doc.querySelector(sels[i]);
            var mine = document.querySelectorAll(sels[i]);
            if (freshEl && mine.length){
              for (var j = 0; j < mine.length; j++){ mine[j].innerHTML = freshEl.innerHTML; }
              swapped = true;
            }
          }
          return swapped;
        })
        .catch(function(){ return false; });
    }
    function backToAddressBook(panel){
      if (!panel) return;
      var back = panel.querySelector('.fsb-panel-back');
      if (back){ back.click(); return; }
      var closeBtn = panel.querySelector('[data-fsb-close]');
      if (closeBtn) closeBtn.click();
    }
    document.addEventListener('submit', function(e){
      var form = e.target;
      if (!form || !form.matches) return;
      if (!form.matches('.fsb-side-panel form[action*="/account/addresses"]')) return;
      var rt = form.querySelector('[data-fsb-return-to]');
      if (rt) rt.value = window.location.pathname + window.location.search;
      e.preventDefault();
      fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        credentials: 'same-origin',
        redirect: 'manual',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
      }).then(function(resp){
        if (resp.type === 'opaqueredirect' || resp.status === 0){
          return refreshLists().then(function(){
            backToAddressBook(form.closest('.fsb-side-panel'));
          });
        }
        /* error: normal submit, Shopify shows the error page (same page) */
        if (rt) rt.removeAttribute('name');
        HTMLFormElement.prototype.submit.call(form);
      }).catch(function(){
        if (rt) rt.removeAttribute('name');
        HTMLFormElement.prototype.submit.call(form);
      });
    }, true);
  })();

  /* v10.10: this snippet renders in the header, but Shopify puts the
     #Cart-Drawer markup near the end of <body>. Bind AFTER it exists, not
     only at header parse-time; otherwise fsb-cart-open never gets set and
     the theme's transparent page overlay steals wheel/touch scrolling after
     an AJAX add. This only mirrors the drawer's active class, NEVER reopens
     a drawer the customer closed. */
  (function(){
    var drawer = null;
    var body = document.body;
    var drawerObserver = null;
    var wasOpen = false;
    function syncClass(){
      var open = !!(drawer && drawer.isConnected && drawer.classList.contains('active'));
      body.classList.toggle('fsb-cart-open', open);
      /* Native/theme add, native close, cart icon and drawer switching are
         all tracked here; the first script owns storage and close semantics. */
      document.dispatchEvent(new CustomEvent('fsb:cart-state', {
        detail: { open: open, wasOpen: wasOpen }
      }));
      wasOpen = open;
    }
    function bindDrawer(){
      var found = document.getElementById('Cart-Drawer');
      if (!found) return;
      if (drawer !== found){
        if (drawerObserver) drawerObserver.disconnect();
        drawer = found;
        if (window.MutationObserver){
          drawerObserver = new MutationObserver(syncClass);
          drawerObserver.observe(drawer, { attributes: true, attributeFilter: ['class'] });
        }
      }
      syncClass();
    }
    if (document.readyState === 'loading'){
      document.addEventListener('DOMContentLoaded', bindDrawer, { once: true });
    }
    bindDrawer();
    document.addEventListener('cart-drawer:open', bindDrawer);
    document.addEventListener('cart:item-added', bindDrawer);
    document.addEventListener('shopify:section:load', bindDrawer);
    /* Another sidebar icon takes over the drawer. The Cart icon is excluded:
       its own handler must see an OPEN drawer so the first tap CLOSES it. */
    document.addEventListener('click', function(e){
      var current = document.getElementById('Cart-Drawer');
      if (!current || !current.classList.contains('active')) return;
      var icon = e.target && e.target.closest ? e.target.closest('[data-fsb-icon]') : null;
      if (!icon || icon.getAttribute('data-fsb-icon') === 'cart') return;
      current.classList.remove('active');
      body.classList.remove('open-cc');
    }, true);
  })();
</script>
