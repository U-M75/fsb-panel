                name="address[province]"
                data-default="{{ form.province }}"
                autocomplete="address-level1"
                class="full"
              >
              </select>
              <label for="fsb-edit-address-province-{{ section.id }}-{{ address.id }}">{{ 'customer.addresses.province' | t }}</label>
              <div class="select-arrow">{%- render 'svg-icons' with 'thb-select' -%}</div>
            </div>
            <div class="field">
              <input type="text" id="fsb-edit-address-zip-{{ section.id }}-{{ address.id }}" name="address[zip]" value="{{ form.zip }}" autocapitalize="characters" autocomplete="postal-code" placeholder="{{ 'customer.addresses.zip' | t }}" class="full">
              <label for="fsb-edit-address-zip-{{ section.id }}-{{ address.id }}">{{ 'customer.addresses.zip' | t }}</label>
            </div>
            <div class="field">
              <input type="tel" id="fsb-edit-address-phone-{{ section.id }}-{{ address.id }}" name="address[phone]" value="{{ form.phone }}" autocomplete="tel" placeholder="{{ 'customer.addresses.phone' | t }}" class="full">
              <label for="fsb-edit-address-phone-{{ section.id }}-{{ address.id }}">{{ 'customer.addresses.phone' | t }}</label>
            </div>
            <div class="checkbox-wrapper">
              {{ form.set_as_default_checkbox }}
              <label for="address_default_address_{{ form.id }}">{{ 'customer.addresses.set_default' | t }}</label>
            </div>
            <div class="field">
              <button class="button full"><span>{{ 'customer.addresses.update' | t }}</span></button>
            </div>
          {%- endform -%}
        </div>
      </div>
    {% endfor %}
  {% endif %}
</div>
