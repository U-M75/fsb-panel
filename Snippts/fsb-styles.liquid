   ====================================================================== */

/* --- Change 14: Membership/account icon gets the SAME gold active state
   as every other icon when its drawer is open --- */
#sid-{{ section.id }} .fsb-logo.fsb-account-icon.fsb-active{
  color: {{ section.settings.active_icon_color }};
