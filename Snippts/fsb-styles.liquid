.fsb-ly-td-date,
.fsb-ly-td-exp{color:#55534f!important;font-size:11.5px!important;white-space:nowrap}

/* History filter tabs (ALL / EARNED / REDEEMED / EXPIRED) — underlined style */
.fsb-history-tabs{display:flex!important;justify-content: space-between;grid-template-columns:none!important;gap:26px;border-bottom:1px solid #e3e1dd!important;margin:0 0 14px}
.fsb-history-tabs button{border:0;background:transparent!important;padding:0 0 10px!important;font-size:10px!important;font-weight:700;letter-spacing:.1em;color:#3f4145;cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px}
.fsb-history-tabs button.is-active{color:#c79a3c;border-bottom:2px solid #c79a3c}

/* Rewards — coupon cards (AVAILABLE / USED / EXPIRED), 2-column grid. */
.fsb-rw-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.fsb-rw-card{display:flex;flex-direction:column;overflow:hidden;border:1px solid #eceae6;border-radius:14px;background:#fff;transition:border-color .18s ease, box-shadow .18s ease}
.fsb-rw-card:hover{border-color:#d2a23c;box-shadow:0 3px 10px rgba(199,146,39,.10)}
.fsb-rw-head{box-sizing:border-box;min-height:104px;padding:24px 16px 20px;background:#d9ab5c}
.fsb-rw-value{font-family:Georgia,"Times New Roman",serif;font-size:29px;line-height:1;color:#fff;letter-spacing:.01em}
.fsb-rw-note{margin-top:9px;font-size:10.5px;line-height:1.45;color:rgba(255,255,255,.78)}
.fsb-rw-body{display:flex;flex:1;flex-direction:column;padding:13px 14px 12px}
.fsb-rw-row{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}
.fsb-rw-name{font-size:13px;font-weight:700;color:#2a2826;line-height:1.3;word-break:break-word}
.fsb-rw-exp{margin-top:4px;font-size:11px;color:#96948f}
.fsb-rw-dl{align-self:center;border:0;background:transparent;padding:2px;cursor:pointer;color:#c79a3c;flex:0 0 auto}
.fsb-rw-dl svg{display:block;width:17px;height:17px}
.fsb-rw-dl[disabled]{color:#c9c7c3;cursor:default}
.fsb-rw-terms{display:flex;align-items:center;justify-content:space-between;width:100%;margin-top:auto;padding:12px 0 0;border:0;background:transparent;cursor:pointer;font-family:inherit;font-size:9px;font-weight:700;letter-spacing:.18em;color:#a5a3a0}
.fsb-rw-terms svg{width:12px;height:12px;transition:transform .18s ease}
.fsb-rw-terms-body{display:none;margin-top:8px;font-size:10.5px;line-height:1.55;color:#8a8782}
.fsb-rw-card.is-open .fsb-rw-terms-body{display:block}
.fsb-rw-card.is-open .fsb-rw-terms svg{transform:rotate(180deg)}
/* used / expired cards read as one flat grey card (Available tab keeps the gold head) */
.fsb-rw-card.is-inactive{opacity:.62;filter:grayscale(1)}
.fsb-rw-card.is-inactive .fsb-rw-head{background:#d6d3cd}
.fsb-rw-card.is-inactive .fsb-rw-body{background:#efedea}
.fsb-rw-card.is-inactive .fsb-rw-value{color:#a9a6a0}
.fsb-rw-card.is-inactive .fsb-rw-note{color:#a9a6a0}
.fsb-rw-card.is-inactive .fsb-rw-name{color:#a09d98}
.fsb-rw-card.is-inactive .fsb-rw-exp{color:#b7b4af}
.fsb-rw-card.is-inactive .fsb-rw-terms{color:#b7b4af}
.fsb-rw-redeem{align-self:center;border:0;background:transparent;cursor:pointer;color:#c79a3c;font-size:10px;font-weight:800;letter-spacing:.06em;padding:2px 0;font-family:inherit}
.fsb-rw-redeem[disabled]{color:#b9b6b1;cursor:default}

/* Membership drawer summary with the new tier card */
.fsb-account-summary{align-items:center}
.fsb-account-summary .fsb-tier-card{flex:1 1 auto;max-width:60%}
.fsb-account-summary .fsb-account-points{justify-content:center}
.fsb-account-summary .fsb-account-points strong{font-size:34px!important}
.fsb-account-summary .fsb-account-points span{color:#c79a3c;font-size:11px}
@media only screen and (max-width:767px){
  .fsb-account-summary{flex-direction:column;align-items:stretch!important}
  .fsb-account-summary .fsb-tier-card{max-width:100%}
  .fsb-rw-head{min-height:96px;padding:20px 14px 16px}
  .fsb-rw-value{font-size:25px}
}

/* ============================================================
   REFERENCE REDESIGN — tier artwork card, thin gold bar and the
   grey-tile coupon cards. Appended LAST so these rules win.
   ============================================================ */
.fsb-tier-art{position:relative;overflow:hidden;width:100%;aspect-ratio:21/10;min-height:118px;background:#f4f1ea;box-sizing:border-box;margin-bottom:12px}
.fsb-tier-art-fallback{position:absolute;inset:0;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:1px;padding:16px 20px}
.fsb-tier-art-fallback svg{width:20px;height:20px;color:#c79a3c;position:absolute;top:14px;left:16px}
.fsb-tier-art-name{font:italic 400 38px/1 Georgia,'Times New Roman',serif;color:#3a3733}
.fsb-tier-art-sub{font-size:10px;letter-spacing:.32em;text-transform:uppercase;color:#8f8b83;margin-top:5px;padding-left:2px}
.fsb-tier-art-img{position:absolute;inset:0;width:100%;height:100%;display:block;background:#ece7db;}
.fsb-ly-pts-exp{font-size:11.5px;color:#a7a49e;margin-top:3px}
.fsb-ly-bar{height:3px;background:#eee9df;border-radius:99px;margin-top:12px;overflow:hidden}
.fsb-ly-bar-row{display:none}
.fsb-retain{margin-top:10px}
.fsb-rw-card{border:0;border-radius:12px;background:#f7f4ee;box-shadow:0 1px 4px rgba(28,24,18,.06)}
.fsb-rw-card:hover{border-color:transparent;box-shadow:0 3px 10px rgba(28,24,18,.10)}
.fsb-rw-head{min-height:118px;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;padding:16px 18px}
.fsb-rw-value{font:400 32px/1.05 Georgia,'Times New Roman',serif;color:#fff;letter-spacing:.01em}
.fsb-rw-note{margin-top:8px;font:400 12px/1.4 Georgia,'Times New Roman',serif;color:rgba(255,255,255,.85)}
.fsb-rw-body{padding:12px 14px 10px}
.fsb-rw-name{font-size:13.5px;font-weight:700;color:#2c2a26}
.fsb-rw-exp{color:#a19e98}
.fsb-rw-terms{margin-top:10px;border-top:1px solid rgba(28,24,18,.07);padding-top:10px;letter-spacing:.05em;font-size:10px;color:#8f8c87;display:flex;justify-content:space-between;align-items:center;width:100%;background:none;cursor:pointer}
.fsb-rw-terms-body{font-size:11px;color:#7d7a76;padding:8px 2px 4px;line-height:1.55;display:none}
.fsb-rw-card.is-open .fsb-rw-terms-body{display:block}
.fsb-rw-card.is-open .fsb-rw-terms svg{transform:rotate(180deg)}
.fsb-rw-dl{background:transparent;border:0;cursor:pointer;color:#c79a3c;width:34px;height:34px;display:inline-flex;align-items:center;justify-content:center;border-radius:50%}
