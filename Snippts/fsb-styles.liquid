  }
  #fsb-panel-overlay-{{ section.id }}.fsb-address-pair-open #fsb-panel-address-{{ section.id }}.active {
    z-index: 1002 !important;
  }
}
@media only screen and (max-width: 767px) {
  /* Keep the bottom sidebar's initial left/right padding unchanged while
     ANY drawer is open, including Region & Language. JavaScript stores the
     exact normal values at page load in these four custom properties. */
  #sid-{{ section.id }} .fsb-container,
  body.fsb-panel-open #sid-{{ section.id }} .fsb-container {
    left: 16px !important;
    right: 16px !important;
    width: calc(100vw - 32px) !important;
    min-width: calc(100vw - 32px) !important;
    max-width: calc(100vw - 32px) !important;
    height: 70px !important;
    min-height: 70px !important;
    padding:
      var(--fsb-mobile-pad-top, 0px)
      var(--fsb-mobile-pad-right, 22px)
      var(--fsb-mobile-pad-bottom, 0px)
      var(--fsb-mobile-pad-left, 22px) !important;
    box-sizing: border-box !important;
    transform: none !important;
  }
  #sid-{{ section.id }} .fsb-container > *,
  #sid-{{ section.id }} .mobile-order-item,
  #sid-{{ section.id }} .thb-secondary-area-item {
    flex-shrink: 0 !important;
    box-sizing: border-box;
  }
  /* Region/Language is now a normal .fsb-item too, so it has exactly the
     same mobile icon space and active-state padding as every other icon. */
  #sid-{{ section.id }} .thb-secondary-flag.fsb-item,
  #sid-{{ section.id }} .thb-secondary-flag.fsb-item.fsb-active {
    padding: 4px 6px !important;
    box-sizing: border-box !important;
  }
  /* All custom side panels and the injected cart drawer button use the
     supplied 21 × 13 down-chevron as their mobile close button. */
  .fsb-panel-close .fsb-close-icon-desktop,
  .fsb-cart-close-btn .fsb-close-icon-desktop {
    display: none !important;
  }
  .fsb-panel-close .fsb-close-icon-mobile,
  .fsb-cart-close-btn .fsb-close-icon-mobile {
    display: block !important;
    width: 21px !important;
    height: 10px !important;
    min-width: 21px;
    color: currentColor;
  }
  .fsb-panel-close,
  .fsb-cart-close-btn {
    width:fit-content;
    min-width: 37px;
    min-height: 34px;
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
  }
  /* Both panels remain active on mobile; the Add Address sheet is visibly
     on top because two full-width bottom sheets cannot sit side-by-side. */
  #fsb-panel-overlay-{{ section.id }}.fsb-address-pair-open #fsb-panel-address-{{ section.id }}.active {
    z-index: 1002;
  }
  #fsb-panel-overlay-{{ section.id }}.fsb-address-pair-open #fsb-panel-add-address-{{ section.id }}.active {
    z-index: 1003;
  }
}
/* ========================================================================
   DRIVE SVG ICONS + EQUAL MOBILE ICON / LABEL ALIGNMENT
   ======================================================================== */
/* All supplied icons use the section's normal/hover/active colour. */
#sid-{{ section.id }} .fsb-drive-icon {
  display: block;
  color: currentColor;
}
#sid-{{ section.id }} .fsb-drive-icon .cls-1 {
  fill: currentColor !important;
}
/* Home intentionally contains the original white cigar body plus dark art. */
#sid-{{ section.id }} .fsb-drive-icon-home .cls-1 {
  fill: #fff !important;
}
#sid-{{ section.id }} .fsb-drive-icon-home .cls-2 {
  fill: currentColor !important;
}
/* N+ follows the existing logo text colour so it remains visible against the
   configured logo background. */
#sid-{{ section.id }} .fsb-logo > .fsb-drive-icon {
  width: 65%;
  height: 65%;
}
@media only screen and (max-width: 767px) {
  /* All visible sidebar entries share an equal flex column. */
  #sid-{{ section.id }} .mobile-order-item {
    flex: 1 1 0 !important;
    min-width: 0 !important;
    align-items: center;
    justify-content: flex-start;
    text-align: center;
  }
  #sid-{{ section.id }} .fsb-logo-wrap > .mobile-order-item,
  #sid-{{ section.id }} .account-mbl {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 3px !important;
  }
  /* Every Drive SVG renders within the same 32px square icon canvas. */
  #sid-{{ section.id }} .fsb-item > .fsb-drive-icon,
  #sid-{{ section.id }} .thb-secondary-item-icon > .fsb-drive-icon,
  #sid-{{ section.id }} .fsb-logo > .fsb-drive-icon {
    width: 32px !important;
    height: 32px !important;
    min-width: 32px !important;
    min-height: 32px !important;
    max-width: 32px !important;
    max-height: 32px !important;
  }
  #sid-{{ section.id }} .thb-secondary-item-icon {
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  #sid-{{ section.id }} .fsb-logo {
    width: 32px !important;
    height: 32px !important;
    min-width: 32px;
    min-height: 32px;
  }
  /* Equal text baseline and centered labels for every mobile icon. */
  #sid-{{ section.id }} .mobile-icon-title {
    width: 100%;
    min-height: 14px;
    line-height: 14px;
    margin: 3px 0 0 !important;
    overflow: hidden;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
}
/* ========================================================================
   DESKTOP AND TABLET SIDEBAR - explicit width/padding
   ======================================================================== */
@media only screen and (min-width: 768px) {
  /* The supplied profile artwork has built-in whitespace. Show it at the
     correct visual size instead of the previous very small 65% canvas. */
  #sid-{{ section.id }} .fsb-logo > .fsb-drive-icon-profile {
    width: 100% !important;
    height: 100% !important;
    transform: scale(1.12);
  }
  /* N+ is a wide, low artwork inside a 150 × 150 viewBox, so it needs a
     slightly larger canvas to look equal to the rest of the sidebar icons. */
  #sid-{{ section.id }} .fsb-logo > .fsb-drive-icon-nplus {
    width: 100% !important;
    height: 100% !important;
    transform: scale(1.28);
  }
}
@media only screen and (max-width: 767px) {
  #sid-{{ section.id }} .fsb-logo > .fsb-drive-icon-profile {
    transform: scale(1.12);
  }
  #sid-{{ section.id }} .fsb-logo > .fsb-drive-icon-nplus {
    transform: scale(1.25);
  }
}
/* ========================================================================
   MOBILE ICON ROW — SAME VERTICAL ALIGNMENT + SMOOTH CHILD MENU MOTION
   ======================================================================== */
/* Keep child menus mounted (but invisible) so transforms can animate rather
   than jumping from display:none to display:block. */
.fsb-menu-sub {
  display: block !important;
  visibility: hidden;
  opacity: 0;
  pointer-events: none;
}
.fsb-menu-sub.active {
  visibility: visible;
  opacity: 1;
  pointer-events: auto;
}
@media only screen and (max-width: 767px) {
  /* Every bottom-navigation item uses the exact same 49px icon+label stack:
     32px icon canvas + 3px gap + 14px label. */
  #sid-{{ section.id }} .mobile-order-item,
  #sid-{{ section.id }} .fsb-logo-wrap > .mobile-order-item,
  #sid-{{ section.id }} .account-mbl {
    display: flex !important;
    flex: 1 1 0 !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: flex-start !important;
    min-width: 0 !important;
    height: 49px !important;
    min-height: 49px !important;
    max-height: 49px !important;
    gap: 0 !important;
    padding: 0 !important;
    box-sizing: border-box !important;
    text-align: center;
  }
  /* Cart, Region, standard icons and Account/N+ all start from the same
     top line. The active background no longer changes their size. */
  #sid-{{ section.id }} .fsb-item,
  #sid-{{ section.id }} .thb-secondary-area-item.fsb-item,
  #sid-{{ section.id }} .thb-secondary-flag.fsb-item,
  #sid-{{ section.id }} .thb-secondary-flag.fsb-item.fsb-active {
    padding: 0 !important;
    box-sizing: border-box !important;
  }
  #sid-{{ section.id }} .mobile-order-item > .fsb-drive-icon,
  #sid-{{ section.id }} .mobile-order-item > .thb-secondary-item-icon,
  #sid-{{ section.id }} .mobile-order-item > .fsb-logo {
    flex: 0 0 32px;
    width: 32px !important;
    height: 32px !important;
    min-width: 32px !important;
    min-height: 32px !important;
    margin: 0 !important;
    align-self: center;
  }
  #sid-{{ section.id }} .mobile-icon-title {
    display: block !important;
    flex: 0 0 14px;
    width: 100%;
    min-height: 14px;
    height: 14px;
    line-height: 14px;
    margin: 3px 0 0 !important;
    padding: 0 !important;
    overflow: hidden;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* Region's supplied artwork has extra white space inside its viewBox. A
     visual-only scale makes it match the other 32px icon canvases without
     affecting its alignment or the sidebar's dimensions. */
  #sid-{{ section.id }} .fsb-drive-icon-region {
    transform: scale(1.20);
  }
  /* Mobile child menu: the already-mounted panel now slides upward and fades
     in smoothly instead of appearing instantly. */
  .fsb-menu-sub {
    display: block !important;
    visibility: hidden;
    opacity: 0;
    transform: translateX(0) translateY(100%) !important;
    transition: transform 0.38s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.24s ease, visibility 0s linear 0.38s !important;
  }
  .fsb-menu-sub.active {
    visibility: visible;
    opacity: 1;
    transform: translateX(0) translateY(0) !important;
    transition: transform 0.38s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.24s ease, visibility 0s !important;
  }
}
/* Keep the original Theme Editor mobile visibility condition intact.
   Any item whose Mobile Order is set to 0 must stay hidden, even after the
   equal-alignment rules above set mobile items to display:flex. */
@media only screen and (max-width: 767px) {
  #sid-{{ section.id }} .mobile-order-item[style*="--mobile-order: 0"],
  #sid-{{ section.id }} .fsb-logo-wrap > .mobile-order-item[style*="--mobile-order: 0"],
  #sid-{{ section.id }} .account-mbl[style*="--mobile-order: 0"] {
    display: none !important;
  }
}
/* Final mobile-order visibility guard: JavaScript adds this class whenever a
   Theme Editor Mobile Order value is exactly 0. */
@media only screen and (max-width: 767px) {
  #sid-{{ section.id }} .fsb-mobile-order-hidden {
    display: none !important;
  }
}
/* ========================================================================
   MOBILE VISUAL ICON NORMALISATION — NO LAYOUT / ORDER CHANGES
   ======================================================================== */
@media only screen and (max-width: 767px) {
  /* All icon cells and label columns remain exactly as they are. These are
     visual-only scales to compensate for different built-in white space in
     the supplied SVG viewBoxes, so the empty gap around Chat → Cart →
     Membership looks equal. */
  #sid-{{ section.id }} .fsb-drive-icon {
    transform-origin: center center;
  }
  #sid-{{ section.id }} .fsb-drive-icon-support {
    transform: scale(1.05);
  }
  #sid-{{ section.id }} .fsb-drive-icon-cart {
    transform: scale(1.00);
  }
  #sid-{{ section.id }} .fsb-drive-icon-profile {
    transform: scale(1.12);
  }
  #sid-{{ section.id }} .fsb-drive-icon-region {
    transform: scale(1.20);
  }
  #sid-{{ section.id }} .fsb-drive-icon-menu {
    transform: scale(1.20);
  }
  #sid-{{ section.id }} .fsb-drive-icon-points,
  #sid-{{ section.id }} .fsb-drive-icon-rewards {
    transform: scale(1.14);
  }
  #sid-{{ section.id }} .fsb-drive-icon-orders {
    transform: scale(1.16);
  }
  #sid-{{ section.id }} .fsb-drive-icon-address {
    transform: scale(1.12);
  }
  #sid-{{ section.id }} .fsb-drive-icon-notifications {
    transform: scale(1.00);
  }
  #sid-{{ section.id }} .fsb-drive-icon-home {
    transform: scale(.90);
  }
  #sid-{{ section.id }} .fsb-drive-icon-nplus {
    transform: scale(1.25);
  }
}
/* Final mobile row micro-alignment: the Cart SVG has a lower visual centre
   than the other supplied icons. Move only its existing canvas up by 2px;
   no widths, orders, labels, gaps or visibility rules are changed. */
@media only screen and (max-width: 767px) {
  #sid-{{ section.id }} [data-fsb-icon="cart"] .thb-secondary-item-icon {
    transform: translateY(-2px);
  }
}
/* ========================================================================
   FINAL MOBILE BODY / WRAPPER RESET
   Fixes unwanted left/right page padding on mobile caused by desktop
   sidebar body padding rules using !important.
   ======================================================================== */
@media only screen and (max-width: 767px) {
  html,
  body {
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    width: 100% !important;
    max-width: 100% !important;
    overflow-x: hidden !important;
  }
  body:not(.fsb-panel-open) {
    padding-left: 0 !important;
    padding-right: 0 !important;
    padding-bottom: 95px !important;
  }
  body.fsb-panel-open {
    padding-left: 0 !important;
    padding-right: 0 !important;
    padding-bottom: 0 !important;
  }
  #wrapper,
  body.template-collection #wrapper,
  body.collection #wrapper {
    margin-left: 0 !important;
    margin-right: 0 !important;
    width: 100% !important;
    max-width: 100% !important;
  }
}
/* Icon 1 now uses N+ artwork. Unlike the old Home SVG, N+ should inherit the
   configured sidebar icon colour rather than Home's fixed white artwork. */
#sid-{{ section.id }} .fsb-drive-icon-nplus-home .cls-1 {
  fill: currentColor !important;
}
/* N+ has internal viewBox whitespace; these visual-only scales keep Icon 1
   consistent with the other supplied sidebar icons without changing layout. */
@media only screen and (min-width: 768px) {
  #sid-{{ section.id }} .fsb-drive-icon-nplus-home {
    transform: scale(1.25);
    transform-origin: center center;
  }
}
@media only screen and (max-width: 767px) {
  #sid-{{ section.id }} .fsb-drive-icon-nplus-home {
    transform: scale(1.25);
    transform-origin: center center;
  }
}

/* ========================================================================
   THEME MOBILE MENU INSIDE THE MENU PANEL
   The JS clones the header's #mobile-menu (same links, child links,
   mega-menu blocks/images, badges, messagebox, login/register and
   track-order links) into the menu panel. The theme's mobile-menu.css
   styles it (class-based, so it applies to the clone automatically).
   Only the drawer-level positioning is neutralised so it sits inside
   the panel instead of below the header.
   ======================================================================== */
.fsb-theme-menu-slot{
  display: none;
}
#fsb-panel-menu-{{ section.id }}.fsb-theme-menu-active .fsb-theme-menu-slot{
  display: block;
}
#fsb-panel-menu-{{ section.id }}.fsb-theme-menu-active .fsb-menu-fallback{
  display: none;
}
#fsb-panel-menu-{{ section.id }}.fsb-theme-menu-active .fsb-panel-body{
  padding: 0;
  overflow-x: hidden;
}
/* The FSB head "back" button is only needed for the fallback menu; the
   theme menu brings its own parent-link-back buttons. */
#fsb-panel-menu-{{ section.id }}.fsb-theme-menu-active .fsb-panel-back{
  display: none !important;
}
#fsb-panel-menu-{{ section.id }} .mobile-menu-drawer{
  position: static;
  top: auto;
  left: auto;
  width: 100%;
  height: 100%;
  max-height: none;
  border-top: none;
  opacity: 1 !important;
  visibility: visible !important;
  transform: none !important;
  overflow: visible;
}
#fsb-panel-menu-{{ section.id }} .mobile-menu-drawer--inner{
  min-height: 100%;
  height: 100%;
}
/* Keep the horizontal sub-menu slide contained inside the panel body */
#fsb-panel-menu-{{ section.id }} .fsb-panel-body{
  overflow-x: hidden;
}
/* The theme's mobile-menu.css uses content-box width:100% + padding,
   which overflows narrow panels. Inside the panel use border-box and
   keep the mobile (<=767px) padding values at every width, so the menu
   looks exactly like the header's mobile menu. */
#fsb-panel-menu-{{ section.id }} .mobile-menu,
#fsb-panel-menu-{{ section.id }} .mobile-menu .sub-menu{
  box-sizing: border-box;
}
@media only screen and (min-width: 768px){
  #fsb-panel-menu-{{ section.id }} .mobile-menu{
    padding: 0 1.5em;
  }
  #fsb-panel-menu-{{ section.id }} .mobile-menu .sub-menu{
    padding: 0 15px 50px;
  }
}
/* Mega-menu promo images: they use the theme's lazy-load classes; JS swaps
   data-src/data-srcset to real src so they always render inside the panel. */
#fsb-panel-menu-{{ section.id }} .mega-menu-promotion img{
  width: 100%;
  height: auto;
  display: block;
}
/* On the mobile bottom sheet make sure the drawer content is scrollable
   with the panel body (never its own fixed-height scrollbox). */
@media only screen and (max-width: 767px){
  #fsb-panel-menu-{{ section.id }} .mobile-menu-drawer{
    height: auto;
    min-height: 100%;
  }
  #fsb-panel-menu-{{ section.id }} .mobile-menu-drawer--inner{
    height: auto;
  }
}

/* ========================================================================
   OPTIONAL: HIDE THE THEME'S HEADER ON SCREEN
   The Header section must stay ENABLED in the theme editor — its DOM is
   what this sidebar clones for the menu panel. This rule only takes the
   header off the screen: no layout space, no visibility, no clicks. The
   header's mobile menu (#mobile-menu) stays in the DOM and is shown by
   the sidebar's Menu panel.
   ======================================================================== */
{% if section.settings.hide_theme_header %}
  .header-section{
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    width: 100% !important;
    transform: translateY(-110%) !important;
    visibility: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
    height: 0 !important;
    min-height: 0 !important;
    overflow: hidden !important;
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
    box-shadow: none !important;
  }
{% endif %}

/* ========================================================================
   BON LOYALTY - POINTS & REWARDS PANELS
   Fully dynamic UI. All values injected by JS from BON data sources.
   ======================================================================== */
#fsb-panel-points-{{ section.id }} .fsb-panel-body,
#fsb-panel-rewards-{{ section.id }} .fsb-panel-body{
  padding: 10px 14px 30px;
}
.fsb-ly{ display:flex; flex-direction:column; gap:16px; }
.fsb-ly *{ box-sizing:border-box; }

/* Gold membership card (fallback — the real Omni member card image is
   shown automatically when a membership card image is available) */
.fsb-ly-card{
  position:relative; border-radius:14px; padding:15px; min-height:163px;
  display:flex; flex-direction:column; justify-content:space-between; overflow:hidden;
  background:linear-gradient(135deg,#cfa441 0%,#c0973f 10%,#a67d2d 25%,#8e6722 43%,#a47c2f 55%,#c29941 70%,#d2a849 80%,#eabd54 100%);
}
.fsb-ly-card-top{ position:relative; z-index:1; display:flex; align-items:flex-start; justify-content:space-between; gap:10px; }
.fsb-ly-brand{ font-size:9px; letter-spacing:.16em; text-transform:uppercase; color:rgba(255,255,255,.86); font-weight:600; line-height:1.2; }
.fsb-ly-tier{ font-size:11.5px; letter-spacing:.005em; text-transform:uppercase; color:#fff; font-weight:800; margin-top:6px; line-height:1.2; }
.fsb-ly-badge{
  flex:0 0 auto; width:26px; height:26px; border-radius:50%;
  border:1px solid rgba(255,255,255,.52); display:flex; align-items:center; justify-content:center;
  background:transparent; margin-top:1px;
}
.fsb-ly-badge svg{ width:11px; height:11px; display:block; }
.fsb-ly-card-bot{ position:relative; z-index:1; }
.fsb-ly-name{ font-size:13px; font-weight:800; color:#fff; line-height:1.2; letter-spacing:.005em; }
.fsb-ly-since{ font-size:10.5px; color:rgba(255,255,255,.76); margin-top:4px; line-height:1.2; }

/* Dark points card */
.fsb-ly-pts{ background:#1c1b19; border-radius:14px; padding:15px; }
.fsb-ly-pts-label{ font-size:12px; letter-spacing:.09em; text-transform:uppercase; font-weight:600; color:#8e8a89; line-height:1.2; }
.fsb-ly-pts-value{
  font-family:Georgia,"Times New Roman",Times,serif; font-variant-numeric:oldstyle-nums;
  font-size:28px; line-height:1; font-weight:400; color:#fff; margin:14px 0 0; letter-spacing:.005em;
}
.fsb-ly-bar{ height:4px; border-radius:99px; background:#333230; overflow:hidden; margin-top:6px; }
.fsb-ly-bar-fill{ height:100%; border-radius:99px; background:linear-gradient(90deg,#c9a045,#eebf55); transition:width .45s ease; }
.fsb-ly-bar-row{ display:flex; align-items:baseline; justify-content:space-between; gap:10px; margin-top:5px; font-size:11px; line-height:1.2; }
.fsb-ly-bar-cur{ color:#8a8886; font-weight:400; }
.fsb-ly-bar-next{ color:#747270; }

/* Segmented tabs */
.fsb-ly-tabs{ display:grid; grid-template-columns:1fr 1fr; border:1px solid #e6e6e6; border-radius:10px; overflow:hidden; background:#fff; }
.fsb-ly-tab{
  appearance:none; -webkit-appearance:none; border:0; background:#fff; color:#111;
  font-size:14px; font-weight:600; padding:12px 8px; cursor:pointer; line-height:1;
  font-family:inherit; transition:background .18s ease, color .18s ease;
}
.fsb-ly-tab[aria-selected="true"]{ background:#111; color:#fff; font-weight:700; }

/* Reward list */
.fsb-ly-list{ display:flex; flex-direction:column; gap:10px; }
.fsb-ly-item{ display:flex; gap:12px; align-items:flex-start; border:1px solid #ededed; border-radius:12px; padding:12px; background:#fff; }
.fsb-ly-thumb{
  flex:0 0 auto; width:62px; height:62px; border-radius:10px; background:#f4f4f4;
  display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2px; text-align:center; padding:4px;
  overflow:hidden;
}
.fsb-ly-thumb img{ width:100%; height:100%; object-fit:cover; border-radius:10px; display:block; }
.fsb-ly-thumb-val{ font-size:15px; font-weight:800; color:#3d3d3d; line-height:1.1; }

/* Rewards card — compact coupon layout (used by both the Rewards drawer and
   the membership drawer's Rewards tab, matching the supplied reference). */
#fsb-panel-rewards-{{ section.id }} .fsb-ly-list,
.fsb-account-pane[data-account-pane="rewards"] .fsb-ly-list{ gap:10px; }
#fsb-panel-rewards-{{ section.id }} .fsb-ly-item,
.fsb-account-pane[data-account-pane="rewards"] .fsb-ly-item{
  min-height:102px; align-items:center; gap:15px; padding:14px;
  border:1px solid #e5e3df; border-radius:16px; background:#fff;
  transition:border-color .18s ease, box-shadow .18s ease;
}
#fsb-panel-rewards-{{ section.id }} .fsb-ly-item:hover,
.fsb-account-pane[data-account-pane="rewards"] .fsb-ly-item:hover{
