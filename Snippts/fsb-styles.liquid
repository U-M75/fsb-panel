<!-- Snippet: fsb-styles (all sidebar styles) — rendered by sections/floating-sidebar.liquid -->
<style>
/* ==========================================================
   DIRECTION / HIDE VARIABLE
   ========================================================== */
{% if section.settings.position == 'left' %}
:root{ --fsb-hide: -110%; }
{% else %}
:root{ --fsb-hide: 110%; }
{% endif %}
{% assign fsb_sidebar_span = section.settings.icon_size | plus: section.settings.horizontal_padding | plus: section.settings.horizontal_padding | plus: section.settings.edge_offset %}
:root{ --fsb-sidebar-span: {{ fsb_sidebar_span }}px; }
body.open-cc #wrapper .click-capture {
  opacity:0;
}
/* ============ CART DRAWER ============ */
.cart-drawer {
  position: fixed !important;
  top: 0 !important;
  width: var(--fsb-panel-width, 400px) !important;
  max-width: calc(100vw - 90px) !important;
  height: 100vh !important;
  z-index: 1002 !important;
  background: #fff !important;
  visibility: hidden !important;
  pointer-events: none !important;
  transform: translateX(var(--fsb-hide)) !important;
  transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), visibility 0.5s !important;
  will-change: transform, visibility !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  overflow: hidden !important;
  overflow-y: hidden !important;
  opacity: 1 !important;
}
.cart-drawer.active {
  visibility: visible !important;
  transform: translateX(0) !important;
  pointer-events: auto !important;
  overflow-y: auto !important;
}
.cart-drawer:not(.active) {
  visibility: hidden !important;
  pointer-events: none !important;
  overflow: hidden !important;
  overflow-y: hidden !important;
}
.cart-drawer:not(.active) * {
  overflow: hidden !important;
  pointer-events: none !important;
}
.cart-drawer .click-capture {
  display: none !important;
}
.cart-drawer .cart-drawer__close-button {
  display: none !important;
}
.cart-drawer .cart-drawer__inner {
  padding-top: 70px !important;
}
/* ============ BODY PADDING ============ */
{% if section.settings.position == 'left' %}
body:not(.fsb-panel-open) {
  padding-left: var(--fsb-sidebar-span) !important;
}
body.fsb-panel-open {
  padding-left: calc(var(--fsb-sidebar-span) + var(--fsb-panel-width, 400px)) !important;
}
{% else %}
body:not(.fsb-panel-open) {
  padding-right: var(--fsb-sidebar-span) !important;
}
body.fsb-panel-open {
  padding-right: calc(var(--fsb-sidebar-span) + var(--fsb-panel-width, 400px)) !important;
}
{% endif %}
/* ============ TABLET/MEDIUM SCREENS (768px - 990px) ============ */
/* On tablet, keep body padding SAME whether drawer is open or not -
   so website content/grid/flex don't reflow when drawer opens */
@media only screen and (min-width: 768px) and (max-width: 990px) {
  body:not(.fsb-panel-open),
  body.fsb-panel-open {
    {% if section.settings.position == 'left' %}
    padding-left: var(--fsb-sidebar-span);
    {% else %}
    padding-right: var(--fsb-sidebar-span);
    {% endif %}
  }
}
/* Collection page fallback: some collection templates use full-width wrappers
   that ignore body padding, so shift #wrapper itself on desktop/tablet. */
@media only screen and (min-width: 991px) {
  {% if section.settings.position == 'left' %}
  body.template-collection:not(.fsb-panel-open),
  body.collection:not(.fsb-panel-open),
  body.template-collection.fsb-panel-open,
  body.collection.fsb-panel-open {
    padding-left: 0 !important;
  }
  body.template-collection:not(.fsb-panel-open) #wrapper,
  body.collection:not(.fsb-panel-open) #wrapper {
    margin-left: var(--fsb-sidebar-span) !important;
    width: calc(100% - var(--fsb-sidebar-span)) !important;
  }
  body.template-collection.fsb-panel-open #wrapper,
  body.collection.fsb-panel-open #wrapper {
    margin-left: calc(var(--fsb-sidebar-span) + var(--fsb-panel-width, 400px)) !important;
    width: calc(100% - var(--fsb-sidebar-span) - var(--fsb-panel-width, 400px)) !important;
  }
  {% else %}
  body.template-collection:not(.fsb-panel-open),
  body.collection:not(.fsb-panel-open),
  body.template-collection.fsb-panel-open,
  body.collection.fsb-panel-open {
    padding-right: 0 !important;
  }
  body.template-collection:not(.fsb-panel-open) #wrapper,
  body.collection:not(.fsb-panel-open) #wrapper {
    margin-right: var(--fsb-sidebar-span) !important;
    width: calc(100% - var(--fsb-sidebar-span)) !important;
  }
  body.template-collection.fsb-panel-open #wrapper,
  body.collection.fsb-panel-open #wrapper {
    margin-right: calc(var(--fsb-sidebar-span) + var(--fsb-panel-width, 400px)) !important;
    width: calc(100% - var(--fsb-sidebar-span) - var(--fsb-panel-width, 400px)) !important;
  }
  {% endif %}
}
@media only screen and (min-width: 768px) and (max-width: 990px) {
  {% if section.settings.position == 'left' %}
  body.template-collection,
  body.collection {
    padding-left: 0 !important;
  }
  body.template-collection #wrapper,
  body.collection #wrapper {
    margin-left: var(--fsb-sidebar-span) !important;
    width: calc(100% - var(--fsb-sidebar-span)) !important;
  }
  {% else %}
  body.template-collection,
  body.collection {
    padding-right: 0 !important;
  }
  body.template-collection #wrapper,
  body.collection #wrapper {
    margin-right: var(--fsb-sidebar-span) !important;
    width: calc(100% - var(--fsb-sidebar-span)) !important;
  }
  {% endif %}
}
@media only screen and (max-width: 767px) {
  body:not(.fsb-panel-open) {
    padding-left: 0;
    padding-right: 0;
    padding-bottom: 95px;
  }
  body.fsb-panel-open {
    padding-left: 0;
    padding-right: 0;
    padding-bottom: 0;
  }
}
html{
  overflow-x: hidden;
}
body{
  transition: padding-left .5s cubic-bezier(0.22, 1, 0.36, 1),
              padding-right .5s cubic-bezier(0.22, 1, 0.36, 1),
              padding-bottom .5s cubic-bezier(0.22, 1, 0.36, 1);
  overflow-x: hidden;
}
/* ============ SIDEBAR CONTAINER ============ */
#sid-{{ section.id }} .thb-secondary-area-item:last-child {
  padding:0;
}
#sid-{{ section.id }} .fsb-container{
  position: fixed;
  top: 0;
  {% if section.settings.position == 'left' %}
  left: {{ section.settings.edge_offset }}px;
  border-radius: {{ section.settings.radius }}px;
  {% else %}
  right: {{ section.settings.edge_offset }}px;
  border-radius: {{ section.settings.radius }}px;
  {% endif %}
  height: 100vh;
  z-index: 1003 !important;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.vertical_padding }}px {{ section.settings.horizontal_padding }}px;
  box-sizing: border-box;
}
/* Lock sidebar's own padding so it NEVER shrinks/changes when any side panel is open */
#sid-{{ section.id }} .fsb-container,
body.fsb-panel-open #sid-{{ section.id }} .fsb-container{
  padding: {{ section.settings.vertical_padding }}px {{ section.settings.horizontal_padding }}px !important;
}
#sid-{{ section.id }} .fsb-group{
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: {{ section.settings.item_gap }}px;
  flex-shrink: 0;
}
#sid-{{ section.id }} .fsb-logo-wrap{
  flex: 1 1 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  gap:10px;
  min-height: 0;
  flex-direction: column;
}
#sid-{{ section.id }} .fsb-item{
  display: flex;
  align-items: center;
  justify-content: center;
  width: {{ section.settings.icon_size }}px;
  height: {{ section.settings.icon_size }}px;
  color: {{ section.settings.icon_color }};
  background: transparent;
  border: none;
  padding: 0;
  cursor: pointer;
  position: relative;
  border-radius: 10px;
  transition: color 0.2s ease, transform 0.2s ease, background 0.2s ease;
}
#sid-{{ section.id }} .fsb-item:hover{
  color: {{ section.settings.icon_hover_color }};
  transform: translateY(-1px);
}
#sid-{{ section.id }} .fsb-drive-icon-nplus-home {
  padding-left: 4px;
}
#sid-{{ section.id }} .fsb-item svg{
  width: 100%;
  height: 100%;
  display: block;
}
/* ===== ACTIVE DRAWER HIGHLIGHT ===== */
#sid-{{ section.id }} .fsb-item.fsb-active,
#sid-{{ section.id }} .thb-secondary-area-item.fsb-active{
  color: {{ section.settings.active_icon_color }};
  background: {{ section.settings.active_bg_color }};
  padding: 1px;
  box-sizing: border-box;
}
#sid-{{ section.id }} .fsb-item.fsb-active svg .cls-cart-1,
#sid-{{ section.id }} .fsb-item.fsb-active svg .cls-points-1,
#sid-{{ section.id }} .fsb-item.fsb-active svg .cls-rewards-1,
#sid-{{ section.id }} .fsb-item.fsb-active svg .cls-orders-1,
#sid-{{ section.id }} .fsb-item.fsb-active svg .cls-address-1,
#sid-{{ section.id }} .fsb-item.fsb-active svg .cls-support-1,
#sid-{{ section.id }} .fsb-item.fsb-active svg .cls-notif-1,
#sid-{{ section.id }} .fsb-item.fsb-active svg .cls-globe-1,
#sid-{{ section.id }} .fsb-item.fsb-active svg .cls-menu-1,
#sid-{{ section.id }} .thb-secondary-area-item.fsb-active svg .cls-globe-1{
  fill: {{ section.settings.active_icon_color }} !important;
}
#sid-{{ section.id }} .cls-cart-1,
#sid-{{ section.id }} .cls-points-1,
#sid-{{ section.id }} .cls-rewards-1,
#sid-{{ section.id }} .cls-orders-1,
#sid-{{ section.id }} .cls-address-1,
#sid-{{ section.id }} .cls-support-1,
#sid-{{ section.id }} .cls-notif-1,
#sid-{{ section.id }} .cls-globe-1,
#sid-{{ section.id }} .cls-menu-1{
  fill: currentColor;
}
#sid-{{ section.id }} .thb-secondary-item-icon{
  position: relative;
  display: inline-flex;
}
#sid-{{ section.id }} .thb-item-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: .625rem;
  font-weight: 600;
  width: 19px;
  height: 19px;
  border-radius: 50%;
  background: var(--color-accent, #d9a441);
  color: #fff;
  position: absolute;
  top: -5px;
  right: -9px;
  z-index: 2;
}
#sid-{{ section.id }} .fsb-notif-badge{
  top: -6px;
  right: -6px;
  background: {{ section.settings.active_icon_color | default: '#c79a3c' }};
}
#sid-{{ section.id }} .fsb-notif-dot {
  display: none;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #e0472c;
  position: absolute;
  top: 0px;
  right: -2px;
  z-index: 2;
  border: 1.5px solid {{ section.settings.bg_color }};
}
#sid-{{ section.id }} .fsb-notif-dot.is-visible{
  display: block;
}
#sid-{{ section.id }} .fsb-logo{
  display: flex;
  align-items: center;
  justify-content: center;
  width: {{ section.settings.logo_size }}px;
  height: {{ section.settings.logo_size }}px;
  border-radius: {{ section.settings.logo_radius }}px;
  background: {{ section.settings.logo_bg_color }};
  color: {{ section.settings.logo_text_color }};
  font-weight: 700;
  font-size: 13px;
  letter-spacing: 0.5px;
  overflow: hidden;
  text-decoration: none;
}
#sid-{{ section.id }} .fsb-logo img{
  width: 100%;
  height: 100%;
  object-fit: cover;
}
#sid-{{ section.id }} .fsb-logo.fsb-account-icon svg{
  width: 65%;
  height: 65%;
}
#sid-{{ section.id }} .thb-secondary-area{
  display: flex;
  flex-direction: column;
  align-items: center;
}
#sid-{{ section.id }} .toggle_custom_hidden {
  display: none;
}
#sid-{{ section.id }} div.thb-secondary-area.thb-header-right {
  position: relative;
}
#sid-{{ section.id }} .thb-secondary-flag img {
  display: none;
}
#sid-{{ section.id }} .fsb-item-globe {
  display:block;
}
#sid-{{ section.id }} .thb-secondary-flag{
  position: relative;
  display: inline-flex;
  border-radius: 10px;
  transition: background 0.2s ease;
}
#sid-{{ section.id }} .flag-popup-overlay {
  display: none !important;
}
#sid-{{ section.id }} .mobile-icon-title{
  display:none;
}
.fsb-panel-body .checkbox-wrapper {
  margin-bottom: 20px;
}
/* ============ SIDE PANEL SYSTEM ============ */
:root{ --fsb-panel-width: {{ section.settings.panel_width | default: 400 }}px; }
.fsb-panel-overlay{
  position: fixed;
  inset: 0;
  z-index: 1001;
  pointer-events: none;
}
.fsb-panel-overlay.active {
  pointer-events: none;
}
@media only screen and (max-width: 767px) {
  .fsb-panel-overlay.active {
    pointer-events: auto;
  }
}

/* ============ CHATBOT / ZENDESK POPUP & LAUNCHER ============ */
/* Hide all default bottom-right floating chat buttons / launchers */
#launcher,
iframe#launcher,
[id="launcher"],
[id*="launcher" i],
.zEWidget-launcher,
[class*="launcher" i],
iframe[title*="Launcher" i],
iframe[title*="Button to launch messaging window" i],
iframe[title*="Button to launch chat" i],
div[data-testid="launcher-container"],
[data-testid="launcher-container"],
[data-testid="launcher"],
[data-testid="launcher-badge"],
#web-messenger-container > button,
#web-messenger-container [data-testid="launcher"],
#web-messenger-container button[aria-label],
#shopify-chat,
#shopify-chat-button,
iframe#dummy-chat-button-iframe,
div[id^="shopify-chat"],
#gorgias-chat-messenger-button,
#gorgias-chat-container > button,
#tidio-chat-iframe,
#chat-widget-container,
div.zopim,
iframe.zopim {
  display: none !important;
  visibility: hidden !important;
  opacity: 0 !important;
  pointer-events: none !important;
  width: 0 !important;
  height: 0 !important;
  max-width: 0 !important;
  max-height: 0 !important;
  position: fixed !important;
  bottom: -99999px !important;
  right: -99999px !important;
  transform: scale(0) !important;
}

/* Position chat messenger window on the left side with top z-index */
#web-messenger-container,
iframe#web-messenger-container,
iframe#webWidget,
div#webWidget,
div[id*="web-messenger"],
iframe[title*="Messaging Window" i],
iframe[title*="Chat with" i],
iframe[title*="Help" i],
iframe[title*="Zendesk" i],
.zEWidget-webWidget,
#gorgias-chat-container,
iframe#gorgias-chat-container,
#shopify-chat-container,
iframe#shopify-chat-iframe {
  {% if section.settings.position == 'left' %}
  left: var(--fsb-sidebar-span, 60px) !important;
  right: auto !important;
  {% else %}
  right: var(--fsb-sidebar-span, 60px) !important;
  left: auto !important;
  {% endif %}
  bottom: 0 !important;
  max-width: calc(100vw - var(--fsb-sidebar-span, 60px)) !important;
  z-index: 2147483647 !important;
}

@media only screen and (max-width: 767px) {
  #web-messenger-container,
  iframe#web-messenger-container,
  iframe#webWidget,
  div#webWidget,
  div[id*="web-messenger"],
  iframe[title*="Messaging Window" i],
  iframe[title*="Chat with" i],
  iframe[title*="Help" i],
  iframe[title*="Zendesk" i],
  .zEWidget-webWidget,
  #gorgias-chat-container,
  iframe#gorgias-chat-container,
  #shopify-chat-container,
  iframe#shopify-chat-iframe {
    left: 0 !important;
    right: 0 !important;
    bottom: 80px !important;
    max-width: 100vw !important;
    z-index: 2147483647 !important;
  }
}

.fsb-side-panel{
  position: fixed;
  top: 0;
  width: var(--fsb-panel-width);
  max-width: calc(100vw - 90px);
  height: 100vh;
  background: #fff;
  transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  display: flex;
  flex-direction: column;
  z-index: 1002;
  pointer-events: none;
}
.fsb-side-panel.active{
  pointer-events: auto;
}
/* Position based on sidebar side - all panels slide from the same side as sidebar */
{% if section.settings.position == 'left' %}
.fsb-side-panel{
  left: var(--fsb-sidebar-span);
  right: auto;
  transform: translateX(-110%);
}
.fsb-side-panel.active{
  transform: translateX(0);
}
.fsb-panel-add-address{
  left: var(--fsb-sidebar-span) !important;
  right: auto !important;
  transform: translateX(-110%) !important;
}
.fsb-panel-add-address.active{
  transform: translateX(0) !important;
}
.cart-drawer{
  left: var(--fsb-sidebar-span) !important;
  right: auto !important;
  transform: translateX(-150%) !important;
  visibility: hidden !important;
  overflow: hidden !important;
}
.cart-drawer.active{
  transform: translateX(0) !important;
  visibility: visible !important;
  overflow-y: auto !important;
}
{% else %}
.fsb-side-panel{
  right: var(--fsb-sidebar-span);
  left: auto;
  transform: translateX(110%);
}
.fsb-side-panel.active{
  transform: translateX(0);
}
.fsb-panel-add-address{
  right: var(--fsb-sidebar-span) !important;
  left: auto !important;
  transform: translateX(110%) !important;
}
.fsb-panel-add-address.active{
  transform: translateX(0) !important;
}
.cart-drawer{
  right: var(--fsb-sidebar-span) !important;
  left: auto !important;
  transform: translateX(150%) !important;
  visibility: hidden !important;
  overflow: hidden !important;
}
.cart-drawer.active{
  transform: translateX(0) !important;
  visibility: visible !important;
  overflow-y: auto !important;
}
{% endif %}
.fsb-panel-head{
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 20px 22px;
  border-bottom: 1px solid #eee;
  flex-shrink: 0;
  z-index: 99;
}
.fsb-panel-head h3{
  margin: 0;
  font-size: 17px;
  font-weight: 600;
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8px;
}
.fsb-panel-count{
  background: {{ section.settings.active_icon_color | default: '#c79a3c' }};
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  min-width: 20px;
  height: 20px;
  padding: 0 6px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
}
.fsb-panel-count.is-zero{ display: none; }
.fsb-panel-close, .fsb-panel-back{
  border: none;
  background: transparent;
  cursor: pointer;
  color: #666;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8px;
}
.fsb-panel-close:hover, .fsb-panel-back:hover{ color: #000; }
.fsb-panel-body{
  flex: 1;
  overflow-y: auto;
  padding: 18px 22px;
  -webkit-overflow-scrolling: touch;
}
.fsb-panel-body * {
  pointer-events: auto !important;
}
.fsb-panel-foot{
  border-top: 1px solid #eee;
  padding: 16px 22px 20px;
  flex-shrink: 0;
}
.fsb-panel-loading, .fsb-panel-empty, .fsb-panel-note{
  color: #888;
  font-size: 13.5px;
}
.fsb-panel-empty a{ color: inherit; text-decoration: underline; }
.fsb-list{ list-style: none; margin: 0; padding: 0; }
.fsb-list-card{
  border: 1px solid #eee;
  border-radius: 10px;
  padding: 14px 16px;
  margin-bottom: 12px;
}
.fsb-list-card-top{
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 6px;
}
.fsb-list-card-top strong{ font-size: 13.5px; }
.fsb-price{ margin-left: 8px; font-size: 13px; color: #555; }
.fsb-list-card-meta{ font-size: 12px; color: #888; line-height: 1.5; }
.fsb-list-card-link{
  display: inline-block;
  margin-top: 8px;
  font-size: 12.5px;
  font-weight: 600;
  color: #1a1a1a;
  text-decoration: none;
}
.fsb-list-card-link:hover { text-decoration: underline; }
.fsb-badge{
  font-size: 10.5px;
  font-weight: 700;
  padding: 3px 9px;
  border-radius: 999px;
  background: #eef7ee;
  color: #2e7d32;
  text-transform: capitalize;
  white-space: nowrap;
}
.fsb-badge-primary{ background: #fdf3e0; color: #a9761c; }
.fsb-edit-link{
  margin-left: auto;
  color: #999;
  border: none;
  background: transparent;
  cursor: pointer;
  padding: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.fsb-edit-link:hover{
  color: #333;
}
.fsb-add-new{
  display: block;
  text-align: center;
  padding: 12px;
  border: 1px dashed #ccc;
  border-radius: 10px;
  color: #666;
  text-decoration: none;
  font-size: 13px;
  margin-top: 6px;
  background: transparent;
  cursor: pointer;
  transition: all 0.2s ease;
}
.fsb-add-new:hover {
  border-color: #999;
  color: #333;
  background: #f9f9f9;
}
/* ============================================================ */
/* NOTIFICATIONS PANEL                                         */
/* ============================================================ */
.fsb-notif-toolbar{
  display: flex;
  justify-content: flex-end;
  margin-bottom: 14px;
}
.fsb-mark-all-read{
  border: none;
  background: transparent;
  cursor: pointer;
  color: {{ section.settings.active_icon_color | default: '#c79a3c' }};
  font-size: 13px;
  font-weight: 600;
  padding: 0;
}
.fsb-mark-all-read:hover{ text-decoration: underline; }
.fsb-mark-all-read:disabled{ opacity: .5; cursor: default; text-decoration: none; }
.fsb-notif-card{
  display: flex;
  align-items: flex-start;
  gap: 12px;
  border: 1px solid #ececec;
  background: #fff;
  border-radius: 12px;
  padding: 15px 16px;
  transition: border-color .2s ease, background .2s ease;
}
.fsb-notif-card.is-unread{
