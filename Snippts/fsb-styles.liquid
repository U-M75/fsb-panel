/* ===== FIXED MENU CHILD TRANSITIONS ===== */
.fsb-menu-sub{
  display: none !important;
  opacity: 0;
  transform: translateX(15px);
  transition: opacity 0.25s ease, transform 0.3s ease;
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: #fff;
  overflow-y: auto;
  padding: 0 0 20px 0;
  box-sizing: border-box;
  pointer-events: none;
}
.fsb-menu-sub.active{
  display: block !important;
  opacity: 1;
  transform: translateX(0);
  pointer-events: auto;
}
/* Position the submenu relative to its parent container */
.fsb-menu-root {
  position: relative;
  min-height: 300px;
}
.fsb-menu-root > .fsb-menu-item {
  position: relative;
}
.fsb-menu-item.fsb-has-children {
  position: relative;
}
.fsb-menu-sub {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  min-height: 100%;
  background: #fff;
  z-index: 10;
  box-shadow: -4px 0 20px rgba(0,0,0,0.04);
}
/* Ensure submenu items are visible */
.fsb-menu-sub .fsb-menu-item {
  display: block !important;
}
/* When submenu is active, it overlays the parent items */
.fsb-menu-root > .fsb-menu-item[style*="display: none"] + .fsb-menu-sub.active {
  display: block !important;
}
