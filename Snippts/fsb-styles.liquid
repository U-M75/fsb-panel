/* Mobile: drawers END ABOVE the bottom lozenge nav — no padding, pure geometry.
   The nav lozenge is 74px tall sitting 4px off the bottom (+ safe area), so
   every drawer's bottom edge stops right above it; content can never slide
   behind the bar and the last buttons stay fully visible/clickable. */
@media only screen and (max-width: 767px){
  .fsb-side-panel{
    bottom: calc(84px + env(safe-area-inset-bottom, 0px)) !important;
    height: calc(88vh - 84px - env(safe-area-inset-bottom, 0px)) !important;
    max-height: calc(100dvh - 84px - env(safe-area-inset-bottom, 0px)) !important;
    /* hidden state must also clear the 84px lift or the top strip peeks out */
    transform: translateY(calc(100% + 84px + env(safe-area-inset-bottom, 0px))) !important;
  }
  .fsb-side-panel.active{
    transform: translateY(0) !important;
  }
  .fsb-account-panel{
    height: calc(92vh - 84px - env(safe-area-inset-bottom, 0px)) !important;
  }
  .fsb-menu-sub{
    bottom: calc(84px + env(safe-area-inset-bottom, 0px)) !important;
    height: calc(100dvh - 84px - env(safe-area-inset-bottom, 0px)) !important;
  }
  /* Theme drawers (cart drawer + any default/promo/gift side drawer) —
     FULL-BLEED jaise membership drawer: poori screen cover, background
     neeche nav tak extended; inner scroll area 82px oopar rukta hai taake
     checkout/footer buttons floating nav ke peechay na chhupein. Drawer
     band ho to yeh rule lagta hi nahi (.active/visible par hi). */
  .cart-drawer.active,
  :is(.side-panel, .promo-drawer, .gift-drawer, .cart-gift-drawer, .drawer, [class*="-drawer"]):not([class*="fsb"]):is(.active, .is-open, .is-active, .open, .visible, [data-open], [aria-hidden="false"]){
    top: 0 !important;
    bottom: 0 !important;
    height: 100vh !important;
    height: 100dvh !important;
    max-height: none !important;
    min-height: 0 !important;
  }
  .cart-drawer.active .cart-drawer__inner,
  .cart-drawer.active .side-panel-content{
    height: calc(100% - 84px - env(safe-area-inset-bottom, 0px)) !important;
    max-height: calc(100% - 84px - env(safe-area-inset-bottom, 0px)) !important;
  }
}

