   ======================================================================== */
@media only screen and (min-width: 991px) {
  #sid-{{ section.id }} .fsb-container,
  body.fsb-panel-open #sid-{{ section.id }} .fsb-container {
    width: calc({{ section.settings.icon_size }}px + {{ section.settings.horizontal_padding }}px + {{ section.settings.horizontal_padding }}px) !important;
    min-width: calc({{ section.settings.icon_size }}px + {{ section.settings.horizontal_padding }}px + {{ section.settings.horizontal_padding }}px) !important;
    max-width: calc({{ section.settings.icon_size }}px + {{ section.settings.horizontal_padding }}px + {{ section.settings.horizontal_padding }}px) !important;
    padding: {{ section.settings.vertical_padding }}px {{ section.settings.horizontal_padding }}px !important;
    box-sizing: border-box !important;
  }
}
/* ========================================================================
   TABLET (768px - 990px) - drawer overlap sidebar area, no body padding shift
   ======================================================================== */
@media only screen and (min-width: 768px) and (max-width: 990px) {
  /* Don't push body content - keep it in place */
  body.fsb-panel-open {
    {% if section.settings.position == 'left' %}
    padding-left: var(--fsb-sidebar-span) !important;
    {% else %}
    padding-right: var(--fsb-sidebar-span) !important;
    {% endif %}
  }
  #sid-{{ section.id }} .fsb-container,
  body.fsb-panel-open #sid-{{ section.id }} .fsb-container {
    width: calc({{ section.settings.icon_size }}px + {{ section.settings.horizontal_padding }}px + {{ section.settings.horizontal_padding }}px) !important;
    min-width: calc({{ section.settings.icon_size }}px + {{ section.settings.horizontal_padding }}px + {{ section.settings.horizontal_padding }}px) !important;
    max-width: calc({{ section.settings.icon_size }}px + {{ section.settings.horizontal_padding }}px + {{ section.settings.horizontal_padding }}px) !important;
    padding: {{ section.settings.vertical_padding }}px {{ section.settings.horizontal_padding }}px !important;
    box-sizing: border-box !important;
  }
  /* Panels on tablet - full width minus sidebar, but DON'T push body */
  .fsb-side-panel {
    width: calc(60vw - var(--fsb-sidebar-span) - 10px) !important;
    max-width: calc(100vw - var(--fsb-sidebar-span) - 10px) !important;
    {% if section.settings.position == 'left' %}
    left: var(--fsb-sidebar-span) !important;
    right: auto !important;
    {% else %}
    right: var(--fsb-sidebar-span) !important;
    left: auto !important;
    {% endif %}
  }
  /* Add Address panel on tablet - stacks on top of Address Book */
  #fsb-panel-overlay-{{ section.id }}.fsb-address-pair-open #fsb-panel-add-address-{{ section.id }}.active {
    {% if section.settings.position == 'left' %}
    left: var(--fsb-sidebar-span) !important;
    right: auto !important;
    transform: translateX(0) !important;
    z-index: 1003 !important;
    {% else %}
    right: var(--fsb-sidebar-span) !important;
    left: auto !important;
    transform: translateX(0) !important;
    z-index: 1003 !important;
    {% endif %}
  }
  /* Address Book panel - keep it visible behind add address */
  #fsb-panel-overlay-{{ section.id }}.fsb-address-pair-open #fsb-panel-address-{{ section.id }}.active {
    z-index: 1002 !important;
  }
}
