.fsb-tier-icon-img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;border-radius:10px;background:#fff}
.fsb-tier-icon-fallback{display:flex;align-items:center;justify-content:center;background:#f6f1e4;color:#c79a3c}
.fsb-tier-icon-fallback svg{width:26px;height:26px}
.fsb-tier-meta{min-width:0}
.fsb-tier-meta small{display:block;font-size:9.5px;letter-spacing:.16em;text-transform:uppercase;color:#a7a5a1;font-weight:700}
.fsb-tier-meta strong{display:block;font-size:16px;color:#242220;font-weight:800;margin-top:3px;line-height:1.2}
.fsb-retain{margin:8px 0 0;font-size:11.5px;color:#8a8782;line-height:1.5}
.fsb-retain b{color:#c79a3c;font-weight:700}

