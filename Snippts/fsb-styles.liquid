/* --- Change 12: Marketing toggle — obvious ON/OFF look --- */
.fsb-switch-big{width:52px;height:28px}
.fsb-switch-big i{background:#dcdcdc;border:1px solid #c9c9c9}
.fsb-switch-big i:before{width:24px;height:24px;left:1px;top:1px;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.25)}
.fsb-switch-big input:checked+i{background:#d0a44a;border-color:#b9903a}
.fsb-switch-big input:checked+i:before{transform:translateX(24px);background:#fff}
.fsb-switch-big input:disabled+i{opacity:.6;cursor:wait}
