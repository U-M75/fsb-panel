<!-- Section File Name: floating-sidebar.liquid -->
<!-- Section Name: Floating Quick Sidebar -->
<!-- Presets Name: Floating Quick Sidebar -->
{% if section.settings.hide_theme_header %}
  <!-- This must come before the external mobile-menu stylesheet. Keeping it
       first prevents the normal theme header from painting during refresh. -->
  <style id="fsb-header-no-flash-{{ section.id }}">
    .header-section,
    #shopify-section-header,
    [id^="shopify-section-"][class*="header-section"]{
      display:none !important;
      visibility:hidden !important;
      opacity:0 !important;
      pointer-events:none !important;
      position:fixed !important;
      width:0 !important;
      height:0 !important;
      min-height:0 !important;
      margin:0 !important;
      padding:0 !important;
      overflow:hidden !important;
    }
  </style>
{% endif %}
{% if section.settings.use_theme_mobile_menu %}
  {{- 'mobile-menu.css' | asset_url | stylesheet_tag -}}
{% endif %}
{% assign fsb_sidebar_span = section.settings.icon_size | plus: section.settings.horizontal_padding | plus: section.settings.horizontal_padding | plus: section.settings.edge_offset %}
<style id="fsb-critical-{{ section.id }}">
  {% if section.settings.hide_theme_header %}
  /* Critical header suppression: declared in the first style block so the
     theme header never occupies visible layout while this section loads. */
  .header-section,
  #shopify-section-header,
  [id^="shopify-section-"][class*="header-section"]{
    display:none !important;
    visibility:hidden !important;
    opacity:0 !important;
    pointer-events:none !important;
    height:0 !important;
    min-height:0 !important;
    margin:0 !important;
    padding:0 !important;
    overflow:hidden !important;
  }
  {% endif %}
  {% if section.settings.position == 'left' %}
  :root{ --fsb-hide: -110%; --fsb-sidebar-span: {{ fsb_sidebar_span }}px; --fsb-panel-width: {{ section.settings.panel_width | default: 400 }}px; }
  {% else %}
  :root{ --fsb-hide: 110%; --fsb-sidebar-span: {{ fsb_sidebar_span }}px; --fsb-panel-width: {{ section.settings.panel_width | default: 400 }}px; }
  {% endif %}
  #sid-{{ section.id }} .fsb-container{
    position: fixed;
    top: 0;
    {% if section.settings.position == 'left' %}left: {{ section.settings.edge_offset }}px;{% else %}right: {{ section.settings.edge_offset }}px;{% endif %}
    height: 100vh;
    z-index: 1003;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.vertical_padding }}px {{ section.settings.horizontal_padding }}px;
    box-sizing: border-box;
  }
  #sid-{{ section.id }} .fsb-group{
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: {{ section.settings.item_gap }}px;
    flex-shrink: 0;
  }
  #sid-{{ section.id }} .fsb-logo-wrap{
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    min-height: 0;
  }
  #sid-{{ section.id }} .fsb-item{
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    color: {{ section.settings.icon_color }};
    background: transparent;
    border: none;
    padding: 0;
    box-sizing: border-box;
  }
  #sid-{{ section.id }} .fsb-item svg,
  #sid-{{ section.id }} .fsb-drive-icon{
    width: 100%;
    height: 100%;
    display: block;
  }
  #sid-{{ section.id }} .fsb-logo{
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.logo_size }}px;
    height: {{ section.settings.logo_size }}px;
    overflow: hidden;
  }
  #sid-{{ section.id }} .mobile-icon-title{ display: none; }
  .fsb-panel-overlay{
    position: fixed;
    inset: 0;
    z-index: 1001;
    pointer-events: none;
  }
  .fsb-side-panel{
    position: fixed;
    top: 0;
    width: var(--fsb-panel-width);
    max-width: calc(100vw - 90px);
    height: 100vh;
    background: #fff;
    display: flex;
    flex-direction: column;
    z-index: 1002;
    pointer-events: none;
    {% if section.settings.position == 'left' %}
    left: var(--fsb-sidebar-span);
    right: auto;
    transform: translateX(-110%);
    {% else %}
    right: var(--fsb-sidebar-span);
    left: auto;
    transform: translateX(110%);
    {% endif %}
  }
  .fsb-side-panel.active{
    transform: translateX(0);
    pointer-events: auto;
  }
  .cart-drawer{
    position: fixed !important;
    top: 0 !important;
    width: var(--fsb-panel-width, 400px) !important;
    max-width: calc(100vw - 90px) !important;
    height: 100vh !important;
    z-index: 1002 !important;
    pointer-events: none !important;
    visibility: hidden !important;
    overflow: hidden !important;
    {% if section.settings.position == 'left' %}
    left: var(--fsb-sidebar-span) !important;
    right: auto !important;
    transform: translateX(-150%) !important;
    {% else %}
    right: var(--fsb-sidebar-span) !important;
    left: auto !important;
    transform: translateX(150%) !important;
    {% endif %}
  }
  .cart-drawer.active{
    transform: translateX(0) !important;
    pointer-events: auto !important;
    visibility: visible !important;
    overflow-y: auto !important;
  }
  .cart-drawer:not(.active){
    visibility: hidden !important;
    pointer-events: none !important;
    overflow: hidden !important;
  }
  @media only screen and (max-width: 767px){
    #sid-{{ section.id }} .fsb-container{
      left: 16px;
      right: 16px;
      bottom: 4px;
      top: auto;
      width: auto;
      height: 74px;
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 0 22px;
      border-radius: 40px;
      background: #fff;
      box-sizing: border-box;
    }
    #sid-{{ section.id }} .fsb-group{
      display: flex;
      flex-direction: row;
      align-items: center;
    }
    #sid-{{ section.id }} .fsb-logo-wrap{ display: contents; }
    #sid-{{ section.id }} .fsb-group-top,
    #sid-{{ section.id }} .fsb-group-bottom{ display: contents; }
    #sid-{{ section.id }} .fsb-item,
    #sid-{{ section.id }} .thb-secondary-area-item{
      width: auto;
      height: 49px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
    }
    #sid-{{ section.id }} .fsb-item > .fsb-drive-icon,
    #sid-{{ section.id }} .thb-secondary-item-icon > .fsb-drive-icon,
    #sid-{{ section.id }} .fsb-logo > .fsb-drive-icon{
      width: 32px !important;
      height: 32px !important;
      max-width: 32px !important;
      max-height: 32px !important;
    }
    .fsb-side-panel,
    .cart-drawer{
      left: 0 !important;
      right: 0 !important;
      top: auto !important;
      bottom: 0 !important;
      width: 100% !important;
      max-width: 100% !important;
      height: 88vh !important;
      transform: translateY(100%) !important;
      border-radius: 18px 18px 0 0 !important;
    }
    .fsb-side-panel.active,
    .cart-drawer.active{
      transform: translateY(0) !important;
      pointer-events: auto !important;
    }
  }
</style>

