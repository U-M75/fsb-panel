<!doctype html>
{%- capture dir -%}
	{%- case request.locale.iso_code -%}
	  {%- when 'ae' or 'ar' or 'arc' or 'bcc' or 'bqi' or 'ckb' or 'dv' or 'fa' or 'glk' or 'ha' or 'he' or 'kwh' or 'ks' or 'ku' or 'mzn' or 'nqo' or 'pnb' or 'ps' or 'sd' or 'ug' or 'ur' or 'yi' -%}
	    rtl
	  {%- else -%}
	    ltr
	{%- endcase -%}
{%- endcapture -%}
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{{ dir }}">
  <head>
    <!-- Added by APP PLAZA -->
    {% include 'app-plaza' %}
    <!-- /Added by APP PLAZA -->
    {% comment %}EasylockdownHeadBegin{% endcomment %}
    {% capture elhRender %}{% render 'easylockdown_head', easylockdownRender: true, easylockdownOnlySpecialPriceSelector: easylockdownOnlySpecialPriceSelector, easylockdownCustomPriceSelector: easylockdownCustomPriceSelector %}{% endcapture %}
    {% assign elhRender = elhRender | split: '--elhResults--' %}
    {{ elhRender[0] }}
    {% comment %}EasylockdownHeadEnd{% endcomment %}
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_body_bg }}">
    <script>
      if (window.location.pathname.includes('zh/account/register')) {
        window.location.href = 'https://account.nextcigar.com/zh-tw/register';
      }
    </script>
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"
      integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    ></script>
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- comment -%}
      FIX: build each alternate URL as  domain + language root + page path WITHOUT the
      current locale folder. The old version replaced ".com" inside a URL that already
      contained /en-hk, producing /zh-hk/en-hk/... - the sidebar language switcher
      follows these links, which is how the stacked 404 URLs were created.
    {%- endcomment -%}
    {%- liquid
      assign nc_page_path = canonical_url | remove_first: shop.url
      if routes.root_url != '/'
        assign nc_root_check = nc_page_path | slice: 0, routes.root_url.size
        if nc_root_check == routes.root_url
          assign nc_page_path = nc_page_path | remove_first: routes.root_url
        endif
      endif
      if nc_page_path == blank
        assign nc_page_path = '/'
      endif
    -%}
    {%- for locale in localization.available_languages -%}
      {%- liquid
        if locale.root_url == '/'
          assign nc_alt_url = shop.url | append: nc_page_path
        elsif nc_page_path == '/'
          assign nc_alt_url = shop.url | append: locale.root_url
        else
          assign nc_alt_url = shop.url | append: locale.root_url | append: nc_page_path
        endif
      -%}
      <link rel="alternate" hreflang="{{ locale.iso_code }}" href="{{ nc_alt_url }}">
    {%- endfor %}
    <link rel="alternate" hreflang="x-default" href="{{ canonical_url }}">

    {% render 'head-preload' %}

    {% if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif %}

    <title>
      {{ page_title }}
      {% if current_tags -%}
        {%- assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags -}}
      {%- endif %}
      {% if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif %}
      {% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {%- unless settings.heading_font.system? and settings.body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    {% render 'social-meta-tags' %}

    {% comment %}
      <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" rel="stylesheet" type="text/css" media="all">
      <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.9.0/slick.css" />
      <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.9.0/slick-theme.css" />
      <script src="https://code.jquery.com/jquery-3.6.0.min.js" defer></script>
      <script src="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.js" defer></script>
    {% endcomment %}

    {{ 'app.css' | asset_url | stylesheet_tag }}
    {{ 'product-grid.css' | asset_url | stylesheet_tag }}

    {% comment %}
      {{ 'slick.css' | asset_url | stylesheet_tag }}
      {{ 'slick-theme.css' | asset_url | stylesheet_tag }}
    {% endcomment %}

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.9.0/slick.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.9.0/slick-theme.css">
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.9.0/slick.min.js"
      integrity="sha512-HGOnQO9+SP1V92SrtZfjqxxtLmVzqZpjFFekvzZVWoiASSQgSr4cw9Kqd2+l8Llp4Gm0G8GIFJ4ddwZilcdb8A=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
      defer
    ></script>

    {% render 'head-variables' %}

    <script>
		window.theme = window.theme || {};
		theme = {
			settings: {
				money_with_currency_format: {{- shop.money_format | json -}},
				cart_drawer: {{- settings.cart_drawer -}}
			},
			routes: {
				root_url: '{{ routes.root_url }}',
				cart_url: '{{ routes.cart_url }}',
				cart_add_url: '{{ routes.cart_add_url }}',
				search_url: '{{ routes.search_url }}',
				cart_change_url: '{{ routes.cart_change_url }}',
				cart_update_url: '{{ routes.cart_update_url }}',
				predictive_search_url: '{{ routes.predictive_search_url }}',
			},
			variantStrings: {
        addToCart: `{{ 'products.product.add_to_cart' | t }}`,
        soldOut: `{{ 'products.product.sold_out' | t }}`,
        unavailable: `{{ 'products.product.unavailable' | t }}`,
        preOrder: `{{ 'products.product.pre_order' | t }}`,
      },
			strings: {
				requiresTerms: `{{ 'sections.cart.terms_confirm' | t }}`,
				shippingEstimatorNoResults: `{{ 'sections.cart.shipping_estimator.no_results' | t }}`,
				shippingEstimatorOneResult: `{{ 'sections.cart.shipping_estimator.one_result' | t }}`,
				shippingEstimatorMultipleResults: `{{ 'sections.cart.shipping_estimator.multiple_results' | t }}`,
				shippingEstimatorError: `{{ 'sections.cart.shipping_estimator.error' | t }}`
			}
		};
    </script>
    {{ content_for_header }}
    <!-- Header hook for plugins -->

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>
    {{ settings.custom_html_head }}

    <!-- Google Tag Manager -->
    <script>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-T32DNQC');
    </script>
    <!-- End Google Tag Manager -->

    {{ 'custom.css' | asset_url | stylesheet_tag }}

    {% if template.name == 'product' %}
      <style>
        .notify_nonloggedin.modal-overlay {
          position: fixed;
          inset: 0;
          background: rgba(0, 0, 0, 0.5);
          display: flex;
          justify-content: center;
          align-items: center;
          z-index: 9999;
          visibility: hidden;
          opacity: 0;
          transition: all .3s ease-in;
        }
        .notify_nonloggedin.modal-overlay.active {
          visibility: visible;
          opacity: 1;

        }

        .notify_nonloggedin .modal {
          background: #fff;
          border-radius: 16px;
          padding: 36px 70px 28px;
          max-width: 525px;
          width: 90%;
          position: relative;
          text-align: center;
          box-shadow: 0 4px 24px rgba(0, 0, 0, 0.18);
        }

        .notify_nonloggedin .modal-close {
          position: absolute;
          top: 12px;
          right: 14px;
          background: none;
          border: none;
          font-size: 20px;
          cursor: pointer;
          color: #555;
          line-height: 1;
        }

        .notify_nonloggedin .modal-close:hover {
          color: #000;
        }

        .notify_nonloggedin .modal h2 {
          font-size: 32px;
          font-weight: 500;
          margin-bottom: 14px;
          color: #000000;
          font-family: 'Playfair Display';
          margin: 0;
          padding-bottom: 18px;
        }

        .notify_nonloggedin .modal p {
          font-size: 18px;
          color: #212529;
          margin-bottom: 22px;
          line-height: 1.5;
          font-weight: 400;
        }
        .notify_nonloggedin .modal p:last-child {
          font-size: 14px;
          margin: 0;
        }

        .notify_nonloggedin .notify-modal-btn {
          display: block;
          width: 100%;
          padding: 13px;
          background: #454f5b;
          color: #fff;
          height: 100%;
          border: none;
          border-radius: 25px;
          font-size: 15px;
          font-weight: 400;
          cursor: pointer;
          text-decoration: none;
          margin-bottom: 16px;
          transition: all .2s linear;
        }

        .notify_nonloggedin .notify-modal-btn:hover {
          background: #525e6dff;
        }

        .notify_nonloggedin .modal-note {
          font-size: 11.5px;
          color: #666;
          line-height: 1.5;
          margin-bottom: 10px !important;
        }

        .notify_nonloggedin .modal-note span {
          color: #c0392b;
          font-style: italic;
          display: block;
          padding-top: 10px;
        }

        @media screen and (max-width: 767px){
          .notify_nonloggedin .modal{
            padding: 36px 40px 28px;
          }
          .notify_nonloggedin .modal h2{
            font-size: 26px;
          }
          .notify_nonloggedin .notify-modal-btn{
            font-size: 13px;
          }
          .notify_nonloggedin .modal p{
            font-size: 15px;
          }
          .notify_nonloggedin .modal p:last-child{
            font-size: 12px;
          }
        }
      </style>
    {% endif %}

    <style>
      .amount.sale_price{
        color: #C62A32;
      }
    </style>
  </head>
  <body class="animations-{{ settings.animations }} button-uppercase-{{ settings.button_uppercase }} navigation-uppercase-{{ settings.navigation_uppercase }} product-card-spacing-{{ settings.product_card_spacing }} article-card-spacing-{{ settings.article_card_spacing }} {% if customer %} customer-logged-in{% endif %} template-{{ template | replace: '.', ' ' | truncatewords: 1, '' | handle }} template-{{ template | replace: '.', '-' | handle }}">
    {% if template.name == 'product' %}
      <div class="notify_nonloggedin modal-overlay">
        <div class="modal">
          <button class="modal-close" onclick="this.closest('.modal-overlay').classList.remove('active')">
            &times;
          </button>
          <h2>Notify me when available</h2>
          <p>Log in or create a nextCIGAR account to receive a back-in-stock email alert for this item.</p>
          <a href="https://account.nextcigar.com/home/nextcigar" target="_blank" class="notify-modal-btn"
            >Login / Register</a
          >
          <p class="modal-note">
            *Opens in a new tab. Please return here once completed—this page will refresh automatically in
            <span class="timer">30 Seconds</span>
          </p>
          <p>(If the page does not refresh, please reload it manually.)</p>
        </div>
      </div>
    {% endif %}
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-T32DNQC"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe
    ></noscript>
    <!-- End Google Tag Manager (noscript) -->
    {% section 'age-popup' %}
    <a class="screen-reader-shortcut" href="#main-content">{{ 'accessibility.skip_to_text' | t }}</a>
    <div id="wrapper">
      <div class="header--sticky"></div>
      {% sections 'header-group' %}
      <div role="main" id="main-content">
        {% comment %}{{ content_for_layout }}{% endcomment %}
        {%- render 'easylockdown_body', content_for_layout: content_for_layout, elhDefines: elhRender[1] %}
      </div>
      {% sections 'footer-group' %}
      {% render 'cart-drawer' %}
      {% render 'product-drawer' %}
      {% render 'search-drawer' %}
      <div class="click-capture"></div>
      <div class="click-capture--product"></div>
    </div>
    
    <script src="{{ 'vendor.min.js' | asset_url }}" defer></script>
    {% if settings.animations %}
      <script src="{{ 'animations.min.js' | asset_url }}" defer></script>
      <script>
        gsap.defaults({
          ease: Power4.easeOut,
        });
        gsap.config({
          nullTargetWarn: false,
        });
        gsap.registerPlugin(ScrollTrigger, DrawSVGPlugin);
      </script>
    {% endif %}
    <script src="{{ 'product.js' | asset_url }}" defer></script>
    <script src="{{ 'slideshow.js' | asset_url }}" defer></script>
    <script src="{{ 'app.js' | asset_url }}"></script>
    <script type="module" src="{{ 'scroll-shadow.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
    {%- if settings.free_shipping -%}
      {{ 'free-shipping.js' | asset_url | script_tag }}
      {{ 'free-shipping.css' | asset_url | stylesheet_tag }}
    {%- endif -%}
    {%- if request.design_mode -%}
      {{ 'theme-editor.js' | asset_url | script_tag }}
    {%- endif -%}
    {% render 'back-to-top' %}
    {%- if settings.preload_links -%}
      {%- unless request.design_mode -%}
        <script type="module" src="{{ 'instant-page.js' | asset_url }}" defer="defer"></script>
      {%- endunless -%}
    {%- endif -%}

    {% render 'zendesk-chat-icon' %}
    {% comment %} Dotdigital CartInsight: Start {% endcomment %}
    {%- if content_for_header contains 'https:\/\/r3-t.trackedlink.net\/shopify\/ddgtag.js' and customer.email %}
      {% assign track_non_subscribed = true %}
      {% if customer.accepts_marketing or track_non_subscribed %}
        <script>
          window.dmPtId = function () {
            window.dmPt('identify', '{{ customer.email }}');
          };
        </script>
      {% endif %}
    {% endif -%}
    {% comment %} Dotdigital CartInsight: End {% endcomment %}
    <script>
		window.addEventListener('DOMContentLoaded', () => {

			{% if template.name == "product" and product.selected_or_first_available_variant.available == false %}

			const isLoggedIn = {% if customer %}true{% else %}false{% endif %};

			const notifypopup    = document.querySelector('.notify_nonloggedin');
			const notifyModalBtn = document.querySelector('.notify-modal-btn');
			const notifyBtn      = document.querySelector('.notify_btn.popup');
			const notifyCloseBtn = document.querySelector('.notify-close-btn');
			const timer          = document.querySelector('.timer');

			let interval;

			// Timer function
			function startTimer() {

				if (!timer) return;

				let remaining = 30;

				timer.innerText = `${remaining} Seconds`;

				clearInterval(interval);

				interval = setInterval(function () {

				remaining--;

				timer.innerText = `${remaining} Seconds`;

				if (remaining <= 0) {

					clearInterval(interval);

					// Login check ke liye reload
					window.location.reload();

				}

				}, 1000);

			}

			// Agar pehle click ho chuka hai aur login nahi hai
			const notifyClicked = localStorage.getItem('notify_popup_clicked');

			if (!isLoggedIn && notifyClicked === 'true' && notifypopup) {

				notifypopup.classList.add('active');

				// Load pe bhi timer start karo
				startTimer();

			}

			// Popup open
			if (notifyBtn && notifypopup) {

				notifyBtn.addEventListener('click', function () {

				notifypopup.classList.add('active');

				});

			}

			// Popup close
			if (notifyCloseBtn && notifypopup) {

				notifyCloseBtn.addEventListener('click', function () {

				notifypopup.classList.remove('active');

				});

			}

			// Outside click close
			window.addEventListener('click', function (e) {

				if (
				notifypopup &&
				notifypopup.classList.contains('active') &&
				!notifypopup.contains(e.target) &&
				notifyBtn &&
				!notifyBtn.contains(e.target)
				) {
				notifypopup.classList.remove('active');
				}

			});

			// Login/Register button click
			if (notifyModalBtn) {

				notifyModalBtn.addEventListener('click', function () {

				// Save state
				localStorage.setItem('notify_popup_clicked', 'true');

				// Timer start
				startTimer();

				});

			}

			// Agar login ho gaya toh localStorage clear
			if (isLoggedIn) {

				localStorage.removeItem('notify_popup_clicked');

			}

			{% endif %}

		});
    </script>
  </body>
</html>
